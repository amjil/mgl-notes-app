(ns notes-app.lifecycle
  "Shared app lifecycle: resume Pull / pause Push for both platforms."
  (:require ["package:flutter/material.dart" :as m]
            [notes-app.services.sync :as sync]))

(defonce ^:private !lifecycle-observer (atom nil))

(defn- on-lifecycle-state! [^m/AppLifecycleState state]
  (cond
    (= state m/AppLifecycleState.resumed)
    (sync/on-app-resume!)

    (or (= state m/AppLifecycleState.paused)
        (= state m/AppLifecycleState.hidden)
        (= state m/AppLifecycleState.detached)
        (= state m/AppLifecycleState.inactive))
    (sync/on-app-pause!)

    :else nil))

(defn register!
  "Register a global WidgetsBindingObserver for resume Pull / pause Push."
  []
  (when-not @!lifecycle-observer
    (let [observer (reify ^:mixin m/WidgetsBindingObserver
                     (didChangeAppLifecycleState [_ ^m/AppLifecycleState state]
                       (on-lifecycle-state! state)))]
      (.addObserver (m/WidgetsBinding.instance) observer)
      (reset! !lifecycle-observer observer))))
