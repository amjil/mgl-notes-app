(ns notes-app.desktop
  (:require ["package:flutter/material.dart" :as m]
            [notes-app.desktop.shell :as shell]
            [notes-app.desktop.widgets.keyboard :as keyboard]
            [notes-app.platform :as platform]
            [notes-app.theme :as theme]
            [notes-app.ui :as ui]))

;; Matches the browser zoom level this UI was tuned against (70%).
(def ^:private ui-scale 0.7)

(defn- grow-insets
  "Map view insets into the enlarged logical surface used by web density."
  [insets scale]
  (m/EdgeInsets.fromLTRB
   (/ (.-left insets) scale)
   (/ (.-top insets) scale)
   (/ (.-right insets) scale)
   (/ (.-bottom insets) scale)))

(defn- compact-density?
  "All desktop targets use the tighter density tuned at browser zoom 70%."
  []
  (platform/desktop?))

(defn- with-compact-density
  "Lay the app out larger, then paint it at `ui-scale`.
   Uniform scale for fonts, icons, Material buttons, padding, and spacing."
  [^m/BuildContext ctx child]
  (if-not (and (compact-density?) (some? child))
    child
    (let [mq (m/MediaQuery.of ctx)
          scale ui-scale
          max-w (.-width (.-size mq))
          max-h (.-height (.-size mq))
          w (/ max-w scale)
          h (/ max-h scale)]
      (if-not (and (> max-w 0.0) (> max-h 0.0))
        child
        (m/ClipRect
         .child
         (m/SizedBox
          .width max-w
          .height max-h
          .child
          (m/FittedBox
           .fit m.BoxFit/fill
           .alignment m.Alignment/topLeft
           .clipBehavior m.Clip/hardEdge
           .child
           (m/SizedBox
            .width w
            .height h
            .child
            (m/MediaQuery
             .data (.copyWith mq
                              .size (m/Size w h)
                              .padding (grow-insets (.-padding mq) scale)
                              .viewPadding (grow-insets (.-viewPadding mq) scale)
                              .viewInsets (grow-insets (.-viewInsets mq) scale)
                              .systemGestureInsets (grow-insets (.-systemGestureInsets mq) scale))
             .child child)))))))))

(defn app
  "Desktop MaterialApp. `boot-state` is {:status :ready|:error|:loading :message ?}."
  [boot-state retry!]
  (let [{:keys [status message]} boot-state]
    (m/MaterialApp
     .title "Amjil Notes"
     .debugShowCheckedModeBanner false
     ;; Allow OS desktop to show through during quick-entry mode.
     .color m.Colors/transparent
     .theme theme/app-theme
     ;; IME overlay must sit outside the FittedBox scale transform so caret
     ;; globals match Positioned coordinates (see shared-ime.overlay-view).
     .builder (fn [ctx child]
                (keyboard/wrap (with-compact-density ctx child)))
     .home (case status
             :ready (shell/desktop-shell)
             :error (ui/boot-error-screen message retry!)
             (ui/boot-loading-screen)))))
