(ns notes-app.desktop
  (:require ["package:flutter/material.dart" :as m]
            [notes-app.desktop.shell :as shell]
            [notes-app.platform :as platform]
            [notes-app.theme :as theme]
            [notes-app.ui :as ui]))

;; Matches the browser zoom level this UI was tuned against (70%).
(def ^:private web-ui-scale 0.7)

(defn- grow-insets
  "Map view insets into the enlarged logical surface used by web density."
  [insets scale]
  (m/EdgeInsets.fromLTRB
   (/ (.-left insets) scale)
   (/ (.-top insets) scale)
   (/ (.-right insets) scale)
   (/ (.-bottom insets) scale)))

(defn- with-web-density
  "Lay the web app out larger, then paint it at `web-ui-scale`.
   Same density as browser zoom 70%, including fonts, buttons, and spacing."
  [^m/BuildContext _ctx child]
  (if-not (and (platform/web?) (some? child))
    child
    (m/LayoutBuilder
     .builder
     (fn [_ ^m/BoxConstraints constraints]
       (let [max-w (.-maxWidth constraints)
             max-h (.-maxHeight constraints)]
         (if-not (and (.isFinite max-w) (.isFinite max-h) (> max-w 0.0) (> max-h 0.0))
           child
           (m/Builder
            .builder
            (fn [^m/BuildContext mq-ctx]
              (let [mq (m.MediaQuery/of mq-ctx)
                    scale web-ui-scale
                    w (/ max-w scale)
                    h (/ max-h scale)]
                (m/FittedBox
                 .fit m.BoxFit/fill
                 .alignment m.Alignment/topLeft
                 .clipBehavior m.Clip/hardEdge
                 .child
                 (m/SizedBox
                  .width w
                  .height h
                  .child
                  (m/MediaQuery
                   .data (.copyWith mq
                                    .size (m/Size w h)
                                    .padding (grow-insets (.-padding mq) scale)
                                    .viewPadding (grow-insets (.-viewPadding mq) scale)
                                    .viewInsets (grow-insets (.-viewInsets mq) scale)
                                    .systemGestureInsets (grow-insets (.-systemGestureInsets mq) scale))
                   .child child))))))))))))

(defn app
  "Desktop MaterialApp. `boot-state` is {:status :ready|:error|:loading :message ?}."
  [boot-state retry!]
  (let [{:keys [status message]} boot-state]
    (m/MaterialApp
     .title "Amjil Notes"
     .debugShowCheckedModeBanner false
     ;; Allow OS desktop to show through during quick-entry mode.
     .color m.Colors/transparent
     .theme theme/app-theme
     .builder (fn [ctx child] (with-web-density ctx child))
     .home (case status
             :ready (shell/desktop-shell)
             :error (ui/boot-error-screen message retry!)
             (ui/boot-loading-screen)))))
