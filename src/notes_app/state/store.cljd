(ns notes-app.state.store
  (:require ["package:shared_preferences/shared_preferences.dart" :as sp]))

(def ^:private pref-keys
  {:device-id "device_id"
   :sync-base-url "sync_base_url"
   :last-sync-time "last_sync_time"
   :last-sync-op-id "last_sync_op_id"
   :user-name "user_name"
   :show-daily-only "show_daily_only"
   :sync-enabled "sync_enabled"
   :auth-token "auth_token"
   :auth-email "auth_email"
   :workspace-id "workspace_id"})

(def default-sync-base-url "http://127.0.0.1:4000")

(defonce app-ui-state
  (atom {:selected-nav-id "today"
         :open-document-id nil
         ;; One-shot: editor calls reveal-block! then clears.
         :focus-block-id nil
         :device-id nil
         :sync-base-url default-sync-base-url
         :last-sync-time nil
         :last-sync-op-id ""
         :user-name ""
         :show-daily-only false
         :sync-enabled false
         :sync-status :idle ;; :idle :syncing :ok :error
         :sync-message nil
         :sync-toast-message nil
         :sync-toast-token 0
         :pending-title-conflicts []
         :auth-token nil
         :auth-email nil
         :workspace-id nil}))

(defn- new-uuid []
  (str (random-uuid)))

(defn load-prefs!
  "Load device_id / sync / auth settings from SharedPreferences. Creates device_id once."
  []
  (let [prefs (await (.getInstance sp/SharedPreferences))
        device-id (or (.getString prefs (:device-id pref-keys))
                      (let [id (new-uuid)]
                        (await (.setString prefs (:device-id pref-keys) id))
                        id))
        saved-url (.getString prefs (:sync-base-url pref-keys))
        base-url (if (or (nil? saved-url) (= saved-url ""))
                   default-sync-base-url
                   saved-url)
        last-sync (.getString prefs (:last-sync-time pref-keys))
        last-sync-op-id (or (.getString prefs (:last-sync-op-id pref-keys)) "")
        user-name (or (.getString prefs (:user-name pref-keys)) "")
        show-daily-only? (or (.getBool prefs (:show-daily-only pref-keys)) false)
        auth-token (.getString prefs (:auth-token pref-keys))
        auth-email (.getString prefs (:auth-email pref-keys))
        workspace-id (.getString prefs (:workspace-id pref-keys))
        logged-in? (and auth-token (not= auth-token ""))
        sync-enabled-pref (.getBool prefs (:sync-enabled pref-keys))
        ;; Migrate: logged-in users who synced before this pref existed stay enabled.
        sync-enabled? (if (nil? sync-enabled-pref)
                        logged-in?
                        sync-enabled-pref)]
    ;; Persist default URL on first launch so Settings shows it immediately
    (when (or (nil? saved-url) (= saved-url ""))
      (await (.setString prefs (:sync-base-url pref-keys) default-sync-base-url)))
    (swap! app-ui-state assoc
           :device-id device-id
           :sync-base-url base-url
           :last-sync-time last-sync
           :last-sync-op-id last-sync-op-id
           :user-name user-name
           :show-daily-only show-daily-only?
           :sync-enabled sync-enabled?
           :auth-token auth-token
           :auth-email auth-email
           :workspace-id workspace-id)))

(defn set-nav! [nav-id]
  (swap! app-ui-state assoc :selected-nav-id nav-id))

(defn set-selected-tag! [tag]
  (swap! app-ui-state assoc :selected-tag tag))

(defn clear-selected-tag! []
  (swap! app-ui-state dissoc :selected-tag))

(defn open-document!
  "Open document in the editor. Optional `block-id` → reveal after load.
   Remembers the previous nav so close-editor! can return there."
  ([doc-id]
   (open-document! doc-id nil))
  ([doc-id block-id]
   (swap! app-ui-state
          (fn [s]
            (let [prev (:selected-nav-id s)
                  return (if (= prev "editor")
                           (or (:editor-return-nav s) "documents")
                           prev)]
              (assoc s
                     :open-document-id doc-id
                     :focus-block-id block-id
                     :editor-return-nav return
                     :selected-nav-id "editor"))))))

(defn take-focus-block-id!
  "Return and clear pending focus-block-id (one-shot for the editor)."
  []
  (let [id (:focus-block-id @app-ui-state)]
    (swap! app-ui-state assoc :focus-block-id nil)
    id))

(defn close-editor!
  "Return to previous nav (or documents)."
  ([]
   (close-editor! (or (:editor-return-nav @app-ui-state) "documents")))
  ([nav-id]
   (swap! app-ui-state assoc
          :open-document-id nil
          :focus-block-id nil
          :selected-nav-id nav-id)))

(defn update-sync-base-url! [url]
  (swap! app-ui-state assoc :sync-base-url (or url ""))
  (let [prefs (await (.getInstance sp/SharedPreferences))]
    (await (.setString prefs (:sync-base-url pref-keys) (or url "")))))

(defn update-user-name! [name]
  (swap! app-ui-state assoc :user-name (or name ""))
  (let [prefs (await (.getInstance sp/SharedPreferences))]
    (await (.setString prefs (:user-name pref-keys) (or name "")))))

(defn set-auth-session! [token email display-name workspace-id]
  (swap! app-ui-state assoc
         :auth-token token
         :auth-email email
         :workspace-id workspace-id
         :user-name (or display-name (:user-name @app-ui-state) ""))
  (let [prefs (await (.getInstance sp/SharedPreferences))]
    (await (.setString prefs (:auth-token pref-keys) (or token "")))
    (await (.setString prefs (:auth-email pref-keys) (or email "")))
    (await (.setString prefs (:workspace-id pref-keys) (or workspace-id "")))
    (when (and display-name (not= display-name ""))
      (await (.setString prefs (:user-name pref-keys) display-name)))))

(defn clear-auth-session!
  []
  (swap! app-ui-state assoc
         :auth-token nil
         :auth-email nil
         :workspace-id nil)
  (let [prefs (await (.getInstance sp/SharedPreferences))]
    (await (.remove prefs (:auth-token pref-keys)))
    (await (.remove prefs (:auth-email pref-keys)))
    (await (.remove prefs (:workspace-id pref-keys)))))

(defn logged-in? []
  (let [t (:auth-token @app-ui-state)]
    (and t (not= t ""))))

(defn sync-enabled? []
  (boolean (:sync-enabled @app-ui-state)))

(defn set-sync-enabled! [enabled?]
  (let [v (boolean enabled?)]
    (swap! app-ui-state assoc :sync-enabled v)
    (let [prefs (await (.getInstance sp/SharedPreferences))]
      (await (.setBool prefs (:sync-enabled pref-keys) v)))))

(defn auth-headers
  "HTTP headers including Authorization when logged in."
  ([]
   (auth-headers {"Content-Type" "application/json"}))
  ([base]
   (let [token (:auth-token @app-ui-state)]
     (if (and token (not= token ""))
       (assoc base "Authorization" (str "Bearer " token))
       base))))

(defn set-last-sync-time! [iso-or-ms]
  (let [v (str iso-or-ms)]
    (swap! app-ui-state assoc :last-sync-time v)
    (let [prefs (await (.getInstance sp/SharedPreferences))]
      (await (.setString prefs (:last-sync-time pref-keys) v)))))

(defn set-last-sync-cursor!
  "Persist pull cursor tuple `(received_at, op_id)`."
  [since since-id]
  (let [t (str (or since "0"))
        oid (str (or since-id ""))]
    (swap! app-ui-state assoc
           :last-sync-time t
           :last-sync-op-id oid)
    (let [prefs (await (.getInstance sp/SharedPreferences))]
      (await (.setString prefs (:last-sync-time pref-keys) t))
      (await (.setString prefs (:last-sync-op-id pref-keys) oid)))))

(defn set-sync-status! [status message]
  (when (= status :error)
    (dart:core/print (str "[sync] error: " message)))
  (swap! app-ui-state assoc :sync-status status :sync-message message))

(defn add-title-conflict-notice!
  "Queue a title-conflict rename for a post-sync toast."
  [original-title new-title]
  (when (and original-title new-title (not= original-title new-title))
    (swap! app-ui-state update :pending-title-conflicts
           (fn [xs]
             (conj (or xs [])
                   {:original (str original-title)
                    :new (str new-title)})))))

(defn take-pending-title-conflicts!
  "Return and clear queued title-conflict notices."
  []
  (let [xs (:pending-title-conflicts @app-ui-state)]
    (swap! app-ui-state assoc :pending-title-conflicts [])
    (or xs [])))

(defn emit-sync-toast!
  "Bump toast token so UI can show a one-shot SnackBar message."
  [message]
  (when (and message (not= message ""))
    (swap! app-ui-state
           (fn [s]
             (assoc s
                    :sync-toast-message (str message)
                    :sync-toast-token (inc (or (:sync-toast-token s) 0)))))))

(defn device-id []
  (:device-id @app-ui-state))


(defn set-parent-doc! [id title]
  (swap! app-ui-state assoc :parent-doc-id id :parent-doc-title title))

(defn clear-parent-doc! []
  (swap! app-ui-state dissoc :parent-doc-id :parent-doc-title))

(defn set-show-daily-only! [enabled?]
  (let [v (boolean enabled?)]
    (swap! app-ui-state assoc :show-daily-only v)
    (let [prefs (await (.getInstance sp/SharedPreferences))]
      (await (.setBool prefs (:show-daily-only pref-keys) v)))))

(defn toggle-show-daily-only! []
  (set-show-daily-only! (not (:show-daily-only @app-ui-state))))
