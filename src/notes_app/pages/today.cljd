(ns notes-app.pages.today
  (:require ["package:flutter/material.dart" :as m]
            ["dart:core" :as dc]
            [cljd.flutter :as f]
            [notes-app.services.daily :as daily]
            [notes-app.services.export :as export]
            [notes-app.pages.editor :as editor]
            [notes-app.theme :as t]
            [notes-app.ui :as ui]))

(defn today-page []
  (let [;; Currently viewed date
        !current-date (atom (dc/DateTime.now))
        ;; Document ID for the current date
        !doc-id (atom nil)

        ;; Async date loader
        load-date! (fn [^dc/DateTime dt]
                     (reset! !doc-id nil) ;; clear to show Loading UI
                     (-> (daily/ensure-daily! dt)
                         (.then #(reset! !doc-id %))))]

    (load-date! (dc/DateTime.now))
    (f/widget
     :context ctx

     :watch [current-date !current-date
             doc-id !doc-id]

     (m/Scaffold
      .backgroundColor t/bg
      .appBar
      (ui/page-app-bar
       :title (daily/date->title current-date)
       :actions
       [(ui/action-btn m.Icons/chevron_left "Previous day"
                       (fn []
                         (let [prev-day (.subtract current-date (dc/Duration. .days 1))]
                           (reset! !current-date prev-day)
                           (load-date! prev-day))))
        (ui/action-btn m.Icons/today "Go to today"
                       (fn []
                         (let [today (dc/DateTime.now)]
                           (reset! !current-date today)
                           (load-date! today)))
                       :filled? true)
        (ui/action-btn m.Icons/chevron_right "Next day"
                       (fn []
                         (let [next-day (.add current-date (dc/Duration. .days 1))]
                           (reset! !current-date next-day)
                           (load-date! next-day))))
        (if doc-id
          (ui/action-btn m.Icons/file_download_outlined "Export HTML"
                         (fn []
                           (-> (export/export-document-to-file! doc-id)
                               (.then (fn [path] (export/show-export-result! ctx path)))
                               (.catchError (fn [_] (export/show-export-result! ctx nil))))))
          (m/SizedBox.shrink))
        (m/SizedBox .width 8.0)])

      .body
      (if doc-id
        (m/KeyedSubtree
         .key (m/ValueKey doc-id)
         .child (editor/document-editor doc-id :show-back? false :embedded? true))

        (ui/empty-state m.Icons/wb_sunny_outlined "Loading…"))))))
