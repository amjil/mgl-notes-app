(ns notes-app.pages.mobile.shell
  "Mobile app chrome: bottom NavigationBar.
   V1 prioritizes desktop; this keeps a working mobile layout for later polish."
  (:require ["package:flutter/material.dart" :as m]
            ["dart:core" :as dc]
            [cljd.flutter :as f]
            [notes-app.state.store :as store]
            [notes-app.widgets.bottom-nav :as nav]
            [notes-app.pages.today :as today]
            [notes-app.pages.documents :as documents]
            [notes-app.pages.tasks :as tasks]
            [notes-app.pages.search :as search]
            [notes-app.pages.settings :as settings]
            [notes-app.pages.editor :as editor]))

(defn- body-for [nav-id open-doc-id]
  (case nav-id
    "today" (today/today-page)
    "documents" (documents/documents-page)
    "tasks" (tasks/tasks-page)
    "search" (search/search-page)
    "settings" (settings/settings-page)
    "editor" (if open-doc-id
               (editor/document-editor open-doc-id
                                       :show-back? true
                                       :on-back #(store/close-editor! "documents"))
               (documents/documents-page))
    (today/today-page)))

(defn mobile-shell []
  (f/widget
   :watch [{:keys [selected-nav-id open-document-id]} store/app-ui-state]
   (m/Scaffold
    .backgroundColor (m/Color 0xFF121212)
    .body
    (m/SafeArea
     .child
     (m/AnimatedSwitcher
      .duration (dc/Duration. .milliseconds 200)
      .child
      (m/Container
       .key (m/ValueKey (str selected-nav-id "-" open-document-id))
       .child (body-for selected-nav-id open-document-id))))
    .bottomNavigationBar
    (when (not= selected-nav-id "editor")
      (nav/main-navigation-bar)))))
