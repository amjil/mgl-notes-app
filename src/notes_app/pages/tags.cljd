(ns notes-app.pages.tags
  "Browse notes by #tag — tag index, then references for a selected tag.
   Paged like documents: SQL LIMIT + ListView.builder + scroll load-more."
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]
            ["dart:async" :as async]
            [cljd.flutter :as f]
            [notes-app.services.link :as link]
            [notes-app.state.store :as store]
            [notes-app.widgets.keyboard-wrapper :as kw]
            [rich-editor.components.text-field :as custom-tf]
            [notes-app.theme :as t]
            [notes-app.ui :as ui]))

(defonce ^:private !filter-state
  (atom {:external-keyboard-delegate nil}))

(defn- preview-text [text]
  (let [s (or text "")
        n (min (count s) 80)]
    (if (<= (count s) 80)
      s
      (str (.substring s 0 n) "…"))))

(defn- display-doc-title [title]
  (let [s (or title "")]
    (if (= (.trim ^String s) "")
      "Untitled"
      s)))

(defn- tag-tile [{:keys [tag ref-count doc-count]} on-tap]
  (ui/note-card
   (mgl/MongolListTile
    .leading (ui/icon-chip m.Icons/tag t/tertiary :bg-color t/tertiary-soft)
    .title (mgl/MongolText (str "#" tag)
                           .style (t/mongol-style
                                   :size 18.0
                                   :color t/tertiary
                                   :italic? true))
    .subtitle (mgl/MongolText
               (str doc-count " notes · " ref-count " refs")
               .style (t/mongol-style :size 12.0 :color t/ink-muted))
    .onTap on-tap)
   :accent-color t/tertiary))

(defn- ref-card [{:keys [block-id block-text document-id document-title]}]
  (m/GestureDetector
   .onTap #(when document-id
             (store/open-document! document-id block-id))
   .child
   (ui/note-card
    (m/Padding
     .padding (m.EdgeInsets/all 12.0)
     .child
     (m/Column
      .crossAxisAlignment m.CrossAxisAlignment/start
      .children
      [(mgl/MongolText
        (display-doc-title document-title)
        .style (t/mongol-style :size 14.0 :weight m.FontWeight/bold :color t/primary))
       (m/SizedBox .height 10.0)
       (m/Expanded
        .child
        (mgl/MongolText
         (preview-text block-text)
         .style (t/mongol-style :size 13.0 :color t/ink-muted)))]))
    :width 120.0)))

(defn- make-load-more-scroll [!limit]
  (let [ctrl (m/ScrollController.)]
    (.addListener ctrl
                  (fn []
                    (let [pos (.-position ctrl)]
                      (when (>= (.-pixels pos) (- (.-maxScrollExtent pos) 200))
                        (swap! !limit + 50)))))
    ctrl))

(defn tags-page []
  (let [!limit (atom 50)
        !query (atom "")
        !timer (atom nil)
        schedule-filter!
        (fn [v]
          (when @!timer (.cancel ^async/Timer @!timer))
          (reset! !timer
                  (async/Timer. (dart:core/Duration. .milliseconds 200)
                                (fn []
                                  (reset! !query (or v ""))
                                  (reset! !limit 50)))))]
    (f/widget
     :managed [filter-ctrl (m/TextEditingController.)
               filter-focus (m/FocusNode)
               tags-scroll (make-load-more-scroll !limit)
               refs-scroll (make-load-more-scroll !limit)]
     :bg-watcher ([^m/TextEditingValue {v .-text} filter-ctrl]
                  (schedule-filter! (or v "")))
     :watch [{:keys [selected-tag]} store/app-ui-state
             limit-val !limit
             query !query
             filter-state !filter-state
             tags (stream
                   (map (fn [rows] (or rows [])))
                   (map (fn [[_ _]] []))
                   :as-values (link/watch-paged-tags query limit-val))
             refs (stream
                   (map (fn [rows] (or rows [])))
                   (map (fn [[_ _]] []))
                   :as-values (link/watch-tag-references
                               (or selected-tag "") limit-val))]
     (let [tags-vec (vec (or tags []))
           refs-vec (vec (or refs []))]
       (m/Scaffold
        .backgroundColor t/bg
        .resizeToAvoidBottomInset false
        .appBar
        (when selected-tag
          (ui/page-app-bar
           :actions
           [(ui/action-btn m.Icons/open_in_new "Open tag page"
                           #(link/open-or-create-by-title! selected-tag)
                           :color t/tertiary
                           :filled? true)
            (m/SizedBox .width 8.0)]))
        .body
        (m/SafeArea
         .child
         (if selected-tag
           (m/Row
            .crossAxisAlignment m.CrossAxisAlignment/stretch
            .children
            [(ui/title-rail (str "#" selected-tag)
                            :on-back (fn []
                                       (reset! !limit 50)
                                       (store/clear-selected-tag!))
                            :on-title-tap #(link/open-or-create-by-title! selected-tag)
                            :accent-color t/tertiary)
             (m/Expanded
              .child
              (if (empty? refs-vec)
                (ui/empty-state m.Icons/tag "No notes with this tag")
                (m/ListView.builder
                 .controller refs-scroll
                 .scrollDirection m.Axis/horizontal
                 .physics (m/BouncingScrollPhysics)
                 .padding (m.EdgeInsets/fromLTRB 20.0 20.0 8.0 20.0)
                 .itemCount (count refs-vec)
                 .itemBuilder
                 (fn [_ idx]
                   (let [row (nth refs-vec idx)]
                     (m/KeyedSubtree
                      .key (m/ValueKey (:block-id row))
                      .child (ref-card row)))))))])

           (kw/with-virtual-keyboard
             (m/Row
              .crossAxisAlignment m.CrossAxisAlignment/stretch
              .children
              [(ui/title-rail "ᠲᠡᠮᠳᠡᠭ" :accent-color t/tertiary)
               (ui/field-shell
                (custom-tf/text-field
                 !filter-state
                 {:controller filter-ctrl
                  :on-changed (fn [v] (schedule-filter! (or v "")))
                  :focus-node filter-focus
                  :hint "Filter…"
                  :max-lines 1
                  :style (t/mongol-style)
                  :decoration (m/InputDecoration .border m/InputBorder.none
                                                 .hintStyle (t/mongol-style :color t/ink-faint))}))
               (m/Expanded
                .child
                (if (empty? tags-vec)
                  (ui/empty-state
                   m.Icons/tag
                   (if (empty? query) "No tags yet" "No matching tags"))
                  (m/ListView.builder
                   .controller tags-scroll
                   .scrollDirection m.Axis/horizontal
                   .physics (m/BouncingScrollPhysics)
                   .padding (m.EdgeInsets/fromLTRB 12.0 20.0 8.0 20.0)
                   .itemCount (count tags-vec)
                   .itemBuilder
                   (fn [_ idx]
                     (let [row (nth tags-vec idx)]
                       (m/KeyedSubtree
                        .key (m/ValueKey (:tag row))
                        .child
                        (tag-tile row
                                  (fn []
                                    (reset! !limit 50)
                                    (store/set-selected-tag! (:tag row))))))))))])))))))))
