(ns notes-app.pages.tags
  "Browse notes by #tag — tag index, then references for a selected tag.
   Paged like documents: SQL LIMIT + ListView.builder + scroll load-more."
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]
            ["dart:async" :as async]
            [cljd.flutter :as f]
            [notes-app.services.link :as link]
            [notes-app.state.store :as store]
            [notes-app.widgets.keyboard-wrapper :as kw]
            [rich-editor.components.text-field :as custom-tf]))

(def ^:private tag-accent (m/Color 0xFFBA68C8))

(defonce ^:private !filter-state
  (atom {:external-keyboard-delegate nil}))

(defn- preview-text [text]
  (let [t (or text "")
        n (min (count t) 80)]
    (if (<= (count t) 80)
      t
      (str (.substring t 0 n) "…"))))

(defn- display-doc-title [title]
  (let [t (or title "")]
    (if (= (.trim ^String t) "")
      "Untitled"
      t)))

(defn- tag-tile [{:keys [tag ref-count doc-count]} on-tap]
  (m/Container
   .width 100.0
   .margin (m.EdgeInsets/only .right 16.0)
   .decoration (m/BoxDecoration
                .color (m/Color 0xFF1E1E1E)
                .borderRadius (m.BorderRadius/circular 12.0)
                .border (m/Border.all .color (m/Color 0x33BA68C8) .width 1.0))
   .child
   (mgl/MongolListTile
    .leading (m/Icon m.Icons/tag .color tag-accent)
    .title (mgl/MongolText (str "#" tag)
                           .style (m/TextStyle .fontFamily "OyunQaganTig"
                                               .fontSize 18.0
                                               .color tag-accent
                                               .fontStyle m.FontStyle/italic))
    .subtitle (mgl/MongolText
               (str doc-count " notes · " ref-count " refs")
               .style (m/TextStyle .fontFamily "OyunQaganTig"
                                   .color m.Colors/white54
                                   .fontSize 12.0))
    .onTap on-tap)))

(defn- ref-card [{:keys [block-id block-text document-id document-title]}]
  (m/Container
   .width 120.0
   .margin (m.EdgeInsets/only .right 16.0)
   .padding (m.EdgeInsets/all 12.0)
   .decoration (m/BoxDecoration
                .color (m/Color 0xFF1E1E1E)
                .borderRadius (m.BorderRadius/circular 12.0)
                .border (m/Border.all .color m.Colors/white12 .width 1.0))
   .child
   (m/GestureDetector
    .onTap #(when document-id
              (store/open-document! document-id block-id))
    .child
    (m/Column
     .crossAxisAlignment m.CrossAxisAlignment/start
     .children
     [(mgl/MongolText
       (display-doc-title document-title)
       .style (m/TextStyle .fontFamily "OyunQaganTig"
                           .fontSize 14.0
                           .fontWeight m.FontWeight/bold
                           .color (m/Color 0xFF64B5F6)))
      (m/SizedBox .height 10.0)
      (m/Expanded
       .child
       (mgl/MongolText
        (preview-text block-text)
        .style (m/TextStyle .fontFamily "OyunQaganTig"
                            .fontSize 13.0
                            .color (m/Color 0xFFBDBDBD))))]))))

(defn- make-load-more-scroll [!limit]
  (let [ctrl (m/ScrollController.)]
    (.addListener ctrl
                  (fn []
                    (let [pos (.-position ctrl)]
                      (when (>= (.-pixels pos) (- (.-maxScrollExtent pos) 200))
                        (swap! !limit + 50)))))
    ctrl))

(defn tags-page []
  (let [!limit (atom 50)
        !query (atom "")
        !timer (atom nil)
        schedule-filter!
        (fn [v]
          (when @!timer (.cancel ^async/Timer @!timer))
          (reset! !timer
                  (async/Timer. (dart:core/Duration. .milliseconds 200)
                                (fn []
                                  (reset! !query (or v ""))
                                  (reset! !limit 50)))))]
    (f/widget
     :managed [filter-ctrl (m/TextEditingController.)
               filter-focus (m/FocusNode)
               tags-scroll (make-load-more-scroll !limit)
               refs-scroll (make-load-more-scroll !limit)]
     :bg-watcher ([^m/TextEditingValue {v .-text} filter-ctrl]
                  (schedule-filter! (or v "")))
     :watch [{:keys [selected-tag]} store/app-ui-state
             limit-val !limit
             query !query
             filter-state !filter-state
             tags (stream
                   (map (fn [rows] (or rows [])))
                   (map (fn [[_ _]] []))
                   :as-values (link/watch-paged-tags query limit-val))
             refs (stream
                   (map (fn [rows] (or rows [])))
                   (map (fn [[_ _]] []))
                   :as-values (link/watch-tag-references
                               (or selected-tag "") limit-val))]
     (let [tags-vec (vec (or tags []))
           refs-vec (vec (or refs []))]
       (m/Scaffold
        .backgroundColor (m/Color 0xFF121212)
        .resizeToAvoidBottomInset false
        .appBar
        (m/AppBar
         .backgroundColor (m/Color 0xFF1E1E1E)
         .elevation 0.0
         .actions
         (if selected-tag
           [(m/IconButton
             .tooltip "Open tag page"
             .icon (m/Icon m.Icons/open_in_new .color tag-accent)
             .onPressed #(link/open-or-create-by-title! selected-tag))]
           []))
        .body
        (m/SafeArea
         .child
         (if selected-tag
           (m/Row
            .crossAxisAlignment m.CrossAxisAlignment/stretch
            .children
            [(m/Container
              .width 100.0
              .decoration (m/BoxDecoration
                           .color (m/Color 0xFF1A1A1A)
                           .border (m/Border .right (m/BorderSide .color m.Colors/white12 .width 1.0)))
              .child
              (m/Column
               .children
               [(m/Padding
                 .padding (m.EdgeInsets/only .top 16.0 .bottom 16.0)
                 .child
                 (m/IconButton
                  .icon (m/Icon m.Icons/arrow_back .color m.Colors/white54)
                  .onPressed (fn []
                               (reset! !limit 50)
                               (store/clear-selected-tag!))))
                (m/Expanded
                 .child
                 (m/InkWell
                  .onTap #(link/open-or-create-by-title! selected-tag)
                  .child
                  (m/Align
                   .alignment m.Alignment/topCenter
                   .child
                   (mgl/MongolText
                    (str "#" selected-tag)
                    .style (m/TextStyle .fontFamily "OyunQaganTig"
                                        .fontSize 22.0
                                        .fontWeight m.FontWeight/bold
                                        .fontStyle m.FontStyle/italic
                                        .color tag-accent)))))]))
             (m/Expanded
              .child
              (if (empty? refs-vec)
                (m/Center
                 .child (mgl/MongolText "No notes with this tag"
                                        .style (m/TextStyle .fontFamily "OyunQaganTig"
                                                            .color m.Colors/white54)))
                (m/ListView.builder
                 .controller refs-scroll
                 .scrollDirection m.Axis/horizontal
                 .padding (m.EdgeInsets/all 16.0)
                 .itemCount (count refs-vec)
                 .itemBuilder
                 (fn [_ idx]
                   (let [row (nth refs-vec idx)]
                     (m/KeyedSubtree
                      .key (m/ValueKey (:block-id row))
                      .child (ref-card row)))))))])

           (kw/with-virtual-keyboard
             (m/Row
              .crossAxisAlignment m.CrossAxisAlignment/stretch
              .children
              [(m/Container
                .width 56.0
                .padding (m.EdgeInsets/symmetric .vertical 16.0)
                .child
                (m/Align
                 .alignment m.Alignment/topCenter
                 .child (mgl/MongolText "ᠲᠡᠮᠳᠡᠭ"
                                        .style (m/TextStyle .fontFamily "OyunQaganTig"
                                                            .color m.Colors/white
                                                            .fontSize 20.0))))
               (m/Padding
                .padding (m.EdgeInsets/symmetric .horizontal 8.0 .vertical 16.0)
                .child
                (custom-tf/text-field
                 !filter-state
                 {:controller filter-ctrl
                  :on-changed (fn [v] (schedule-filter! (or v "")))
                  :focus-node filter-focus
                  :hint "Filter…"
                  :max-lines 1
                  :style (m/TextStyle .color m.Colors/white .fontFamily "OyunQaganTig")
                  :decoration (m/InputDecoration .border m/InputBorder.none)}))
               (m/Expanded
                .child
                (if (empty? tags-vec)
                  (m/Center
                   .child (mgl/MongolText
                           (if (empty? query) "No tags yet" "No matching tags")
                           .style (m/TextStyle .fontFamily "OyunQaganTig"
                                               .color m.Colors/white54)))
                  (m/ListView.builder
                   .controller tags-scroll
                   .scrollDirection m.Axis/horizontal
                   .padding (m.EdgeInsets/all 16.0)
                   .itemCount (count tags-vec)
                   .itemBuilder
                   (fn [_ idx]
                     (let [row (nth tags-vec idx)]
                       (m/KeyedSubtree
                        .key (m/ValueKey (:tag row))
                        .child
                        (tag-tile row
                                  (fn []
                                    (reset! !limit 50)
                                    (store/set-selected-tag! (:tag row))))))))))])))))))))
