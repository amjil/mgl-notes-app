(ns notes-app.shared.trash
  "Shared trash list + left title rail."
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]
            [cljd.flutter :as f]
            [components.dialog :as dialog]
            [notes-app.db.core :as db]
            [notes-app.platform :as platform]
            [notes-app.services.document :as doc]
            [notes-app.services.sync :as sync]
            [notes-app.theme :as t]
            [notes-app.ui :as ui]))

(defn- confirm-hard-delete! [ctx id]
  (-> (m/showDialog
       .context ctx
       .builder
       (fn [c]
         (dialog/vertical-custom-dialog
          {:title "Delete forever?"
           :height-factor 0.45
           :width-factor (if (platform/mobile?) 0.85 0.4)
           :body
           (mgl/MongolText "This cannot be undone."
                           .style (t/mongol-style :size 16.0 :color t/ink-muted))
           :actions
           [(mgl/MongolTextButton
             .onPressed #(.pop (m.Navigator/of c) false)
             .child (mgl/MongolText "Cancel"))
            (mgl/MongolElevatedButton
             .onPressed #(.pop (m.Navigator/of c) true)
             .child (mgl/MongolText "Delete"))]})))
      (.then (fn [ok?]
               (when ok?
                 (-> (doc/hard-delete! id)
                     (.then (fn [_] (sync/schedule-push!)))))))))

(defn- trash-tile [ctx d desktop?]
  (let [id (:id d)
        title (if (empty? (:title d)) "Untitled" (:title d))]
    (m/KeyedSubtree
     .key (m/ValueKey id)
     .child
     (m/Center
      .child
      (ui/note-card
       (m/Stack
        .children
        [;; Base: clean two-column layout (icon + title)
         (m/Positioned.fill
          .child
          (m/Center
           .child
           (mgl/MongolListTile
            .leading (ui/icon-chip m.Icons/delete_outline t/danger :bg-color t/danger-soft)
            .title (mgl/MongolText title
                                   .style (t/mongol-style :size 16.0 :color t/ink-muted))
            .subtitle (mgl/MongolText "Deleted"
                                      .style (t/mongol-style :size 12.0 :color t/danger)))))

         ;; Floating actions: restore + delete forever at top-right
         (m/Positioned
          .top 6.0
          .right 6.0
          .child
          (m/Column
           .mainAxisSize m.MainAxisSize/min
           .children
           [(m/IconButton
             .icon (m/Icon m.Icons/restore .color t/success .size 18.0)
             .padding m.EdgeInsets/zero
             .constraints (m/BoxConstraints .minWidth 28.0 .minHeight 28.0)
             .style (m/IconButton.styleFrom
                     .backgroundColor (t/fade t/success 0.08)
                     .shape (m/RoundedRectangleBorder
                             .borderRadius (m.BorderRadius/circular 8.0)))
             .tooltip "Restore"
             .onPressed (fn []
                          (-> (doc/restore! id)
                              (.then (fn [_] (sync/schedule-push!))))))
            (m/SizedBox .height 6.0)
            (m/IconButton
             .icon (m/Icon m.Icons/delete_forever .color t/danger .size 18.0)
             .padding m.EdgeInsets/zero
             .constraints (m/BoxConstraints .minWidth 28.0 .minHeight 28.0)
             .style (m/IconButton.styleFrom
                     .backgroundColor (t/fade t/danger 0.08)
                     .shape (m/RoundedRectangleBorder
                             .borderRadius (m.BorderRadius/circular 8.0)))
             .tooltip "Delete Forever"
             .onPressed #(confirm-hard-delete! ctx id))]))])
       :accent-color t/danger
       :width (if desktop? :auto 120.0)
       :margin (if desktop? (m.EdgeInsets/zero) (m.EdgeInsets/only .right 16.0)))))))

(defn trash-body []
  (f/widget
   :context ctx
   :watch [deleted-docs (stream
                         (map (fn [rows] (or rows [])))
                         :as-values (db/watch-deleted-documents))]
   (m/Row
    .crossAxisAlignment m.CrossAxisAlignment/stretch
    .children
    [(ui/title-rail "Хогийн сав")
     (m/Expanded
      .child
      (if (empty? deleted-docs)
        (ui/empty-state m.Icons/delete_outline "Trash is empty")
        (if (platform/desktop?)
          (m/GridView.builder
           .scrollDirection m.Axis/horizontal
           .physics (m/BouncingScrollPhysics.)
           .padding (m.EdgeInsets/all 24.0)
           .gridDelegate (m/SliverGridDelegateWithMaxCrossAxisExtent
                          .maxCrossAxisExtent 280.0
                          .mainAxisExtent 160.0
                          .mainAxisSpacing 24.0
                          .crossAxisSpacing 24.0)
           .itemCount (count deleted-docs)
           .itemBuilder
           (fn [_ idx]
             (let [d (nth deleted-docs idx)]
               (trash-tile ctx d true))))
          (m/ListView.builder
           .scrollDirection m.Axis/horizontal
           .physics (m/BouncingScrollPhysics.)
           .padding (m.EdgeInsets/fromLTRB 20.0 20.0 8.0 20.0)
           .itemCount (count deleted-docs)
           .itemBuilder
           (fn [_ idx]
             (let [d (nth deleted-docs idx)]
               (trash-tile ctx d false)))))))])))
