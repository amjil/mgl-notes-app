(ns notes-app.shared.rename-dialog
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]
            [cljd.flutter :as f]
            [components.dialog :as dialog]
            [notes-app.keyboard :as kw]
            [notes-app.platform :as platform]
            [rich-editor.components.text-field :as custom-tf]
            [notes-app.theme :as t]
            [notes-app.ui :as ui]))

(defn rename-dialog
  "Show a Mongolian rename dialog. Calls `on-ok` with the new title when confirmed."
  [ctx current-title on-ok]
  (m/showDialog
   .context ctx
   .builder
   (fn [c]
     (f/widget
      :managed [!ime-state (atom {:external-keyboard-delegate nil})
                controller (m/TextEditingController .text (or current-title ""))
                focus-node (m/FocusNode)]
      (kw/wrap
       (dialog/vertical-custom-dialog
        {:title "Rename"
         :height-factor 0.55
         :width-factor (if (platform/mobile?) 1.0 0.45)
         :inset-padding (if (platform/mobile?) (m.EdgeInsets/zero)
                            (m.EdgeInsets/symmetric .horizontal 16.0))
           :body
         ;; Row keeps the field at intrinsic width on the start (left);
         ;; a lone child inside Expanded would stretch wide and center the text.
         (m/Row
          .crossAxisAlignment m.CrossAxisAlignment/stretch
          .children
          [(ui/field-shell
            (custom-tf/text-field
             !ime-state
             {:controller controller
              :focus-node focus-node
              :autofocus true
              :max-lines 1
              :style (t/mongol-style :size 18.0)
              :decoration (m/InputDecoration
                           .border m/InputBorder.none
                           .hintStyle (t/mongol-style :color t/ink-faint))}))])
         :actions
         [(mgl/MongolTextButton
           .onPressed #(.pop (m/Navigator.of c))
           .child (mgl/MongolText "Cancel"))
          (mgl/MongolElevatedButton
           .onPressed
           (fn []
             (on-ok (.-text controller))
             (.pop (m/Navigator.of c)))
           .child (mgl/MongolText "OK"))]}))))))
