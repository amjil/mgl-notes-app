(ns notes-app.shared.rename-dialog
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]
            [cljd.flutter :as f]
            [components.dialog :as dialog]
            [notes-app.keyboard :as kw]
            [notes-app.platform :as platform]))

(defn rename-dialog
  "Show a Mongolian rename dialog. Calls `on-ok` with the new title when confirmed."
  [ctx current-title on-ok]
  (m/showDialog
   .context ctx
   .builder
   (fn [c]
     (f/widget
      :managed [controller (m/TextEditingController .text (or current-title ""))]
      (kw/wrap
       (dialog/vertical-custom-dialog
        {:title "Rename"
         :height-factor 0.55
         :width-factor (if (platform/mobile?) 1.0 0.45)
         :inset-padding (if (platform/mobile?) (m.EdgeInsets/zero)
                            (m.EdgeInsets/symmetric .horizontal 16.0))
         :body
         (mgl/MongolTextField
          .controller controller
          .autofocus true
          .style (m/TextStyle .fontFamily "OyunQaganTig" .fontSize 18.0))
         :actions
         [(mgl/MongolTextButton
           .onPressed #(.pop (m/Navigator.of c))
           .child (mgl/MongolText "Cancel"))
          (mgl/MongolElevatedButton
           .onPressed
           (fn []
             (on-ok (.-text controller))
             (.pop (m/Navigator.of c)))
           .child (mgl/MongolText "OK"))]}))))))
