(ns notes-app.shared.today
  "Shared daily-note session + editor pane + Heatmap. Date chrome stays on each platform."
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]
            ["dart:core" :as dc]
            [clojure.string :as str]
            [cljd.flutter :as f]
            [notes-app.db.core :as db]
            [notes-app.services.daily :as daily]
            [notes-app.editor.view :as editor]
            [notes-app.state.store :as store]
            [notes-app.theme :as t]
            [notes-app.ui :as ui]))

(defn make-session
  "Atoms + loader for the current daily note. Starts loading today."
  []
  (let [today (dc/DateTime.now)
        !current-date (atom today)
        !doc-id (atom nil)
        load-date!
        (fn [^dc/DateTime dt]
          (let [want (daily/date->title dt)]
            (reset! !doc-id nil)
            (-> (daily/ensure-daily! dt)
                (.then (fn [id]
                         (when (= want (daily/date->title @!current-date))
                           (reset! !doc-id id)))))))]
    (load-date! today)
    {:!current-date !current-date
     :!doc-id !doc-id
     :load-date! load-date!}))

(defn- build-heatmap-data [stats]
  (let [now (dc/DateTime.now)
        days (mapv (fn [i]
                     (let [dt (.subtract now (dc/Duration. .days i))
                           d-str (daily/date->title dt)
                           count (get stats d-str 0)]
                       {:date dt :title d-str :count count}))
                   (reverse (range 364)))]
    (partition-all 7 days)))

(defn- heatmap-cell [{:keys [date title count]} on-tap]
  (let [color (cond
                (zero? count) t/surface-2
                (< count 5)   (t/fade t/secondary 0.3)
                (< count 15)  (t/fade t/secondary 0.6)
                :else         t/secondary)]
    (m/Tooltip
     .message (str title " : " count " blocks")
     .child
     (m/InkWell
      .onTap #(on-tap date)
      .borderRadius (m.BorderRadius/circular 4.0)
      .child
      (m/Container
       .width 14.0
       .height 14.0
       .margin (m.EdgeInsets/all 2.0)
       .decoration (m/BoxDecoration
                    .color color
                    .borderRadius (m.BorderRadius/circular 4.0)))))))

(defn heatmap-panel [!current-date load-date!]
  (f/widget
   :watch [stats (stream (map (fn [x] (or x {}))) :as-values (db/watch-daily-stats))]
   (let [weeks (build-heatmap-data (or stats {}))
         reversed-weeks (reverse weeks)]
     (m/Container
      .height 160.0
      .padding (m.EdgeInsets/symmetric .horizontal 24.0 .vertical 16.0)
      .decoration (m/BoxDecoration
                   .color t/surface
                   .border (m/Border .bottom (m/BorderSide .color t/outline .width 1.0)))
      .child
      (m/Row
       .children
       [(m/Column
         .crossAxisAlignment m.CrossAxisAlignment/center
         .mainAxisAlignment m.MainAxisAlignment/center
         .children
         [(ui/icon-chip m.Icons/local_fire_department t/secondary :size 24.0)
          (m/SizedBox .height 12.0)
          (m/Expanded
           .child (mgl/MongolText "Өдрийн тэмдэглэл"
                                  .style (t/mongol-style :size 16.0 :weight m.FontWeight/bold)))])
        (m/VerticalDivider .color t/outline .width 32.0)
        (m/Expanded
         .child
         (m/ListView.builder
          .scrollDirection m.Axis/horizontal
          .reverse true
          .physics (m/BouncingScrollPhysics.)
          .itemCount (count reversed-weeks)
          .itemBuilder
          (fn [_ idx]
            (let [week (nth reversed-weeks idx)]
              (m/Column
               .mainAxisSize m.MainAxisSize/min
               .children
               (mapv (fn [day]
                       (m/KeyedSubtree
                        .key (m/ValueKey (:title day))
                        .child (heatmap-cell day
                                             (fn [dt]
                                               (reset! !current-date dt)
                                               (load-date! dt)))))
                     week))))))])))))

(defn review-deck-btn
  "App-bar toggle between daily diary and immersive flashcard review."
  [!view-mode]
  (f/widget
   :watch [due-cards (stream (map #(or % [])) :as-values (db/watch-due-flashcards))
           mode !view-mode]
   (let [n (count due-cards)
         due? (pos? n)
         flashcards? (= mode :flashcards)
         can-tap? (or flashcards? due?)]
     (m/Tooltip
      .message (cond
                 flashcards? "Back to diary"
                 due?        (str n " due")
                 :else       "No flashcards due")
      .child
      (m/InkWell
       .onTap (when can-tap?
                #(swap! !view-mode (fn [m] (if (= m :daily) :flashcards :daily))))
       .borderRadius (m.BorderRadius/circular 8.0)
       .child
       (m/Badge
        .isLabelVisible (and due? (not flashcards?))
        .label (m/Text (str n)
                       .style (m/TextStyle .fontSize 10.0 .color m.Colors/white
                                           .fontWeight m.FontWeight/bold))
        .backgroundColor t/warning
        .child
        (m/Padding
         .padding (m.EdgeInsets/all 8.0)
         .child
         (m/Icon (if flashcards? m.Icons/edit_note m.Icons/psychology)
                 .color (cond
                          flashcards? t/primary
                          due?        t/warning
                          :else       t/ink-faint)))))))))

(defn editor-pane
  [doc-id & {:keys [show-backlinks? !read-only?] :or {show-backlinks? true}}]
  (if doc-id
    (m/KeyedSubtree
     .key (m/ValueKey doc-id)
     .child (editor/document-editor doc-id
                                    :show-back? false
                                    :embedded? true
                                    :show-backlinks? show-backlinks?
                                    :!read-only? !read-only?))
    (ui/empty-state m.Icons/wb_sunny_outlined "Loading...")))

(defn- select-card! [!selected-card {:keys [id document-id]}]
  (swap! store/app-ui-state assoc :focus-block-id id)
  (reset! !selected-card {:doc-id document-id :block-id id}))

(defn- review-card-tile [card selected? on-tap]
  (let [{:keys [text document-title]} card
        q (if (str/blank? text) "..." text)
        title (if (str/blank? document-title) "Untitled" document-title)]
    ;; Fixed height: vertical ListView gives h=Infinity, which MongolListTile rejects
    (m/Padding
     .padding (m.EdgeInsets/only .bottom 12.0)
     .child
     (m/SizedBox
      .height 160.0
      .child
      (ui/note-card
       (m/Center
        .child
        (mgl/MongolListTile
         .leading (ui/icon-chip m.Icons/psychology t/warning)
         .title (mgl/MongolText q
                                .maxLines (int 3)
                                .style (t/mongol-style :size 16.0
                                                       :weight (if selected? m.FontWeight/bold m.FontWeight/w600)))
         .subtitle (mgl/MongolText title
                                   .style (t/mongol-style :size 12.0 :color t/ink-muted))
         .onTap on-tap))
       :accent-color (when selected? t/warning)
       :width 160.0
       :margin (m.EdgeInsets/zero))))))

;; Left due-card list + right source-note editor (scrolls via focus-block-id)
(defn review-split-pane [due-cards !selected-card]
  (if (empty? due-cards)
    (ui/empty-state m.Icons/done_all "Бүх картыг давтсан байна")
    (f/widget
     :watch [sel !selected-card]
     (m/Row
      .crossAxisAlignment m.CrossAxisAlignment/stretch
      .children
      [;; Left sidebar — same note-card chrome as the documents list
       (m/Container
        .width 192.0
        .decoration (m/BoxDecoration
                     .color t/surface-2
                     .border (m/Border .right (m/BorderSide .color t/outline .width 1.0)))
        .child
        (m/ListView.builder
         .physics (m/BouncingScrollPhysics.)
         .padding (m.EdgeInsets/symmetric .horizontal 16.0 .vertical 16.0)
         .itemCount (count due-cards)
         .itemBuilder
         (fn [_ idx]
           (let [{:keys [id] :as card} (nth due-cards idx)
                 selected? (= (:block-id sel) id)]
             (m/KeyedSubtree
              .key (m/ValueKey id)
              .child (review-card-tile card selected?
                                       #(select-card! !selected-card card)))))))

       ;; Right: empty until the user picks a card
       (m/Expanded
        .child
        (if-let [doc-id (:doc-id sel)]
          (m/KeyedSubtree
           .key (m/ValueKey (str doc-id ":" (:block-id sel)))
           .child (editor-pane doc-id :show-backlinks? false))
          (ui/empty-state m.Icons/touch_app "Зүүн талаас карт сонгоно уу")))]))))
