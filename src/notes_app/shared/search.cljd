(ns notes-app.shared.search
  "Shared search field + results. Title chrome stays on each platform."
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]
            ["dart:async" :as async]
            [cljd.flutter :as f]
            [notes-app.db.core :as db]
            [notes-app.keyboard :as kw]
            [notes-app.state.store :as store]
            [rich-editor.components.text-field :as custom-tf]
            [notes-app.theme :as t]
            [notes-app.ui :as ui]))

(defonce !search-state
  (atom {:external-keyboard-delegate nil}))

(defn search-body []
  (let [!query (atom "")
        !results (atom [])
        !timer (atom nil)
        run-search!
        (fn [q]
          (if (or (nil? q) (= q ""))
            (reset! !results [])
            (-> (db/search-documents-and-blocks q)
                (.then (fn [rows]
                         (when (= q @!query)
                           (reset! !results (or rows [])))))
                (.catchError (fn [_]
                               (when (= q @!query)
                                 (reset! !results [])))))))
        schedule-search!
        (fn [v]
          (reset! !query v)
          (when @!timer (.cancel ^async/Timer @!timer))
          (reset! !timer
                  (async/Timer. (dart:core/Duration. .milliseconds 300)
                                #(run-search! v))))]
    (f/widget
     :managed [search-ctrl (m/TextEditingController.)
               search-focus-node (m/FocusNode)]
     :bg-watcher ([^m/TextEditingValue {v .-text} search-ctrl]
                  (schedule-search! (or v "")))
     :watch [query !query
             results !results
             search-state !search-state]
     (kw/wrap
      (m/Row
       .children
       [(ui/field-shell
         (custom-tf/text-field
          !search-state
          {:controller search-ctrl
           :on-changed (fn [v] (schedule-search! (or v "")))
           :focus-node search-focus-node
           :hint "Search…"
           :max-lines 1
           :style (t/mongol-style)
           :decoration (m/InputDecoration .border m/InputBorder.none
                                          .hintStyle (t/mongol-style :color t/ink-faint))}))
        (m/Expanded
         .child
         (if (empty? results)
           (ui/empty-state
            m.Icons/search
            (if (empty? query) "Type to search" "No results"))
           (m/ListView
            .scrollDirection m.Axis/horizontal
            .physics (m/BouncingScrollPhysics)
            .padding (m.EdgeInsets/fromLTRB 12.0 20.0 8.0 20.0)
            .children
            (mapv
             (fn [r]
               (m/KeyedSubtree
                .key (m/ValueKey (str (:document-id r) "-" (:block-id r) "-" (:hit r)))
                .child
                (m/Center
                 .child
                 (ui/note-card
                  (m/Center
                   .child
                   (mgl/MongolListTile
                    .leading (ui/icon-chip m.Icons/description_outlined t/primary)
                    .title (mgl/MongolText
                            (or (:document-title r) "")
                            .style (t/mongol-style :size 16.0 :weight m.FontWeight/w600))
                    .subtitle (when (:block-text r)
                                (mgl/MongolText
                                 (or (:block-text r) "")
                                 .style (t/mongol-style :size 13.0 :color t/ink-muted)))
                    .onTap (fn []
                             (store/open-document! (:document-id r) (:block-id r))
                             nil)))
                  :width 120.0))))
             results))))])))))
