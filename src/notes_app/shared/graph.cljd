(ns notes-app.shared.graph
  "Force-directed knowledge graph - Isolate Physics + Filters & Orphan Discovery."
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]
            ["dart:async" :as async]
            ["dart:isolate" :as iso]
            ["dart:math" :as math]
            [cljd.flutter :as f]
            [notes-app.services.link :as link]
            [notes-app.theme :as t]
            [notes-app.ui :as ui]))

(def ^:private canvas-size 4000.0)
(def ^:private center (/ canvas-size 2.0))
(def ^:private physics-ticks 300)
(def ^:private hit-radius 36.0)
(def ^:private label-hit-w 22.0)
(def ^:private label-hit-h 140.0)

;; -----------------------------------------------------------------------------
;; Physics Engine (Pure functional design for Isolate)
;; -----------------------------------------------------------------------------
(defn- init-nodes 
  "初始化节点坐标。保留已有节点的 x/y/vx/vy 以防止过滤时发生剧烈闪烁。"
  [raw-nodes current-nodes]
  (let [n (count raw-nodes)]
    (if (zero? n)
      {}
      (let [radius (* (math/sqrt n) 60.0)
            step (/ (* 2.0 math/pi) n)
            ids (keys raw-nodes)]
        (into {}
              (map-indexed
               (fn [idx id]
                 (let [data (get raw-nodes id)
                       cur (get current-nodes id)]
                   (if cur
                     ;; 保留已有位置和动能
                     [id (assoc data :x (:x cur) :y (:y cur) :vx (:vx cur) :vy (:vy cur))]
                     ;; 新节点环形初始化
                     (let [angle (* idx step)
                           x (+ center (* radius (math/cos angle)))
                           y (+ center (* radius (math/sin angle)))]
                       [id (assoc data :x x :y y :vx 0.0 :vy 0.0)]))))
               ids))))))

(defn- add-force [disp id fx fy]
  (let [cur (get disp id)]
    (assoc! disp id {:dx (+ (:dx cur) fx)
                     :dy (+ (:dy cur) fy)})))

(defn- step-physics
  "Velocity-based physics frame. Smooth, organic, zero jitter."
  [nodes edges current-tick]
  (let [k 150.0
        k2 (* k k)
        cutoff2 (* 800.0 800.0)
        progress (/ (double current-tick) (double physics-ticks))
        alpha (* 0.1 (- 1.0 progress))
        friction 0.7
        ids (vec (keys nodes))
        n (count ids)]
    (if (or (zero? n) (< alpha 0.001))
      nodes
      (let [forces (transient (zipmap ids (repeat {:dx 0.0 :dy 0.0})))
            forces
            (loop [i 0 d forces]
              (if (>= i n)
                d
                (let [v (nth ids i)
                      nv (get nodes v)
                      d (loop [j 0 d d]
                          (if (>= j n)
                            d
                            (if (= i j)
                              (recur (inc j) d)
                              (let [u (nth ids j)
                                    nu (get nodes u)
                                    px (- (:x nv) (:x nu))
                                    py (- (:y nv) (:y nu))
                                    px (if (and (zero? px) (zero? py)) 0.1 px)
                                    dist2 (+ (* px px) (* py py))]
                                (if (>= dist2 cutoff2)
                                  (recur (inc j) d)
                                  (let [dist (math/sqrt dist2)
                                        safe-dist (max 10.0 dist)
                                        force (/ k2 safe-dist)]
                                    (recur (inc j)
                                           (add-force d v
                                                      (* force (/ px dist))
                                                      (* force (/ py dist))))))))))]
                  (recur (inc i) d))))
            forces
            (reduce
             (fn [d {:keys [source target]}]
               (if (and (contains? nodes source) (contains? nodes target))
                 (let [nv (get nodes source)
                       nu (get nodes target)
                       px (- (:x nv) (:x nu))
                       py (- (:y nv) (:y nu))
                       px (if (and (zero? px) (zero? py)) 0.1 px)
                       dist (max 10.0 (math/sqrt (+ (* px px) (* py py))))
                       force (/ (* dist dist) k)
                       fx (* force (/ px dist))
                       fy (* force (/ py dist))]
                   (-> d
                       (add-force source (- fx) (- fy))
                       (add-force target fx fy)))
                 d))
             forces
             edges)
            forces (persistent! forces)]
        (reduce-kv
         (fn [acc id n]
           (if (:fixed? n)
             (assoc acc id (assoc n :vx 0.0 :vy 0.0))
             (let [f (get forces id)
                   vx (* (+ (:vx n) (* (:dx f) alpha)) friction)
                   vy (* (+ (:vy n) (* (:dy f) alpha)) friction)
                   nx (max 100.0 (min (+ (:x n) vx) (- canvas-size 100.0)))
                   ny (max 100.0 (min (+ (:y n) vy) (- canvas-size 100.0)))]
               (assoc acc id (assoc n :x nx :y ny :vx vx :vy vy)))))
         nodes nodes)))))

(defn physics-isolate-entry [^iso/SendPort main-port]
  (let [iso-port (iso/ReceivePort.)
        !state (atom {:nodes {} :edges [] :running? false :ticks 0 :timer nil})]
    (.send main-port {:type :init :port (.-sendPort iso-port)})
    (.listen iso-port
             (fn [msg]
               (let [m-type (:type msg)]
                 (case m-type
                   :start
                   (do
                     ;; 🌟 收到 start 指令时，将 ticks 重置为 0，图谱会重新受力舒展
                     (swap! !state assoc
                            :nodes (:nodes msg)
                            :edges (:edges msg)
                            :running? true
                            :ticks 0)
                     (when-let [t (:timer @!state)] (.cancel ^async/Timer t))
                     (swap! !state assoc :timer
                            (async/Timer.periodic
                             (dart:core/Duration. .milliseconds 16)
                             (fn [t]
                               (let [{:keys [running? nodes edges ticks]} @!state]
                                 (if (and running? (< ticks physics-ticks))
                                   (let [next-nodes (step-physics nodes edges ticks)]
                                     (swap! !state assoc :nodes next-nodes :ticks (inc ticks))
                                     (.send main-port {:type :update :nodes next-nodes})
                                     nil)
                                   (do
                                     (.cancel t)
                                     (swap! !state assoc :running? false :timer nil)
                                     nil))))))
                     nil)
                   :drag
                   (do
                     (swap! !state update-in [:nodes (:id msg)]
                            assoc :x (:x msg) :y (:y msg) :fixed? (:fixed? msg))
                     nil)
                   :stop
                   (do
                     (swap! !state assoc :running? false)
                     (when-let [t (:timer @!state)] (.cancel ^async/Timer t))
                     nil)
                   nil))))
    nil))

;; -----------------------------------------------------------------------------
;; Helpers & Filters
;; -----------------------------------------------------------------------------
(defn- view-scale [^m/TransformationController ctrl]
  (try
    (.getMaxScaleOnAxis ^m/Matrix4 (.-value ctrl))
    (catch Exception _ 1.0)))

(defn- hit-node? [x y n r]
  (let [dx (- x (:x n))
        dy (- y (:y n))
        dist (math/sqrt (+ (* dx dx) (* dy dy)))]
    (or (< dist r)
        (and (< (if (neg? dx) (- dx) dx) label-hit-w)
             (< 8.0 dy (+ 16.0 label-hit-h))))))

(defn- find-node [x y nodes r]
  (let [hits (reduce-kv
              (fn [acc id n]
                (if (hit-node? x y n r)
                  (let [dx (- x (:x n))
                        dy (- y (:y n))
                        dist (math/sqrt (+ (* dx dx) (* dy dy)))]
                    (conj acc [id dist]))
                  acc))
              []
              nodes)]    (when (seq hits)
      (first (first (sort-by second hits))))))

(defn- apply-filters-and-restart! 
  "根据开关过滤数据，标出孤岛，并让后台引擎重新开始受力计算"
  [!nodes !edges !raw-data !show-tags? !highlight-orphans? !iso-send]
  (let [raw @!raw-data
        show-tags? @!show-tags?
        highlight? @!highlight-orphans?
        all-nodes (:nodes raw {})
        all-edges (:edges raw [])
        
        ;; 1. 过滤标签相关的边
        active-edges (if show-tags?
                       all-edges
                       (filterv #(not= (:type %) "tag") all-edges))
        
        ;; 2. 过滤标签节点
        active-nodes (if show-tags?
                       all-nodes
                       (reduce-kv (fn [acc k v]
                                    (if (= (:type v) "tag") acc (assoc acc k v)))
                                  {} all-nodes))
        
        ;; 3. 获取所有有关联的节点 ID，剩下的自然就是“孤岛”
        connected (into #{} (mapcat (juxt :source :target) active-edges))
        
        ;; 4. 标记孤岛节点
        active-nodes (reduce-kv (fn [acc id n]
                                  (let [orphan? (not (contains? connected id))]
                                    (assoc acc id (assoc n 
                                                         :orphan? orphan?
                                                         :highlight-orphan? (and highlight? orphan?)))))
                                {} active-nodes)
        
        ;; 5. 继承当前正在运动的坐标，防止画布剧烈重置
        next-nodes (init-nodes active-nodes @!nodes)]
    
    (reset! !nodes next-nodes)
    (reset! !edges active-edges)
    (when-let [p @!iso-send]
      (.send ^iso/SendPort p {:type :start :nodes next-nodes :edges active-edges}))))

;; -----------------------------------------------------------------------------
;; Canvas Painter
;; -----------------------------------------------------------------------------
(defn- paint-label [^m/Canvas canvas cx cy label color]
  (let [text-span (m/TextSpan
                   .text label
                   .style (t/mongol-style :size 13.0
                                          :weight m.FontWeight/w600
                                          :color color))
        painter (mgl/MongolTextPainter
                 .text text-span
                 .ellipsis "..."
                 .maxLines (int 1))]
    (try
      (.layout painter .maxHeight 140.0)
      (let [tw (.-width painter)
            th (.-height painter)
            tx (- cx (/ tw 2.0))
            ty (+ cy 16.0)
            bg-rect (m.RRect/fromRectAndRadius
                     (m.Rect/fromLTWH (- tx 6.0) (- ty 4.0) (+ tw 12.0) (+ th 8.0))
                     (m.Radius/circular 6.0))
            bg-paint (doto (m/Paint.)
                       (-> .-color (set! t/surface))
                       (-> .-style (set! m.PaintingStyle/fill)))
            border-paint (doto (m/Paint.)
                           (-> .-color (set! (t/fade color 0.3)))
                           (-> .-style (set! m.PaintingStyle/stroke))
                           (-> .-strokeWidth (set! 1.0)))]
        (.drawRRect canvas bg-rect bg-paint)
        (.drawRRect canvas bg-rect border-paint)
        (.paint painter canvas (m/Offset. tx ty)))
      (finally
        (.dispose painter)))))

(defn- graph-painter [nodes edges]
  (reify :extends m/CustomPainter
    (paint [_ canvas ^m/Size _size]
      (let [edge-paint (doto (m/Paint.)
                         (-> .-color (set! (t/fade t/outline-strong 0.8)))
                         (-> .-strokeWidth (set! 1.5))
                         (-> .-isAntiAlias (set! true)))
            fill (doto (m/Paint.)
                   (-> .-style (set! m.PaintingStyle/fill))
                   (-> .-isAntiAlias (set! true)))
            halo (doto (m/Paint.)
                   (-> .-style (set! m.PaintingStyle/fill))
                   (-> .-isAntiAlias (set! true)))]
        (doseq [{:keys [source target]} edges]
          (when (and (contains? nodes source) (contains? nodes target))
            (let [ns (get nodes source)
                  nt (get nodes target)]
              (.drawLine canvas
                         (m/Offset. (:x ns) (:y ns))
                         (m/Offset. (:x nt) (:y nt))
                         edge-paint))))
        (doseq [[id n] nodes]
          (let [tag? (= (:type n) "tag")
                highlight? (:highlight-orphan? n) ;; 🌟 判断是否需要高亮孤岛
                color (cond
                        highlight? t/warning
                        tag? t/tertiary
                        :else t/primary)
                cx (:x n)
                cy (:y n)
                label (if tag? (str "#" id) (str id))]
            ;; 🌟 孤岛高亮时，光晕和核心圆点都会变大
            (set! (.-color halo) (t/fade color (if highlight? 0.3 0.15)))
            (set! (.-color fill) color)
            (.drawCircle canvas (m/Offset. cx cy) (if highlight? 24.0 18.0) halo)
            (.drawCircle canvas (m/Offset. cx cy) (if highlight? 9.0 7.0) fill)
            (paint-label canvas cx cy label color))))
      nil)
    (shouldRepaint [_ _] true)))

;; -----------------------------------------------------------------------------
;; Session & Main Widget
;; -----------------------------------------------------------------------------
(defn- start-graph! [!nodes !edges !raw-data !show-tags? !highlight-orphans? !iso-send !alive? !loaded?]
  (reset! !alive? true)
  (-> (link/get-graph-data)
      (.then (fn [data]
               (when @!alive?
                 (reset! !raw-data data)
                 (reset! !loaded? true)
                 (letfn [(try-start []
                           (if @!iso-send
                             (apply-filters-and-restart! !nodes !edges !raw-data !show-tags? !highlight-orphans? !iso-send)
                             (when @!alive?
                               (async/Timer. (dart:core/Duration. .milliseconds 50) try-start)
                               nil)))]
                   (try-start)))))
      (.catchError (fn [_]
                     (when @!alive?
                       (reset! !loaded? true))
                     nil)))
  :started)

(defn- make-session []
  (let [!nodes (atom {})
        !edges (atom [])
        !raw-data (atom {:nodes {} :edges []})
        !show-tags? (atom true)
        !highlight-orphans? (atom false)
        !dragged-node (atom nil)
        !drag-moved? (atom false)
        !pan-enabled? (atom true)
        !alive? (atom true)
        !loaded? (atom false)
        !iso (atom nil)
        !iso-send (atom nil)
        main-port (iso/ReceivePort.)
        viewer-ctrl (let [mx (m/Matrix4.identity)]
                      (.translate mx -1600.0 -1600.0)
                      (m/TransformationController. mx))]
    (.listen main-port
             (fn [msg]
               (case (:type msg)
                 :init (reset! !iso-send (:port msg))
                 :update (reset! !nodes (:nodes msg))
                 nil)))
    (-> (iso/Isolate.spawn physics-isolate-entry (.-sendPort main-port))
        (.then (fn [isolate]
                 (reset! !iso isolate))))
    (start-graph! !nodes !edges !raw-data !show-tags? !highlight-orphans? !iso-send !alive? !loaded?)
    {:!nodes !nodes
     :!edges !edges
     :!raw-data !raw-data
     :!show-tags? !show-tags?
     :!highlight-orphans? !highlight-orphans?
     :!dragged-node !dragged-node
     :!drag-moved? !drag-moved?
     :!pan-enabled? !pan-enabled?
     :!alive? !alive?
     :!loaded? !loaded?
     :!iso !iso
     :!iso-send !iso-send
     :main-port main-port
     :viewer-ctrl viewer-ctrl}))

(defn- dispose-session! [{:keys [!alive? !iso main-port viewer-ctrl]}]
  (reset! !alive? false)
  (.close ^iso/ReceivePort main-port)
  (when-let [i @!iso]
    (.kill ^iso/Isolate i .priority iso/Isolate.immediate))
  (.dispose ^m/TransformationController viewer-ctrl))

(defn- filter-toggle [label active? active-color on-tap]
  (m/InkWell
   .onTap on-tap
   .borderRadius (m.BorderRadius/circular 12.0)
   .child
   (m/AnimatedContainer
    .duration (dart:core/Duration. .milliseconds 200)
    .padding (m.EdgeInsets/symmetric .horizontal 12.0 .vertical 8.0)
    .decoration (m/BoxDecoration
                 .color (if active? (t/fade active-color 0.12) m.Colors/transparent)
                 .borderRadius (m.BorderRadius/circular 12.0)
                 .border (m/Border.all .color (if active? active-color t/outline) .width 1.0))
    .child
    (m/Row
     .mainAxisSize m.MainAxisSize/min
     .children
     [(m/Icon (if active? m.Icons/check_circle m.Icons/circle_outlined)
              .size 16.0
              .color (if active? active-color t/ink-muted))
      (m/SizedBox .width 8.0)
      (mgl/MongolText label
                      .style (t/mongol-style :size 14.0
                                             :color (if active? active-color t/ink-muted)
                                             :weight (if active? m.FontWeight/w600 m.FontWeight/normal)))]))))

(defn graph-body []
  (f/widget
   :managed [{:keys [!nodes !edges !raw-data !show-tags? !highlight-orphans? 
                     !dragged-node !drag-moved? !pan-enabled?
                     !loaded? !iso-send viewer-ctrl] :as session} (make-session)
             :dispose dispose-session!]
   :watch [nodes !nodes
           edges !edges
           pan-enabled? !pan-enabled?
           loaded? !loaded?
           show-tags? !show-tags?
           highlight-orphans? !highlight-orphans?]
   (m/SafeArea
    .child
    (cond
      (not loaded?)
      (ui/loading)
      
      ;; 区分：数据库里本来就没连线，还是被过滤面板全隐藏了
      (and (empty? nodes) (empty? (:nodes @!raw-data)))
      (ui/empty-state m.Icons/hub_outlined "No graph connections yet")
      
      :else
      (m/Stack
       .children
       [(m/InteractiveViewer
         .transformationController viewer-ctrl
         .panEnabled pan-enabled?
         .scaleEnabled pan-enabled?
         .constrained false
         .minScale 0.1
         .maxScale 3.0
         .boundaryMargin (m.EdgeInsets/all 4000.0)
         .child
         (m/Listener
          .behavior m.HitTestBehavior/translucent
          .onPointerDown
          (fn [^m/PointerDownEvent e]
            (let [pos (.-localPosition e)
                  scale (max 0.1 (view-scale viewer-ctrl))
                  id (find-node (.-dx pos) (.-dy pos) @!nodes (/ hit-radius scale))]
              (reset! !drag-moved? false)
              (if id
                (do (reset! !pan-enabled? false)
                    (reset! !dragged-node id)
                    (let [n (get @!nodes id)
                          new-n (assoc n :fixed? true)]
                      (swap! !nodes assoc id new-n)
                      (when-let [p @!iso-send]
                        (.send ^iso/SendPort p {:type :drag :id id :x (:x new-n) :y (:y new-n) :fixed? true}))))
                (reset! !pan-enabled? true))
              nil))
          .onPointerMove
          (fn [^m/PointerMoveEvent e]
            (when-let [id @!dragged-node]
              (let [delta (.-localDelta e)
                    dx (.-dx delta)
                    dy (.-dy delta)]
                (when (or (> (if (neg? dx) (- dx) dx) 1.5)
                          (> (if (neg? dy) (- dy) dy) 1.5))
                  (reset! !drag-moved? true))
                (let [n (get @!nodes id)
                      nx (+ (:x n) dx)
                      ny (+ (:y n) dy)]
                  (swap! !nodes assoc id (assoc n :x nx :y ny))
                  (when-let [p @!iso-send]
                    (.send ^iso/SendPort p {:type :drag :id id :x nx :y ny :fixed? true})))))
            nil)
          .onPointerUp
          (fn [^m/PointerUpEvent _]
            (let [id @!dragged-node
                  moved? @!drag-moved?]
              (when id
                (let [n (get @!nodes id)]
                  (swap! !nodes assoc id (assoc n :fixed? false))
                  (when-let [p @!iso-send]
                    (.send ^iso/SendPort p {:type :drag :id id :x (:x n) :y (:y n) :fixed? false})))
                (reset! !dragged-node nil)
                (when-not moved?
                  (link/open-or-create-by-title! id)))
              (reset! !pan-enabled? true)
              (reset! !drag-moved? false))
            nil)
          .onPointerCancel
          (fn [^m/PointerCancelEvent _]
            (when-let [id @!dragged-node]
              (let [n (get @!nodes id)]
                (swap! !nodes assoc id (assoc n :fixed? false))
                (when-let [p @!iso-send]
                  (.send ^iso/SendPort p {:type :drag :id id :x (:x n) :y (:y n) :fixed? false})))
              (reset! !dragged-node nil))
            (reset! !pan-enabled? true)
            (reset! !drag-moved? false)
            nil)
          .child
          (m/Container
           .width canvas-size
           .height canvas-size
           .color m.Colors/transparent
           .child
           (m/CustomPaint
            .size (m/Size. canvas-size canvas-size)
            .painter (graph-painter nodes edges)))))
        
        ;; 🌟 悬浮过滤控制台 (右上角)
        (m/Positioned
         .top 24.0
         .right 24.0
         .child
         (m/Container
          .padding (m.EdgeInsets/all 8.0)
          .decoration (m/BoxDecoration
                       .color (t/fade t/surface 0.95)
                       .borderRadius (m.BorderRadius/circular 16.0)
                       .boxShadow (t/card-shadow))
          .child
          (m/Row
           .mainAxisSize m.MainAxisSize/min
           .children
           [(filter-toggle "Шошго" show-tags? t/tertiary
                           #(do (swap! !show-tags? not)
                                (apply-filters-and-restart! !nodes !edges !raw-data !show-tags? !highlight-orphans? !iso-send)))
            (m/SizedBox .width 8.0)
            (filter-toggle "Ганц" highlight-orphans? t/warning
                           #(do (swap! !highlight-orphans? not)
                                (apply-filters-and-restart! !nodes !edges !raw-data !show-tags? !highlight-orphans? !iso-send)))])))])))))
