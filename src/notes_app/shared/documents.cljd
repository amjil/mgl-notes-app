(ns notes-app.shared.documents
  "Shared documents list + nested-folder drill-down. Chrome (AppBar / FAB) stays on each platform."
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]
            [cljd.flutter :as f]
            [components.menu :as menu]
            [notes-app.db.core :as db]
            [notes-app.services.document :as doc]
            [notes-app.services.export :as export]
            [notes-app.state.store :as store]
            [notes-app.shared.move-dialog :as move]
            [notes-app.shared.rename-dialog :as rename]
            [notes-app.theme :as t]
            [notes-app.ui :as ui]))

(defn- doc-tile [ctx row]
  (let [d (:document row)
        id (:id d)
        title (or (:title d) "")
        display (if (empty? title) "Untitled" title)
        is-daily? (= (:type d) "daily")
        has-parent? (some? (:parentId d))
        has-children? (pos? (:childrenNum row))
        accent (if is-daily? t/secondary t/primary)
        icon (cond
               is-daily? m.Icons/calendar_today
               has-children? m.Icons/folder_outlined
               :else m.Icons/description_outlined)]

    (m/Center
     .child
     (ui/note-card
      (m/Center
       .child
       (mgl/MongolListTile
        .leading (ui/icon-chip icon accent)
        .title (mgl/MongolText display
                               .style (t/mongol-style
                                       :size 18.0
                                       :weight (if is-daily? m.FontWeight/bold m.FontWeight/normal)))
        .subtitle (when has-parent?
                    (mgl/MongolText "nested"
                                    .style (t/mongol-style :size 12.0 :color t/ink-faint)))
        .onTap (fn []
                 (if has-children?
                   (store/set-parent-doc! id display)
                   (store/open-document! id)))
        .trailing
        (menu/custom-popup-menu
         {:trigger-builder
          (fn [show-menu]
            (m/IconButton
             .icon (m/Icon m.Icons/more_horiz .color t/ink-faint)
             .onPressed show-menu))
          :bg-color t/surface
          :border-radius 16.0
          :menu-width 380.0
          :items [{:type :item
                   :title "Edit"
                   :leading m.Icons/edit_note
                   :leading-color t/success
                   :on-tap #(store/open-document! id)}
                  {:type :item
                   :title "Delete"
                   :leading m.Icons/delete
                   :leading-color t/danger
                   :on-tap #(doc/soft-delete! id)}
                  {:type :divider}
                  {:type :item
                   :title "New Sub-doc"
                   :leading m.Icons/post_add
                   :leading-color t/primary
                   :on-tap (fn []
                             (store/set-parent-doc! id display)
                             (-> (doc/create! {:title "" :type "normal" :parent-id id})
                                 (.then (fn [new-id]
                                          (when new-id (store/open-document! new-id))))
                                 (.catchError (fn [_] nil))))}
                  {:type :item
                   :title "Rename"
                   :leading m.Icons/edit
                   :leading-color t/ink-muted
                   :on-tap #(rename/rename-dialog ctx title
                                                  (fn [tit] (doc/rename! id tit)))}
                  {:type :item
                   :title "Move"
                   :leading m.Icons/drive_file_move_outlined
                   :leading-color t/secondary
                   :on-tap #(move/move-dialog ctx id (:parentId d) nil)}
                  {:type :item
                   :title "Export HTML"
                   :leading m.Icons/file_download_outlined
                   :leading-color t/primary
                   :on-tap (fn []
                             (-> (export/export-document-to-file! id)
                                 (.then (fn [path]
                                          (export/show-export-result! ctx path)))
                                 (.catchError (fn [_]
                                                (export/show-export-result! ctx nil)))))}]})))
      :accent-color (when is-daily? t/secondary)
      :width 120.0))))

(defn- make-load-more-scroll [!limit !docs]
  (let [ctrl (m/ScrollController.)]
    (.addListener ctrl
                  (fn []
                    (when (.-hasClients ctrl)
                      (let [pos (.-position ctrl)
                            lim @!limit]
                        (when (and (>= (count @!docs) lim)
                                   (pos? (.-maxScrollExtent pos))
                                   (>= (.-pixels pos) (- (.-maxScrollExtent pos) 200)))
                          (swap! !limit + 50))))))
    ctrl))

(defn documents-body []
  (f/widget
   :context ctx
   :watch [{:keys [parent-doc-id parent-doc-title show-daily-only]} store/app-ui-state]
   :managed [!limit (atom 50) :refresh-on [parent-doc-id show-daily-only] :dispose nil
             !docs (atom []) :refresh-on [parent-doc-id show-daily-only] :dispose nil
             scroll-ctrl (make-load-more-scroll !limit !docs)
             :refresh-on [parent-doc-id show-daily-only]]
   :watch [limit-val !limit]
   :bg-watcher ([rows (stream
                       (map (fn [r] (or r [])))
                       :as-values (db/watch-paged-documents parent-doc-id (boolean show-daily-only) limit-val))]
                (reset! !docs (or rows [])))
   :watch [docs !docs]
     (let [show-daily-only? (boolean show-daily-only)
           display-docs-vec (vec (or docs []))
           list-view
           (if (empty? display-docs-vec)
             (ui/empty-state
              (if show-daily-only? m.Icons/calendar_today_outlined m.Icons/folder_open)
              (if show-daily-only? "No calendar notes" "Empty"))
             (m/ListView.builder
              .controller scroll-ctrl
              .scrollDirection m.Axis/horizontal
              .physics (m/BouncingScrollPhysics)
              .padding (m.EdgeInsets/fromLTRB 20.0 20.0 8.0 20.0)
              .itemCount (count display-docs-vec)
              .itemBuilder
              (fn [_ idx]
                (let [row (nth display-docs-vec idx)]
                  (m/KeyedSubtree
                   .key (m/ValueKey (:id (:document row)))
                   .child (doc-tile ctx row))))))]
       (m/Row
        .crossAxisAlignment m.CrossAxisAlignment/stretch
        .children
        [(if parent-doc-id
           (ui/title-rail parent-doc-title
                          :on-back #(store/clear-parent-doc!)
                          :on-title-tap #(store/open-document! parent-doc-id))
           (ui/title-rail "ᠪᠠᠷᠢᠮᠲᠠ"))
         (m/Expanded .child list-view)]))))
