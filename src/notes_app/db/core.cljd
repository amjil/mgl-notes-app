(ns notes-app.db.core
  (:require ["dart:core" :as dc]
            ["package:mgl_notes_app/database.dart" :as drift]
            ["package:drift/drift.dart" :as d]
            ["dart:async" :as async]
            ["dart:convert" :as convert]))

(defonce db (atom nil))

(defn initialize-database! []
  (-> (drift/initDriftDatabase)
      (.then (fn [instance]
               (reset! db instance)
               (dart:core/print "mgl-notes Drift ready")
               instance))
      (.catchError (fn [e]
                     (dart:core/print (str "mgl-notes Drift init failed: " e))
                     (throw e)))))

(defn get-database []
  @db)

(defn- stream-handle-error [s]
  s)

(defn now ^dc/DateTime []
  (.toUtc (dc/DateTime.now)))

(defn new-id []
  (str (random-uuid)))

(defn- json-key [k]
  (cond
    (keyword? k) (name k)
    (string? k) k
    :else (str k)))

(defn- clj->encodable
  "Deep-convert CLJD maps/seqs into Dart Map/List so jsonEncode never sees
   PersistentHashMap (which fails when nested inside a List)."
  [x]
  (cond
    (nil? x) nil
    (keyword? x) (name x)
    (symbol? x) (str x)
    ;; Dart-native containers may still hold CLJD values — walk them.
    (dart/is? x dart:core/Map)
    (dc/Map.fromEntries
     (dc/List.from
      (into []
            (for [[k v] x]
              (dc/MapEntry. (json-key k) (clj->encodable v))))))
    (dart/is? x dart:core/List)
    (dc/List.from (into [] (map clj->encodable x)))
    (map? x)
    (dc/Map.fromEntries
     (dc/List.from
      (into []
            (for [[k v] x]
              (dc/MapEntry. (json-key k) (clj->encodable v))))))
    (set? x)
    (dc/List.from (into [] (map clj->encodable x)))
    (sequential? x)
    (dc/List.from (into [] (map clj->encodable x)))
    :else x))

(defn encode-json [x]
  (convert/jsonEncode (clj->encodable x)))

(defn- json->clj [x]
  (cond
    (dart/is? x dart:core/Map)
    (reduce (fn [acc ^String k]
              (assoc acc (keyword k) (json->clj (get x k))))
            {}
            (.-keys x))
    (dart/is? x dart:core/List)
    (mapv json->clj x)
    :else x))

(defn decode-json [s]
  (when (and s (not= s ""))
    (json->clj (convert/jsonDecode s))))

;; ---------------------------------------------------------------------------
;; Watches
;; ---------------------------------------------------------------------------

(defn watch-documents []
  (if-let [^drift/AppDatabase database @db]
    (stream-handle-error (.watchAllActiveDocuments database))
    (async/Stream.empty)))

(defn watch-paged-documents
  "Watch documents with SQLite-level filtering (parent, type), children count, and LIMIT for infinite scrolling."
  [parent-id show-daily-only? limit-count]
  (if-let [^drift/AppDatabase database @db]
    (let [parent-sql (if parent-id "d.parent_id = ?" "d.parent_id IS NULL")
          type-sql (if show-daily-only? "d.type = 'daily'" "d.type != 'daily'")
          sql (str "SELECT d.id, d.title, d.type, d.parent_id AS parentId, "
                   "(SELECT COUNT(*) FROM documents c WHERE c.parent_id = d.id AND c.deleted_at IS NULL) AS childrenNum "
                   "FROM documents d "
                   "WHERE d.deleted_at IS NULL "
                   "AND " parent-sql " "
                   "AND " type-sql " "
                   "ORDER BY d.updated_at DESC "
                   "LIMIT ?")
          vars (cond-> []
                 parent-id (conj (d/Variable. parent-id))
                 :always (conj (d/Variable. limit-count)))]
      (stream-handle-error
       (.map (.watch (.customSelect database sql
                                    .variables vars
                                    .readsFrom #{(.-documents database)}))
             (fn [rows]
               (mapv (fn [row]
                       (let [data (.-data row)]
                         ;; Map to a clean Clojure structure to decouple from Dart classes
                         {:document {:id (get data "id")
                                     :title (get data "title")
                                     :type (get data "type")
                                     :parentId (get data "parentId")}
                          :childrenNum (get data "childrenNum" 0)}))
                     rows)))))
    (async/Stream.empty)))

(defn watch-deleted-documents
  "Watch soft-deleted documents for the Trash view."
  []
  (if-let [^drift/AppDatabase database @db]
    (stream-handle-error
     (.map (.watch (.customSelect database
                                  "SELECT id, title, type, deleted_at FROM documents WHERE deleted_at IS NOT NULL ORDER BY deleted_at DESC"
                                  .variables []
                                  .readsFrom #{(.-documents database)}))
           (fn [rows]
             (mapv (fn [row]
                     (let [data (.-data row)]
                       {:id (get data "id")
                        :title (get data "title")
                        :type (get data "type")
                        :deleted-at (get data "deleted_at")}))
                   rows))))
    (async/Stream.empty)))

(defn watch-blocks [doc-id]
  (if-let [^drift/AppDatabase database @db]
    (stream-handle-error (.watchBlocksForDocument database doc-id))
    (async/Stream.empty)))

(defn watch-block
  "Stream a single block by its ID. Yields nil if soft-deleted or missing."
  [block-id]
  (if-let [^drift/AppDatabase database @db]
    (stream-handle-error
     (.map (.watch (doto (.select database (.-blocks database))
                     (.where (fn [t]
                               (d/Expression.and
                                [(.equals (.-id t) block-id)
                                 (.isNull (.-deletedAt t))])))
                     (.limit 1)))
           (fn [rows] (first rows))))
    (async/Stream.empty)))

(defn watch-uncompleted-tasks []
  (if-let [^drift/AppDatabase database @db]
    (stream-handle-error (.watchUncompletedTasks database))
    (async/Stream.empty)))

(defn get-document [doc-id]
  (if-let [^drift/AppDatabase database @db]
    (let [q (doto (.select database (.-documents database))
              (.where (fn [t] (.equals (.-id t) doc-id)))
              (.limit 1))]
      (-> (.get q)
          (.then (fn [rows] (first rows)))))
    (async/Future.value nil)))

(defn list-active-documents
  "All non-deleted documents as {:id :title :parent-id :type}, title-asc."
  []
  (if-let [^drift/AppDatabase database @db]
    (let [q (doto (.select database (.-documents database))
              (.where (fn [t] (.isNull (.-deletedAt t))))
              (.orderBy [(fn [t] (d/OrderingTerm.asc (.-title t)))]))]
      (-> (.get q)
          (.then (fn [rows]
                   (mapv (fn [r]
                           {:id (.-id r)
                            :title (or (.-title r) "")
                            :parent-id (.-parentId r)
                            :type (.-type r)})
                         rows)))))
    (async/Future.value [])))

(defn get-blocks [doc-id]
  (if-let [^drift/AppDatabase database @db]
    (let [q (doto (.select database (.-blocks database))
              (.where (fn [t]
                        ;; Use static Expression.and — instance & is an extension and
                        ;; does not apply when ClojureDart types as dynamic.
                        (d/Expression.and
                         [(.equals (.-documentId t) doc-id)
                          (.isNull (.-deletedAt t))])))
              (.orderBy [(fn [t] (d/OrderingTerm.asc (.-orderIndex t)))]))]
      (.get q))
    (async/Future.value nil)))

(defn find-daily-by-title [title]
  (if-let [^drift/AppDatabase database @db]
    (let [q (doto (.select database (.-documents database))
              (.where (fn [t]
                        (d/Expression.and
                         [(.equals (.-type t) "daily")
                          (.equals (.-title t) title)
                          (.isNull (.-deletedAt t))])))
              (.limit 1))]
      (-> (.get q)
          (.then (fn [rows] (first rows)))))
    (async/Future.value nil)))

(defn search-documents-and-blocks [query]
  (if-let [^drift/AppDatabase database @db]
    (let [like (str "%" query "%")]
      (-> (.get
           (.customSelect
            database
            (str "SELECT d.id as document_id, d.title as document_title, "
                 "b.id as block_id, b.text as block_text, 'block' as hit "
                 "FROM blocks b "
                 "INNER JOIN documents d ON d.id = b.document_id "
                 "WHERE b.deleted_at IS NULL AND d.deleted_at IS NULL "
                 "AND b.text LIKE ? "
                 "UNION ALL "
                 "SELECT d.id, d.title, NULL, NULL, 'title' "
                 "FROM documents d "
                 "WHERE d.deleted_at IS NULL AND d.title LIKE ? "
                 "LIMIT 100")
            .variables [(d/Variable. like) (d/Variable. like)]
            .readsFrom #{(.-documents database) (.-blocks database)}))
          (.then (fn [rows]
                   (mapv (fn [row]
                           (let [data (.-data row)]
                             {:document-id (get data "document_id")
                              :document-title (get data "document_title")
                              :block-id (get data "block_id")
                              :block-text (get data "block_text")
                              :hit (get data "hit")}))
                         rows)))))
    (async/Future.value [])))

;; ---------------------------------------------------------------------------
;; Documents by title / title cache (for [[wikilink]] resolve + autocomplete)
;; ---------------------------------------------------------------------------

(defonce !document-titles (atom []))

(defn cached-document-titles []
  @!document-titles)

(defn refresh-document-titles!
  "Reload active document titles into the sync autocomplete cache."
  []
  (if-let [^drift/AppDatabase database @db]
    (let [q (doto (.select database (.-documents database))
              (.where (fn [t] (.isNull (.-deletedAt t))))
              (.orderBy [(fn [t] (d/OrderingTerm.asc (.-title t)))]))]
      (-> (.get q)
          (.then (fn [rows]
                   (reset! !document-titles
                           (->> rows
                                (map #(.-title %))
                                (remove #(or (nil? %) (= % "")))
                                distinct
                                vec))))))
    (async/Future.value nil)))

(defn find-document-by-title
  "Exact title match among non-deleted documents (first by updated_at desc)."
  [title]
  (if-let [^drift/AppDatabase database @db]
    (let [q (doto (.select database (.-documents database))
              (.where (fn [t]
                        (d/Expression.and
                         [(.equals (.-title t) title)
                          (.isNull (.-deletedAt t))])))
              (.orderBy [(fn [t] (d/OrderingTerm.desc (.-updatedAt t)))])
              (.limit 1))]
      (-> (.get q)
          (.then (fn [rows] (first rows)))))
    (async/Future.value nil)))

(defn get-block [block-id]
  (if-let [^drift/AppDatabase database @db]
    (let [q (doto (.select database (.-blocks database))
              (.where (fn [t] (.equals (.-id t) block-id)))
              (.limit 1))]
      (-> (.get q)
          (.then (fn [rows] (first rows)))))
    (async/Future.value nil)))

(defn all-active-blocks-for-reindex
  "All non-deleted blocks as {:id :text} for full link reindex."
  []
  (if-let [^drift/AppDatabase database @db]
    (let [q (doto (.select database (.-blocks database))
              (.where (fn [t] (.isNull (.-deletedAt t)))))]
      (-> (.get q)
          (.then (fn [rows]
                   (mapv (fn [r]
                           {:id (.-id r)
                            :text (or (.-textContent r) "")})
                         rows)))))
    (async/Future.value [])))
