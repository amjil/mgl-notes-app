(ns notes-app.editor.view
  "Document editor — elegantly managed state, persistence, and performance.
   Uses f/widget's :managed [:dispose] hook for safe teardown and final save.
   Caches the editor-body outside f/widget to prevent unnecessary subtree rebuilds."
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]
            ["dart:async" :as async]
            [clojure.string :as str]
            [cljd.flutter :as f]
            [block-editor.widgets.editor :as editor]
            [block-editor.commands.navigate :as navigate]
            [block-editor.utils.history :as history]
            [notes-app.shared.editor-toolbar :as tb]
            [notes-app.shared.rename-dialog :as rename]
            [notes-app.shared.backlinks :as backlinks]
            [notes-app.editor.bridge :as bridge]
            [notes-app.db.core :as db]
            [notes-app.services.document :as doc]
            [notes-app.services.export :as export]
            [notes-app.publishing.nomio :as nomio-publishing]
            [notes-app.nomio.auth :as nomio-auth]
            [notes-app.services.link :as link]
            [notes-app.plugins.image :as img-plugin]
            [notes-app.plugins.attachment :as attach-plugin]
            [notes-app.plugins.flashcard :as flashcard-plugin]
            [notes-app.services.sm2 :as sm2]
            [block-editor.commands.ops :as ops]
            [notes-app.editor.preview-popover :as popover]
            [block-editor.utils.highlighter :as highlighter]
            [notes-app.state.store :as store]
            [notes-app.theme :as t]
            [notes-app.ui :as ui]))

;; =============================================================================
;; Block Transclusion (Embed) Widget
;; =============================================================================

(defn- embed-widget
  "Renders a read-only mirrored view of another block."
  [target-id current-block-id !state]
  (if (or (nil? target-id) (= target-id ""))
    (m/Container
     .padding (m.EdgeInsets/all 8.0)
     .child (mgl/MongolText "(Loading block or not found...)"
                            .style (t/mongol-style :color t/ink-faint)))
    (f/widget
     :watch [blk-row (stream
                      (map (fn [row] row))
                      :as-values (db/watch-block target-id))]
     (if-not blk-row
     (m/Container
      .padding (m.EdgeInsets/all 8.0)
      .child (mgl/MongolText "(Loading block or not found...)"
                             .style (t/mongol-style :color t/ink-faint)))
     (let [text (or (.-textContent blk-row) "")
           doc-id (.-documentId blk-row)]
       (m/GestureDetector
        .onTap #(store/open-document! doc-id target-id)
        .child
        (m/Container
         .margin (m.EdgeInsets/symmetric .horizontal 8.0 .vertical 4.0)
         .padding (m.EdgeInsets/all 12.0)
         .decoration (m/BoxDecoration
                      .color t/primary-soft
                      .borderRadius (m/BorderRadius.circular 10.0)
                      .border (m/Border .right (m/BorderSide .color t/primary .width 3.0)))
         .child
         (m/Column
          .mainAxisSize m.MainAxisSize/min
          .crossAxisAlignment m.CrossAxisAlignment/start
          .children
          [(m/Row
            .mainAxisSize m.MainAxisSize/min
            .children
            [(m/Icon m.Icons/link .size 16.0 .color t/primary)
             (m/SizedBox .width 8.0)
             ;; Revert back to raw text so user can edit/delete it
             (m/GestureDetector
              .onTap (fn []
                       (history/record-snapshot! !state)
                       (swap! !state update-in [:blocks current-block-id]
                              assoc :type :paragraph :content (str "((" target-id "))")))
              .child
              (m/Icon m.Icons/close .size 16.0 .color t/ink-faint))])
           (m/SizedBox .height 12.0)
           (mgl/MongolText (if (empty? text) "(Empty block)" text)
                           .style (t/mongol-style :size 16.0 :color t/ink-muted))]))))))))

;; =============================================================================
;; Editor config
;; =============================================================================

(defn- make-editor-config [ctx]
  {:block-plugins
   [(img-plugin/image-plugin)
    (attach-plugin/attachment-plugin)
    (flashcard-plugin/flashcard-plugin)
    {:type :embed
     :render (fn [block-id !state _idx _cfg]
               (let [block (get-in @!state [:blocks block-id])
                     target-id (get-in block [:data :target-id])]
                 (embed-widget target-id block-id !state)))
     :render-read (fn [block _style _on-link !state]
                    (let [target-id (get-in block [:data :target-id])]
                      (embed-widget target-id (:id block) !state)))}]
   :text-block-types #{:paragraph :heading-1 :heading-2 :heading-3
                       :blockquote :list-item :ordered-list-item :task :callout :toggle :flashcard}
   :on-link-tap link/handle-link-tap!
   :on-link-hover (fn [title ^m/Offset pos is-hovering?]
                    (if is-hovering?
                      (popover/show-preview! ctx title pos)
                      (popover/hide-preview!)))
   ;; Resolve [[wikilinks]] under the cursor for hover (Mongol ignores TextSpan.onEnter).
   :wiki-link-at highlighter/wiki-link-at
   :wiki-target-at highlighter/wiki-target-at
   :link-suggestions link/link-suggestions
   :tag-suggestions link/tag-suggestions
   :slash-commands
   [{:label "Text" :icon m.Icons/notes :type :paragraph}
    {:label "Heading 1" :icon m.Icons/title :type :heading-1}
    {:label "Heading 2" :icon m.Icons/format_size :type :heading-2}
    {:label "Heading 3" :icon m.Icons/text_fields :type :heading-3}
    {:label "To-do List" :icon m.Icons/check_box :type :task}
    {:label "Bulleted List" :icon m.Icons/format_list_bulleted :type :list-item}
    {:label "Numbered List" :icon m.Icons/format_list_numbered :type :ordered-list-item}
    {:label "Quote" :icon m.Icons/format_quote :type :blockquote}
    {:label "Callout" :icon m.Icons/lightbulb_outline :type :callout}
    {:label "Flashcard" :icon m.Icons/quiz
     :type :flashcard
     :keywords ["flashcard" "card" "quiz"]
     :handler (fn [!state block-id]
                (ops/convert-block! !state block-id :flashcard)
                (swap! !state update-in [:blocks block-id]
                       (fn [b]
                         (assoc b
                                :collapsed? true
                                :data (merge sm2/default-state (:data b {}))))))}
    {:label "Table" :icon m.Icons/table_chart :type :table
     :keywords ["table" "grid"]}
    {:label "Divider" :icon m.Icons/horizontal_rule :type :divider}
    {:label "Image" :icon m.Icons/image
     :action :insert-image
     :handler (fn [!state block-id] (tb/insert-image-from-picker! !state block-id))}
    {:label "Attachment" :icon m.Icons/attach_file
     :action :insert-attachment
     :handler (fn [!state block-id] (tb/insert-attachment-from-picker! !state block-id))}]
   :link-autocomplete-style
   {:background t/surface
    :border-color t/outline
    :divider-color (t/fade t/outline-strong 0.85)
    :splash-color (t/fade t/primary 0.10)
    :highlight-color t/primary-soft
    :text-style (t/mongol-style :size 15.0 :color t/ink :weight m.FontWeight/w500)
    :empty-style (t/mongol-style :size 14.0 :color t/ink-faint)
    :max-width 240.0
    :max-height 240.0
    :item-height 188.0
    :item-min-width 44.0
    :elevation 6.0
    :border-radius t/radius-s}
   :block-style
   (fn [b-type]
     (case b-type
       :heading-1 (t/mongol-style :size 32.0 :weight m/FontWeight.bold)
       :heading-2 (t/mongol-style :size 24.0 :weight m/FontWeight.bold)
       :heading-3 (t/mongol-style :size 20.0 :weight m/FontWeight.w600)
       :task (t/mongol-style :size 18.0)
       (t/mongol-style :size 18.0 :color t/ink-muted)))})

;; =============================================================================
;; Document Outline (TOC)
;; =============================================================================

(defn- extract-headings [state]
  (let [blocks (:blocks state {})
        root (:root state [])
        res (atom [])]
    (letfn [(walk [ids]
              (doseq [id ids]
                (when-let [b (get blocks id)]
                  (let [t (:type b)]
                    (when (contains? #{:heading-1 :heading-2 :heading-3} t)
                      (swap! res conj {:id id :type t :text (:content b)})))
                  ;; Recurse so outline order matches document tree order.
                  (when (seq (:children b))
                    (walk (:children b))))))]
      (walk root)
      @res)))

(defn- toc-panel [!state !show?]
  (f/widget
   :watch [state-val !state
           open? !show?]
   (let [headings (extract-headings state-val)]
     (m/AnimatedContainer
      .duration (dart:core/Duration. .milliseconds 250)
      .curve m.Curves/easeOutCubic
      .width (if open? 220.0 0.0)
      .decoration (m/BoxDecoration
                   .color m.Colors/transparent
                   .border (m/Border .right (m/BorderSide .color t/outline .width 1.0)))
      .child
      (if (not open?)
        (m/SizedBox.shrink)
        (m/Column
         .crossAxisAlignment m.CrossAxisAlignment/stretch
         .children
         [(m/Padding
           .padding (m.EdgeInsets/fromLTRB 12.0 16.0 12.0 8.0)
           .child
           (m/Row
            .mainAxisAlignment m.MainAxisAlignment/spaceBetween
            .children
            [(mgl/MongolText "Гарчиг"
                             .style (t/mongol-style :size 14.0 :weight m.FontWeight/w600 :color t/ink-muted))
             (m/IconButton
              .icon (m/Icon m.Icons/close .size 18.0 .color t/ink-muted)
              .padding m.EdgeInsets/zero
              .constraints (m/BoxConstraints)
              .onPressed #(reset! !show? false))]))
          (m/Expanded
           .child
           (if (empty? headings)
             (ui/empty-state m.Icons/format_list_bulleted "No headings")
             (m/ListView.builder
              .scrollDirection m.Axis/horizontal
              .physics (m/BouncingScrollPhysics.)
              .padding (m.EdgeInsets/symmetric .vertical 8.0 .horizontal 12.0)
              .itemCount (count headings)
              .itemBuilder
              (fn [_ idx]
                (let [{:keys [id type text]} (nth headings idx)
                      level (case type :heading-1 0 :heading-2 1 :heading-3 2 0)
                      indent (* level 20.0)
                      display-text (if (str/blank? text) "Untitled" text)]
                  (m/InkWell
                   .onTap #(navigate/reveal-block! !state id)
                   .borderRadius (m.BorderRadius/circular 8.0)
                   .child
                   (m/Container
                    ;; Vertical Mongolian: hierarchy via top padding, not left margin.
                    .padding (m.EdgeInsets/only .top (+ 8.0 indent) .bottom 8.0 .left 8.0 .right 8.0)
                    .child
                    (mgl/MongolText display-text
                                    .style (t/mongol-style
                                            :size (case type :heading-1 16.0 :heading-2 14.0 13.0)
                                            :weight (if (zero? level) m.FontWeight/w600 m.FontWeight/normal)
                                            :color (if (zero? level) t/ink t/ink-muted))))))))))]))))))

;; =============================================================================
;; Per-document session cache
;; =============================================================================

(defonce ^:private !sessions (atom {}))
(defonce ^:private !pending-nomio-document (atom nil))

(defn- load-session! [document-id]
  (-> (db/get-document document-id)
      (.then (fn [doc]
               (-> (db/get-blocks document-id)
                   (.then (fn [block-rows]
                            (let [rows (or block-rows [])
                                  initial (bridge/rows->editor-state rows)]
                              {:!state (atom initial)
                               :!snapshot (atom (bridge/snapshot-from-state initial))
                               :!title (atom (if doc (or (.-title doc) "") ""))
                               :doc-type (if doc (or (.-type doc) "normal") "normal")
                               :!save-timer (atom nil)}))))))
      (.catchError (fn [e]
                     (dart:core/print (str "load-session! failed: " e))
                     :failed))))

(defn- reveal-pending-focus! [session]
  (when-let [block-id (store/take-focus-block-id!)]
    (navigate/reveal-block! (:!state session) block-id))
  session)

(defn- ensure-session! [document-id]
  (if-let [s (get @!sessions document-id)]
    (do
      (reveal-pending-focus! s)
      (async/Future.value s))
    (-> (bridge/await-persist document-id)
        (.then (fn [_] (load-session! document-id)))
        (.then (fn [s]
                 (if (or (nil? s) (= s :failed))
                   :failed
                   (do
                     (swap! !sessions assoc document-id s)
                     (reveal-pending-focus! s)
                     s)))))))

(defn invalidate-session!
  "Drop cached editor state."
  [document-id]
  (swap! !sessions dissoc document-id))

(defn sync-session-title!
  "Keep an open editor's title atom in sync after an external rename."
  [document-id title]
  (when-let [s (get @!sessions document-id)]
    (reset! (:!title s) (or title ""))))

(defn allow-rename?
  "False for daily journals — titles are date-bound."
  [document-id]
  (not= (:doc-type (get @!sessions document-id)) "daily"))

(defn- cancel-save-timer! [session]
  (when-let [t @(:!save-timer session)]
    (.cancel ^async/Timer t)
    (reset! (:!save-timer session) nil)))

(defn flush-open-sessions!
  "Persist every cached editor so a following pull sees local edits."
  []
  (reduce (fn [fut [doc-id session]]
            (.then fut
                   (fn [_]
                     (cancel-save-timer! session)
                     (bridge/persist-diff! doc-id @(:!state session) (:!snapshot session)))))
          (async/Future.value true)
          (vec @!sessions)))

(defn- reload-session! [document-id session]
  (cancel-save-timer! session)
  (-> (db/get-document document-id)
      (.then (fn [doc]
               (-> (db/get-blocks document-id)
                   (.then (fn [block-rows]
                            (let [rows (or block-rows [])
                                  initial (bridge/rows->editor-state rows)
                                  prev @(:!state session)
                                  ;; Keep host/editor wiring that reset! would wipe.
                                  initial (cond-> initial
                                            (:editor-config prev)
                                            (assoc :editor-config (:editor-config prev)))]
                              (reset! (:!state session) initial)
                              (reset! (:!snapshot session)
                                      (bridge/snapshot-from-state initial))
                              (reset! (:!title session)
                                      (if doc (or (.-title doc) "") ""))
                              (swap! !sessions assoc document-id
                                     (assoc session :doc-type
                                            (if doc (or (.-type doc) "normal") "normal")))
                              true))))))
      (.catchError (fn [e]
                     (dart:core/print (str "reload-session! failed: " e))
                     false))))

(defn reload-open-sessions!
  "Re-read cached editors from DB after remote apply (in-place, same atoms)."
  []
  (-> (flush-open-sessions!)
      (.then (fn [_]
               (reduce (fn [fut [doc-id session]]
                         (.then fut (fn [_] (reload-session! doc-id session))))
                       (async/Future.value true)
                       (vec @!sessions))))))

(defn- show-rename! [ctx document-id !title]
  (rename/rename-dialog ctx @!title
                        (fn [t]
                          (doc/rename! document-id t)
                          (reset! !title t)
                          (db/refresh-document-titles!))))

(defn- doc-title-leading
  "Vertical document title that scrolls with the block list.
   When `on-tap` is nil the title is display-only (e.g. daily notes)."
  [!title on-tap]
  (f/widget
   :watch [title !title]
   (let [label
         (m/Padding
          .padding (m.EdgeInsets/only .right 20.0)
          .child
          (mgl/MongolText
           (let [t (or title "")]
             (if (empty? t) "Untitled" t))
           .style (t/mongol-style :size 28.0 :weight m.FontWeight/bold)))]
     (m/Align
      .alignment m.Alignment/topCenter
      .child
      (if on-tap
        (m/InkWell .onTap on-tap .child label)
        label)))))

(defn- export-html! [ctx !state !title]
  (-> (export/export-state-to-file! @!state @!title)
      (.then (fn [path] (export/show-export-result! ctx path)))
      (.catchError (fn [_] (export/show-export-result! ctx nil)))))

(defn- show-message! [ctx message]
  (.showSnackBar
   (m/ScaffoldMessenger.of ctx)
   (m/SnackBar .content (m/Text (str message)))))

(defn- publish-nomio! [ctx document-id]
  (show-message! ctx "Publishing to Nomio…")
  (-> (flush-open-sessions!)
      (.then (fn [_]
               (nomio-publishing/publish-to-nomio! document-id)))
      (.then
       (fn [result]
         (cond
           (:ok result)
           (show-message! ctx "Published to Nomio")

           (:authorizing result)
           (do
             (reset! !pending-nomio-document document-id)
             (show-message! ctx "Complete Nomio login in your browser"))

           :else
           (show-message! ctx
                          (str "Nomio publish failed: "
                               (or (:detail result) (:error result)))))))
      (.catchError
       (fn [error]
         (show-message! ctx (str "Nomio publish failed: " error))))))

;; =============================================================================
;; Core Editor UI
;; =============================================================================

(defn- editor-chrome
  [document-id session ctx show-back? on-back embedded? show-backlinks? !read-only?]
  (let [{:keys [!state !snapshot !title !save-timer doc-type]} session
        !read-only? (or !read-only? (atom false))
        allow-rename? (not= doc-type "daily")
        cfg (make-editor-config ctx)

        cleanup!
        (fn [_]
          (popover/hide-preview!)
          (when-let [t @!save-timer] (.cancel ^async/Timer t))
          (try
            (bridge/persist-diff! document-id @!state !snapshot)
            (catch Exception _ nil))
          (invalidate-session! document-id)
          (dart:core/print (str "🧹 [Editor] Teardown & final save for doc: " document-id))
          nil)]

    (f/widget

     :managed [_ !save-timer :dispose cleanup!]

     ;; Build the editor/reader only when preview mode changes — not inside the
     ;; !state watch — so resolved-config / blur cannot mark sibling watches dirty.
     :watch [read-only? !read-only?]

     (let [editor-body
           (editor/mongol-block-editor
            !state
            :editor-config cfg
            :toolbar (when-not read-only? (tb/notes-toolbar !state cfg))
            :background-color m.Colors/transparent
            :show-block-handles? (not read-only?)
            :padding (m.EdgeInsets/all 32.0)
            :read-only? read-only?
            :leading-widget (doc-title-leading
                             !title
                             (when allow-rename?
                               #(show-rename! ctx document-id !title)))
            ;; Both desktop shell and mobile editor page provide input chrome.
            ;; Letting the editor wrap itself renders a second candidate panel.
            :wrap-ime? false)]

       (f/widget
        :watch [current-state !state
                title !title
                show-refs? store/!show-backlinks
                nomio-state nomio-auth/auth-state]

        (let [_ (when (and (= :authenticated (:status nomio-state))
                           (= document-id @!pending-nomio-document))
                  (reset! !pending-nomio-document nil)
                  (async/Timer.
                   (dart:core/Duration.zero)
                   #(publish-nomio! ctx document-id)))
              _ (when-let [t @!save-timer] (.cancel ^async/Timer t) nil)
              _ (reset! !save-timer
                        (async/Timer.
                         (dart:core/Duration. .seconds 2)
                         #(bridge/persist-diff! document-id current-state !snapshot)))

              ;; Auto Embed Converter logic: find paragraphs that exactly match ((uuid))
              blocks (:blocks current-state)
              embeds-to-convert
              (keep (fn [[id b]]
                      (when (= (:type b) :paragraph)
                        (let [content (str/trim (or (:content b) ""))]
                          (when-let [match (re-matches #"^\(\((.+)\)\)$" content)]
                            [id (second match)]))))
                    blocks)

              ;; Apply conversions asynchronously to avoid mutating state during render
              _ (when (and (not read-only?) (seq embeds-to-convert))
                  (async/Timer.
                   (dart:core/Duration.zero)
                   (fn []
                     (history/record-snapshot! !state)
                     (swap! !state
                            (fn [s]
                              (reduce (fn [acc [id target-id]]
                                        (update-in acc [:blocks id]
                                                   assoc :type :embed :data {:target-id target-id} :content ""))
                                      s
                                      embeds-to-convert))))))

              show-strip? (and show-backlinks? (not= (or title "") ""))
              toggle-refs! #(store/toggle-show-backlinks!)
              body-row
              (m/Row
               .children
               (into []
                     (remove nil?
                             [(toc-panel !state store/!show-toc)
                              (m/Expanded .child editor-body)
                              (when show-strip?
                                (m/AnimatedContainer
                                 .duration (dart:core/Duration. .milliseconds 200)
                                 .curve m.Curves/easeInOut
                                 .width (if show-refs? 360.0 52.0)
                                 .decoration (m/BoxDecoration
                                              .color m.Colors/transparent
                                              .border (m/Border
                                                       .left (m/BorderSide .color t/outline
                                                                           .width 1.0)))
                                 .padding (m.EdgeInsets/all (if show-refs? 16.0 8.0))
                                 .child
                                 (backlinks/references-sidebar
                                  title
                                  document-id
                                  :on-promoted invalidate-session!
                                  :open? show-refs?
                                  :on-toggle toggle-refs!)))])))]

          (if embedded?
            (m/SafeArea .child body-row)
            (m/Scaffold
             .backgroundColor m.Colors/transparent
             .appBar
             (m/AppBar
              .elevation 0.0
              .scrolledUnderElevation 0.0
              .backgroundColor m.Colors/transparent
              .foregroundColor t/ink
              .surfaceTintColor m.Colors/transparent
              .leading (if show-back?
                         (m/IconButton
                          .icon (m/Icon m.Icons/arrow_back_rounded)
                          .onPressed (or on-back #(store/close-editor!)))
                         nil)
              .actions
              (let [can-undo? (boolean (seq (get-in current-state [:history :undo-stack])))
                    can-redo? (boolean (seq (get-in current-state [:history :redo-stack])))]
                (into []
                      (remove nil?
                              [(m/IconButton
                                .icon (m/Icon m.Icons/format_list_bulleted)
                                .tooltip "Document Outline"
                                .onPressed #(store/toggle-show-toc!))
                               (m/IconButton
                                .icon (m/Icon m.Icons/undo)
                                .tooltip "Undo"
                                .onPressed (when can-undo? #(history/undo! !state)))
                               (m/IconButton
                                .icon (m/Icon m.Icons/redo)
                                .tooltip "Redo"
                                .onPressed (when can-redo? #(history/redo! !state)))
                               (m/IconButton
                                .icon (m/Icon (if show-refs?
                                                m.Icons/chevron_right
                                                m.Icons/account_tree_outlined))
                                .tooltip "Backlinks"
                                .onPressed toggle-refs!)
                               (m/IconButton
                                .icon (m/Icon m.Icons/cloud_upload_outlined)
                                .tooltip "Publish or update on Nomio"
                                .onPressed #(publish-nomio! ctx document-id))
                               (m/IconButton
                                .icon (m/Icon m.Icons/file_download_outlined)
                                .tooltip "Export HTML"
                                .onPressed #(export-html! ctx !state !title))
                               (when allow-rename?
                                 (m/IconButton
                                  .icon (m/Icon m.Icons/drive_file_rename_outline)
                                  .onPressed #(show-rename! ctx document-id !title)))]))))
             .body (m/SafeArea .child body-row)))))))))

;; =============================================================================
;; Public widget
;; =============================================================================

(defn document-editor
  "Mount mongol-block-editor for a document.
   Optional `!read-only?` atom: true → `document-reader` preview (no IME)."
  [document-id & {:keys [show-back? on-back embedded? show-backlinks? !read-only?]
                  :or {show-back? true embedded? false show-backlinks? true}}]
  (f/widget
   :context ctx
   :watch [session (ensure-session! document-id)]
   (cond
     (nil? session) (ui/loading)
     (= session :failed)
     (ui/empty-state m.Icons/error_outline "Could not load document")
     :else
     (editor-chrome document-id session ctx show-back? on-back embedded? show-backlinks? !read-only?))))
