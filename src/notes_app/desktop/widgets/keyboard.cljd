(ns notes-app.desktop.widgets.keyboard
  "Desktop global IME overlay wrapper."
  (:require [cljd.flutter :as f]
            [shared-ime.overlay-view :as overlay]
            [notes-app.state.store :as store]))

(defn wrap
  "Wrap content with the shared desktop IME overlay when built-in IME is enabled."
  [main-content]
  (f/widget
   :watch [{:keys [use-builtin-ime]} store/app-ui-state]
   (if (false? use-builtin-ime)
     main-content
     (overlay/ime-global-wrapper main-content))))
