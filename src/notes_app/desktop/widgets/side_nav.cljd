(ns notes-app.desktop.widgets.side-nav
  "Desktop navigation rail — branded, compact, vertical Mongolian labels."
  (:require [cljd.flutter :as f]
            ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]
            [notes-app.state.store :as store]
            [notes-app.theme :as t]))

(def ^:private rail-width 56.0)

(def ^:private tabs
  [{:id "today" :icon m.Icons/wb_sunny_outlined :selected-icon m.Icons/wb_sunny :label "ᠥᠨᠦᠳᠦᠷ"}
   {:id "documents" :icon m.Icons/folder_outlined :selected-icon m.Icons/folder :label "ᠪᠠᠷᠢᠮᠲᠠ"}
   {:id "tasks" :icon m.Icons/check_box_outlined :selected-icon m.Icons/check_box :label "ᠠᠵᠢᠯ"}
   {:id "tags" :icon m.Icons/tag_outlined :selected-icon m.Icons/tag :label "ᠲᠡᠮᠳᠡᠭ"}
   {:id "search" :icon m.Icons/search :selected-icon m.Icons/search :label "ᠬᠠᠢᠬᠤ"}
   {:id "trash" :icon m.Icons/delete_outline :selected-icon m.Icons/delete :label "ᠬᠣᠭ᠎ᠤᠨ ᠰᠠᠪᠠ"}
   {:id "settings" :icon m.Icons/settings_outlined :selected-icon m.Icons/settings :label "ᠲᠣᠬᠢᠷᠠᠭᠤᠯᠭ᠎ᠠ"}])

(defn- brand-mark []
  (m/Padding
   .padding (m.EdgeInsets/only .top 16.0 .bottom 8.0)
   .child
   (m/Container
    .width 36.0
    .height 36.0
    .decoration (m/BoxDecoration
                 .color t/primary
                 .borderRadius (m.BorderRadius/circular 12.0)
                 .boxShadow [(m/BoxShadow
                              .color (t/fade t/primary 0.35)
                              .blurRadius 12.0
                              .offset (m/Offset 0.0 4.0))])
    .child
    (m/Center
     .child (m/Icon m.Icons/edit_note_rounded
                    .color m.Colors/white
                    .size 20.0)))))

(defn- nav-item [{:keys [icon selected-icon label id]} selected? sync-error? on-tap]
  (let [active? selected?
        icon-w (m/Icon (if active? selected-icon icon)
                       .size 22.0
                       .color (if active? t/primary t/ink-muted))
        marked (if (and sync-error? (= id "settings"))
                 (m/Badge
                  .isLabelVisible false
                  .backgroundColor t/danger
                  .child icon-w)
                 icon-w)]
    (m/Padding
     .padding (m.EdgeInsets/symmetric .horizontal 4.0 .vertical 3.0)
     .child
     (m/InkWell
      .onTap on-tap
      .borderRadius (m.BorderRadius/circular 12.0)
      .child
      (m/AnimatedContainer
       .duration (dart:core/Duration. .milliseconds 180)
       .padding (m.EdgeInsets/symmetric .vertical 8.0 .horizontal 2.0)
       .decoration (m/BoxDecoration
                    .color (if active? t/primary-soft m.Colors/transparent)
                    .borderRadius (m.BorderRadius/circular 12.0))
       .child
       (m/Column
        .mainAxisSize m.MainAxisSize/min
        .crossAxisAlignment m.CrossAxisAlignment/center
        .children
        [marked
         (m/SizedBox .height 6.0)
         (mgl/MongolText
          label
          .maxLines (int 1)
          .softWrap false
          .textAlign mgl.MongolTextAlign/center
          .style (t/mongol-style
                  :size 13.0
                  :weight (if active? m.FontWeight/w600 m.FontWeight/normal)
                  :color (if active? t/primary t/ink-muted)))]))))))

(defn side-navigation-rail []
  (f/widget
   :watch [{:keys [selected-nav-id sync-status auth-token sync-enabled]} store/app-ui-state]
   (let [sync-error? (and sync-enabled auth-token (not= auth-token "") (= sync-status :error))]
     (m/Container
      .width rail-width
      .color t/surface-2
      .child
      (m/Column
       .crossAxisAlignment m.CrossAxisAlignment/center
       .children
       [(brand-mark)
        (m/Expanded
         .child
         (m/SingleChildScrollView
          .padding (m.EdgeInsets/only .top 4.0 .bottom 16.0)
          .child
          (m/Column
           .crossAxisAlignment m.CrossAxisAlignment/stretch
           .children
           (mapv (fn [tab]
                   (nav-item tab
                             (= (:id tab) selected-nav-id)
                             sync-error?
                             #(store/set-nav! (:id tab))))
                 tabs))))])))))
