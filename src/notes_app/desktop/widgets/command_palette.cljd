(ns notes-app.desktop.widgets.command-palette
  "Global Command Palette (Cmd+K). Vertical Mongolian layout."
  (:require ["package:flutter/material.dart" :as m]
            ["dart:ui" :as ui]
            ["package:flutter/services.dart" :as s]
            ["dart:async" :as async]
            ["package:mongol/mongol.dart" :as mgl]
            [clojure.string :as str]
            [cljd.flutter :as f]
            [notes-app.db.core :as db]
            [notes-app.state.store :as store]
            [notes-app.theme :as t]
            [notes-app.services.sync :as sync]
            [notes-app.keyboard :as kw]
            [rich-editor.components.text-field :as custom-tf]
            [notes-app.services.document :as doc]))

(defonce !palette-tf-state (atom {:external-keyboard-delegate nil}))

(defn- cancel-timer! [!timer]
  (when-let [timer @!timer]
    (.cancel ^async/Timer timer)))

(def ^:private static-commands
  [{:id "cmd-sync" :title "Sync Data" :subtitle "Push and pull to cloud"
    :icon m.Icons/cloud_sync :cmd ">sync"
    :action (fn [] (sync/schedule-push!))}
   {:id "cmd-new" :title "New Note" :subtitle "Create a blank normal note"
    :icon m.Icons/post_add :cmd ">new"
    :action (fn [] (-> (doc/create! {:title "" :type "normal"})
                       (.then (fn [id] (when id (store/open-document! id))))))}
   {:id "cmd-today" :title "Today's Note" :subtitle "Go to daily journal"
    :icon m.Icons/wb_sunny :cmd ">today"
    :action (fn [] (store/set-nav! "today"))}
   {:id "cmd-trash" :title "View Trash" :subtitle "Deleted documents"
    :icon m.Icons/delete_outline :cmd ">trash"
    :action (fn [] (store/set-nav! "trash"))}
   {:id "cmd-dark" :title "Toggle Dark Mode" :subtitle "Switch app theme (Coming soon)"
    :icon m.Icons/dark_mode :cmd ">dark"
    :action (fn [] (store/emit-sync-toast! "Dark mode is under construction!"))}])

(defn- map-fts-result [r]
  {:id (str (:document-id r) "-" (:block-id r))
   :title (if (str/blank? (:document-title r)) "Untitled" (:document-title r))
   :subtitle (:block-text r)
   :icon m.Icons/description_outlined
   :action (fn []
             (store/open-document! (:document-id r) (:block-id r)))})

(defn- result-card [item selected? on-tap]
  (let [subtitle (:subtitle item)
        fg (if selected? t/surface t/ink)
        muted (if selected? (t/fade t/surface 0.8) t/ink-muted)
        children
        (cond-> [(m/Icon (:icon item)
                         .color (if selected? t/surface t/primary)
                         .size 32.0)
                 (m/SizedBox .height 16.0)
                 (m/Expanded
                  .flex (int 2)
                  .child
                  (m/Center
                   .child
                   (mgl/MongolText (:title item)
                                   .style (t/mongol-style
                                           :size 18.0
                                           :weight (if selected? m.FontWeight/bold m.FontWeight/w600)
                                           :color fg))))]
          (not (str/blank? subtitle))
          (conj (m/Expanded
                 .flex (int 1)
                 .child
                 (m/Padding
                  .padding (m.EdgeInsets/only .top 16.0)
                  .child
                  (m/Center
                   .child
                   (mgl/MongolText subtitle
                                   .style (t/mongol-style :size 14.0 :color muted)))))))]
    (m/Container
     .width 96.0
     .margin (m.EdgeInsets/only .right 12.0)
     .decoration (m/BoxDecoration
                  .color (if selected? t/primary m.Colors/transparent)
                  .borderRadius (m.BorderRadius/circular 16.0)
                  .border (if-not selected?
                            (m/Border.all .color t/outline .width 1.0)
                            nil))
     .child
     (m/InkWell
      .onTap on-tap
      .borderRadius (m.BorderRadius/circular 16.0)
      .child
      (m/Padding
       .padding (m.EdgeInsets/all 16.0)
       .child
       (m/Column
        .crossAxisAlignment m.CrossAxisAlignment/center
        .children children))))))

(defn- results-pane [res sel-idx execute!]
  (if (empty? res)
    (m/Center
     .child
     (mgl/MongolText "No results found"
                     .style (t/mongol-style :color t/ink-muted)))
    (m/ListView.builder
     .scrollDirection m.Axis/horizontal
     .physics (m/BouncingScrollPhysics.)
     .padding (m.EdgeInsets/all 24.0)
     .itemCount (count res)
     .itemBuilder
     (fn [_ idx]
       (let [item (nth res idx)]
         (result-card item (= idx sel-idx) #(execute! idx)))))))

(defn- search-rail [ctrl focus]
  (m/Container
   .width 80.0
   .padding (m.EdgeInsets/fromLTRB 8.0 24.0 8.0 24.0)
   .color (t/fade t/primary-soft 0.3)
   .child
   (m/Column
    .crossAxisAlignment m.CrossAxisAlignment/center
    .children
    [(m/Icon m.Icons/search .size 28.0 .color t/primary)
     (m/SizedBox .height 24.0)
     (m/Expanded
      .child
      (custom-tf/text-field
       !palette-tf-state
       {:controller ctrl
        :focus-node focus
        :autofocus true
        :hint "Хайх..."
        :max-lines 1
        :style (t/mongol-style :size 20.0 :color t/ink)
        :decoration (m/InputDecoration
                     .border m/InputBorder.none
                     .hintStyle (t/mongol-style :size 20.0 :color t/ink-faint))}))])))

(defn palette-overlay []
  (f/widget
   :watch [show? store/!show-palette]
   (if-not show?
     (m/SizedBox.shrink)
     (f/widget
      :managed [!query (atom "") :dispose nil
                !results (atom static-commands) :dispose nil
                !sel-idx (atom 0) :dispose nil
                !timer (atom nil) :dispose cancel-timer!
                ctrl (m/TextEditingController.) :dispose .dispose
                focus (m/FocusNode.) :dispose .dispose]
      :let [run-search!
            (fn [q]
              (if (str/starts-with? q ">")
                (let [filtered (filterv #(str/includes? (:cmd %) q) static-commands)]
                  (reset! !results filtered)
                  (reset! !sel-idx 0))
                (if (str/blank? q)
                  (do (reset! !results static-commands)
                      (reset! !sel-idx 0))
                  (-> (db/search-documents-and-blocks q)
                      (.then (fn [rows]
                               (when (= q @!query)
                                 (reset! !results (mapv map-fts-result rows))
                                 (reset! !sel-idx 0))))))))
            schedule-search!
            (fn [v]
              (reset! !query v)
              (when-let [timer @!timer] (.cancel ^async/Timer timer))
              (reset! !timer
                      (async/Timer. (dart:core/Duration. .milliseconds 150)
                                    #(run-search! v))))
            execute!
            (fn [idx]
              (let [res @!results]
                (when (and (>= idx 0) (< idx (count res)))
                  (let [item (nth res idx)]
                    ((:action item))
                    (store/close-palette!)))))]
      :bg-watcher ([^m/TextEditingValue {v .-text} ctrl]
                   (schedule-search! (or v "")))
      (m/Stack
       .children
       [(m/Positioned.fill
         .child
         (m/GestureDetector
          .onTap #(store/close-palette!)
          .child
          (m/BackdropFilter
           .filter (ui/ImageFilter.blur .sigmaX 12.0 .sigmaY 12.0)
           .child (m/Container .color (t/fade t/ink 0.2)))))
        (m/Center
         .child
         (m/Material
          .color m.Colors/transparent
          .child
          (kw/wrap-mobile
           (m/Container
            .width 760.0
            .height 480.0
            .decoration (m/BoxDecoration
                         .color t/surface
                         .borderRadius (m.BorderRadius/circular 20.0)
                         .boxShadow [(m/BoxShadow
                                      .color (t/fade t/ink 0.15)
                                      .blurRadius 32.0
                                      .offset (m/Offset 0.0 16.0))])
            .child
            (m/Focus
             .onKeyEvent
             (fn [_ ^s/KeyEvent event]
               (if (instance? s/KeyDownEvent event)
                 (let [k (.-logicalKey event)
                       last-idx (max 0 (dec (count @!results)))]
                   (cond
                     (= k s.LogicalKeyboardKey/arrowRight)
                     (do (swap! !sel-idx #(min last-idx (inc %)))
                         m.KeyEventResult/handled)

                     (= k s.LogicalKeyboardKey/arrowLeft)
                     (do (swap! !sel-idx #(max 0 (dec %)))
                         m.KeyEventResult/handled)

                     (= k s.LogicalKeyboardKey/enter)
                     (do (execute! @!sel-idx)
                         m.KeyEventResult/handled)

                     (= k s.LogicalKeyboardKey/escape)
                     (do (store/close-palette!)
                         m.KeyEventResult/handled)

                     :else m.KeyEventResult/ignored))
                 m.KeyEventResult/ignored))
             .child
             (m/Row
              .crossAxisAlignment m.CrossAxisAlignment/stretch
              .children
              [(search-rail ctrl focus)
               (f/widget
                :watch [res !results
                        sel-idx !sel-idx]
                (m/Expanded
                 .child
                 (results-pane res sel-idx execute!)))]))))))])))))
