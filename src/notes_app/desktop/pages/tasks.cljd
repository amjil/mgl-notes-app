(ns notes-app.desktop.pages.tasks
  (:require ["package:flutter/material.dart" :as m]
            [notes-app.shared.tasks :as tasks]
            [notes-app.theme :as t]
            [notes-app.ui :as ui]))

(defn tasks-page []
  (m/Scaffold
   .appBar (ui/page-app-bar)
   .backgroundColor t/bg
   .body
   (m/SafeArea .child (tasks/tasks-body))))
