(ns notes-app.desktop.shell
  "Desktop app chrome: Modern floating content pane with NavigationRail and Split-Screen."
  (:require ["package:flutter/material.dart" :as m]
            ["dart:core" :as dc]
            ["dart:async" :as async]
            [cljd.flutter :as f]
            [notes-app.state.store :as store]
            [notes-app.desktop.widgets.side-nav :as side-nav]
            [notes-app.desktop.pages.today :as today]
            [notes-app.desktop.pages.documents :as documents]
            [notes-app.desktop.pages.tasks :as tasks]
            [notes-app.shared.graph :as graph]
            [notes-app.desktop.pages.tags :as tags]
            [notes-app.desktop.pages.search :as search]
            [notes-app.desktop.pages.settings :as settings]
            [notes-app.editor.view :as editor]
            [notes-app.desktop.pages.trash :as trash]
            [notes-app.shared.sync-toast :as sync-toast]
            [notes-app.theme :as t]))

(defn- body-for [nav-id open-doc-id]
  (case nav-id
    "today" (today/today-page)
    "documents" (documents/documents-page)
    "tasks" (tasks/tasks-page)
    "graph" (graph/graph-body)
    "tags" (tags/tags-page)
    "search" (search/search-page)
    "settings" (settings/settings-page)
    "trash" (trash/trash-page)
    (today/today-page)))

;; Split-screen: one floating editor card per open document id.
(defn- editor-split-view [ctx doc-ids show-rail?]
  (m/Row
   .crossAxisAlignment m.CrossAxisAlignment/stretch
   .children
   (into []
         (map-indexed
          (fn [idx id]
            (let [is-first? (zero? idx)]
              (m/Expanded
               ;; Stable identity per pane so Row diff does not reuse the wrong editor.
               .key (m/ValueKey id)
               .child
               (m/Container
                .margin (m.EdgeInsets/only
                         .top 8.0
                         .bottom 8.0
                         .right 8.0
                         .left (if (and is-first? (not show-rail?)) 8.0 0.0))
                .decoration (m/BoxDecoration
                             .color t/surface
                             .borderRadius (m.BorderRadius/circular 24.0)
                             .boxShadow (t/card-shadow))
                .child
                (m/ClipRRect
                 .borderRadius (m.BorderRadius/circular 24.0)
                 .child (m/Theme
                         .data (.copyWith (m.Theme/of ctx)
                                          .scaffoldBackgroundColor m.Colors/transparent)
                         .child
                         (editor/document-editor id
                                                 :show-back? true
                                                 ;; Defer state update until after the current layout frame.
                                                 :on-back #(async/Future.microtask
                                                            (fn [] (store/close-editor! nil id)))))))))))
          doc-ids)))

(defn desktop-shell []
  (f/widget
   :context ctx
   :watch [{:keys [selected-nav-id open-document-ids open-document-id]} store/app-ui-state]
   (let [show-rail? true
         is-editor? (= selected-nav-id "editor")
         doc-ids (if (seq open-document-ids) open-document-ids (when open-document-id [open-document-id]))
         content
         (m/AnimatedSwitcher
          .duration (dc/Duration. .milliseconds 250)
          .switchInCurve m.Curves/easeOut
          .switchOutCurve m.Curves/easeIn
          .transitionBuilder (fn [^m/Widget child ^m/Animation animation]
                               (m/FadeTransition .opacity animation .child child))
          .child
          (m/KeyedSubtree
           ;; Do not re-run switcher animation when only a split pane closes.
           .key (m/ValueKey (if is-editor? "editor-views" (str selected-nav-id "-" open-document-id)))
           .child
           (if is-editor?
             (editor-split-view ctx doc-ids show-rail?)
             (body-for selected-nav-id open-document-id))))]
     (sync-toast/sync-toast-host
      (m/Scaffold
       .backgroundColor t/surface-2
       .body
       (m/Row
        .children
        [(side-nav/side-navigation-rail)
         (m/Expanded
          .child
          (if is-editor?
            content
            (m/Container
             .margin (m.EdgeInsets/only
                      .top 8.0
                      .bottom 8.0
                      .right 8.0
                      .left 0.0)
             .decoration (m/BoxDecoration
                          .color t/surface
                          .borderRadius (m.BorderRadius/circular 24.0)
                          .boxShadow (t/card-shadow))
             .child (m/ClipRRect
                     .borderRadius (m.BorderRadius/circular 24.0)
                     .child (m/Theme
                             .data (.copyWith (m.Theme/of ctx)
                                              .scaffoldBackgroundColor m.Colors/transparent)
                             .child content)))))]))))))
