(ns notes-app.desktop.shell
  "Desktop app chrome: Modern floating content pane with NavigationRail."
  (:require ["package:flutter/material.dart" :as m]
            ["dart:core" :as dc]
            [cljd.flutter :as f]
            [notes-app.state.store :as store]
            [notes-app.desktop.widgets.side-nav :as side-nav]
            [notes-app.desktop.pages.today :as today]
            [notes-app.desktop.pages.documents :as documents]
            [notes-app.desktop.pages.tasks :as tasks]
            [notes-app.shared.graph :as graph]
            [notes-app.desktop.pages.tags :as tags]
            [notes-app.desktop.pages.search :as search]
            [notes-app.desktop.pages.settings :as settings]
            [notes-app.editor.view :as editor]
            [notes-app.desktop.pages.trash :as trash]
            [notes-app.shared.sync-toast :as sync-toast]
            [notes-app.theme :as t]))

(defn- body-for [nav-id open-doc-id]
  (case nav-id
    "today" (today/today-page)
    "documents" (documents/documents-page)
    "tasks" (tasks/tasks-page)
    "graph" (graph/graph-body)
    "tags" (tags/tags-page)
    "search" (search/search-page)
    "settings" (settings/settings-page)
    "editor" (if open-doc-id
               (editor/document-editor open-doc-id
                                       :show-back? true
                                       :on-back store/close-editor!)
               (documents/documents-page))
    "trash" (trash/trash-page)
    (today/today-page)))

(defn desktop-shell []
  (f/widget
   :context ctx
   :watch [{:keys [selected-nav-id open-document-id]} store/app-ui-state]
   (let [show-rail? (not= selected-nav-id "editor")
         content
         (m/AnimatedSwitcher
          .duration (dc/Duration. .milliseconds 250)
          .switchInCurve m.Curves/easeOut
          .switchOutCurve m.Curves/easeIn
          .transitionBuilder (fn [^m/Widget child ^m/Animation animation]
                               (m/FadeTransition .opacity animation .child child))
          .child
          (m/Container
           .key (m/ValueKey (str selected-nav-id "-" open-document-id))
           .child (body-for selected-nav-id open-document-id)))]
     (sync-toast/sync-toast-host
      (m/Scaffold
       .backgroundColor t/surface-2
       .body
       (m/Row
        .children
        (cond-> []
          show-rail?
          (conj (side-nav/side-navigation-rail))

          :always
          (conj
           (m/Expanded
            .child
            (m/Container
             .margin (m.EdgeInsets/only
                      .top 8.0
                      .bottom 8.0
                      .right 8.0
                      .left (if show-rail? 0.0 8.0))
             .decoration (m/BoxDecoration
                          .color t/surface
                          .borderRadius (m.BorderRadius/circular 24.0)
                          .boxShadow (t/card-shadow))
             .child (m/ClipRRect
                     .borderRadius (m.BorderRadius/circular 24.0)
                     .child (m/Theme
                             .data (.copyWith (m.Theme/of ctx)
                                              .scaffoldBackgroundColor m.Colors/transparent)
                             .child content))))))))))))
