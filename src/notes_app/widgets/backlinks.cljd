(ns notes-app.widgets.backlinks
  "Linked + unlinked references sidebar for the current document title."
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]
            [cljd.flutter :as f]
            [notes-app.services.link :as link]
            [notes-app.services.sync :as sync]
            [notes-app.state.store :as store]
            [notes-app.theme :as t]))

(defn- preview-text [text]
  (let [t (or text "")
        n (min (count t) 80)]
    (if (<= (count t) 80)
      t
      (str (.substring t 0 n) "…"))))

(defn- display-doc-title [title]
  (let [t (or title "")]
    (if (= (.trim ^String t) "")
      "Untitled"
      t)))

(defn- reference-card
  [{:keys [block-id block-text document-id document-title]} kind on-promote]
  (let [unlinked? (= kind :unlinked)]
    (m/Container
     .margin (m.EdgeInsets/only .right 16.0)
     .padding (m.EdgeInsets/all 12.0)
     .decoration (m/BoxDecoration
                  .color (if unlinked? t/warning-soft t/surface)
                  .borderRadius (m.BorderRadius/circular 12.0)
                  .border (m/Border.all
                           .color (if unlinked? (t/fade t/warning 0.35) t/outline)
                           .width 1.0)
                  .boxShadow (t/card-shadow))
     .child
     (m/Column
      .crossAxisAlignment m.CrossAxisAlignment/start
      .mainAxisSize m.MainAxisSize/min
      .children
      (into []
            (remove nil?
                    [(m/GestureDetector
                      .onTap #(when document-id
                                (store/open-document! document-id block-id))
                      .child
                      (mgl/MongolText
                       (display-doc-title document-title)
                       .style (t/mongol-style
                               :color (if unlinked? t/warning t/primary)
                               :weight m.FontWeight/bold
                               :size 14.0)))
                     (m/SizedBox .height 10.0)
                     (m/GestureDetector
                      .onTap #(when document-id
                                (store/open-document! document-id block-id))
                      .child
                      (mgl/MongolText
                       (preview-text block-text)
                       .style (t/mongol-style :color t/ink-muted :size 13.0)))
                     (when (and unlinked? on-promote)
                       (m/Padding
                        .padding (m.EdgeInsets/only .top 10.0)
                        .child
                        (mgl/MongolTextButton
                         .style (m/TextButton.styleFrom
                                 .foregroundColor t/warning
                                 .padding (m.EdgeInsets/zero))
                         .onPressed on-promote
                         .child
                         (mgl/MongolText
                          "Link"
                          .style (t/mongol-style :size 12.0 :color t/warning)))))]))))))

(defn- section-header [label color]
  (m/Padding
   .padding (m.EdgeInsets/only .bottom 12.0)
   .child
   (mgl/MongolText
    label
    .style (t/mongol-style :size 15.0 :color color :weight m.FontWeight/w600))))

(defn- cards-row [cards]
  (m/SingleChildScrollView
   .scrollDirection m.Axis/horizontal
   .child
   (m/Row
    .crossAxisAlignment m.CrossAxisAlignment/start
    .children (vec cards))))

(defn references-sidebar
  "Watch linked + unlinked refs for `page-title`.
   `document-id` excludes the current page from unlinked results.
   Optional `on-promoted` receives affected document-id after promote."
  [page-title document-id & {:keys [on-promoted]}]
  (f/widget
   :watch [backlinks (stream
                      (map (fn [rows] (or rows [])))
                      ;; Query via the link namespace
                      :as-values (link/watch-backlinks page-title))
           unlinked (stream
                     (map (fn [rows] (or rows [])))
                     ;; Query via the link namespace
                     :as-values (link/watch-unlinked-references page-title document-id))]
   :let [backlinks (or backlinks [])
         unlinked (->> (or unlinked [])
                       (remove (fn [item]
                                 (or (= (:document-id item) document-id)
                                     (= (:document-title item) page-title))))
                       vec)
         linked-cards (mapv (fn [item] (reference-card item :linked nil)) backlinks)
         unlinked-cards
         (mapv (fn [item]
                 (reference-card
                  item
                  :unlinked
                  (fn []
                    (-> (link/promote-unlinked-to-link! item page-title)
                        (.then (fn [doc-id]
                                 (when (and doc-id on-promoted)
                                   (on-promoted doc-id))
                                 (sync/schedule-push!)))))))
               unlinked)]
   (m/Column
    .crossAxisAlignment m.CrossAxisAlignment/start
    .children
    (into []
          (remove nil?
                  [(section-header
                    (if (empty? backlinks)
                      "No linked references"
                      (str "Linked (" (count backlinks) ")"))
                    t/ink-muted)
                   (m/Expanded .child (cards-row linked-cards))
                   (when (seq unlinked)
                     (m/Padding
                      .padding (m.EdgeInsets/only .top 16.0)
                      .child
                      (section-header
                       (str "Unlinked (" (count unlinked) ")")
                       t/warning)))
                   (when (seq unlinked)
                     (m/Expanded .child (cards-row unlinked-cards)))])))))