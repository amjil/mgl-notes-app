(ns notes-app.widgets.backlinks
  "Linked + unlinked references sidebar for the current document title."
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]
            [cljd.flutter :as f]
            [notes-app.services.link :as link]
            [notes-app.services.sync :as sync]
            [notes-app.state.store :as store]
            [notes-app.theme :as t]))

(defn- preview-text [text]
  (let [t (or text "")
        n (min (count t) 80)]
    (if (<= (count t) 80)
      t
      (str (.substring t 0 n) "…"))))

(defn- display-doc-title [title]
  (let [t (or title "")]
    (if (= (.trim ^String t) "")
      "Untitled"
      t)))

(defn- reference-card
  [{:keys [block-id block-text document-id document-title]} kind on-promote]
  (let [unlinked? (= kind :unlinked)]
    (m/Container
     .margin (m.EdgeInsets/only .right 12.0)
     .padding (m.EdgeInsets/all 12.0)
     .decoration (m/BoxDecoration
                  .color (if unlinked? t/warning-soft t/surface)
                  .borderRadius (m.BorderRadius/circular 12.0)
                  .border (m/Border.all
                           .color (if unlinked? (t/fade t/warning 0.35) t/outline)
                           .width 1.0)
                  .boxShadow (t/card-shadow))
     .child
     (m/Column
      .crossAxisAlignment m.CrossAxisAlignment/start
      .children
      (into []
            (remove nil?
                    [(m/GestureDetector
                      .onTap #(when document-id
                                (store/open-document! document-id block-id))
                      .child
                      (mgl/MongolText
                       (display-doc-title document-title)
                       .style (t/mongol-style
                               :color (if unlinked? t/warning t/primary)
                               :weight m.FontWeight/bold
                               :size 14.0)))
                     (m/SizedBox .height 10.0)
                     (m/Expanded
                      .child
                      (m/GestureDetector
                       .onTap #(when document-id
                                 (store/open-document! document-id block-id))
                       .child
                       (mgl/MongolText
                        (preview-text block-text)
                        .style (t/mongol-style :color t/ink-muted :size 13.0))))
                     (when (and unlinked? on-promote)
                       (m/Padding
                        .padding (m.EdgeInsets/only .top 10.0)
                        .child
                        (mgl/MongolTextButton
                         .style (m/TextButton.styleFrom
                                 .foregroundColor t/warning
                                 .padding (m.EdgeInsets/zero))
                         .onPressed on-promote
                         .child
                         (mgl/MongolText
                          "Link"
                          .style (t/mongol-style :size 12.0 :color t/warning)))))]))))))

(defonce ^:private !sections-open
  (atom {:linked true :unlinked true}))

(defn- toggle-section! [k]
  (swap! !sections-open update k not))

(defn- section-header [label color open? on-toggle]
  (m/Material
   .color m.Colors/transparent
   .child
   (m/InkWell
    .onTap on-toggle
    .borderRadius (m.BorderRadius/circular 8.0)
    .child
    (m/Container
     .padding (m.EdgeInsets/fromLTRB 4.0 8.0 8.0 8.0)
     .decoration (m/BoxDecoration
                  .color (if open? m.Colors/transparent (t/fade color 0.10))
                  .borderRadius (m.BorderRadius/circular 8.0))
     .child
     (m/Column
      .children
      [(m/Expanded
        .child
        (mgl/MongolText
         label
         .style (t/mongol-style :size 15.0 :color color :weight m.FontWeight/w600)))
       (m/Icon
        (if open? m.Icons/chevron_left m.Icons/chevron_right)
        .size 18.0
        .color color)])))))

(defn- cards-row [cards]
  (m/SingleChildScrollView
   .scrollDirection m.Axis/horizontal
   .physics (m/BouncingScrollPhysics)
   .child
   (m/Row
    .crossAxisAlignment m.CrossAxisAlignment/stretch
    .children (vec cards))))

(defn- section-pane
  "Vertical title rail + cards. Collapsed shows only the tappable rail."
  [{:keys [open? on-toggle label color cards]}]
  (let [header (section-header label color open? on-toggle)
        body (m/Row
              .crossAxisAlignment m.CrossAxisAlignment/stretch
              .children
              (into []
                    (remove nil?
                            [header
                             (when open?
                               (m/Expanded .child (cards-row cards)))])))]
    (if open?
      (m/Expanded .child body)
      body)))

(defn references-sidebar
  "Watch linked + unlinked refs for `page-title`.
   `document-id` excludes the current page from unlinked results.
   Optional `on-promoted` receives affected document-id after promote."
  [page-title document-id & {:keys [on-promoted]}]
  (f/widget
   :watch [backlinks (stream
                      (map (fn [rows] (or rows [])))
                      ;; Query via the link namespace
                      :as-values (link/watch-backlinks page-title))
           unlinked (stream
                     (map (fn [rows] (or rows [])))
                     ;; Query via the link namespace
                     :as-values (link/watch-unlinked-references page-title document-id))
           open-sections !sections-open]
   :let [backlinks (or backlinks [])
         unlinked (->> (or unlinked [])
                       (remove (fn [item]
                                 (or (= (:document-id item) document-id)
                                     (= (:document-title item) page-title))))
                       vec)
         linked-open? (get open-sections :linked true)
         unlinked-open? (get open-sections :unlinked true)
         linked-cards (mapv (fn [item] (reference-card item :linked nil)) backlinks)
         unlinked-cards
         (mapv (fn [item]
                 (reference-card
                  item
                  :unlinked
                  (fn []
                    (-> (link/promote-unlinked-to-link! item page-title)
                        (.then (fn [doc-id]
                                 (when (and doc-id on-promoted)
                                   (on-promoted doc-id))
                                 (sync/schedule-push!)))))))
               unlinked)]
   (m/Row
    .crossAxisAlignment m.CrossAxisAlignment/stretch
    .children
    (into []
          (remove nil?
                  [(section-pane
                    {:open? linked-open?
                     :on-toggle #(toggle-section! :linked)
                     :label (if (empty? backlinks)
                              "No linked references"
                              (str "Linked (" (count backlinks) ")"))
                     :color t/ink-muted
                     :cards linked-cards})
                   (when (seq unlinked)
                     (m/VerticalDivider
                      .width 12.0
                      .thickness 1.0
                      .color t/outline))
                   (when (seq unlinked)
                     (section-pane
                      {:open? unlinked-open?
                       :on-toggle #(toggle-section! :unlinked)
                       :label (str "Unlinked (" (count unlinked) ")")
                       :color t/warning
                       :cards unlinked-cards}))])))))