(ns notes-app.widgets.bottom-nav
  (:require [cljd.flutter :as f]
            ["package:flutter/material.dart" :as m]
            ["package:flutter/services.dart" :as s]
            [notes-app.state.store :as store]))

(def ^:private tabs ["today" "documents" "tasks" "tags" "search" "settings"])

(defn main-navigation-bar []
  (f/widget
   :watch [{:keys [selected-nav-id]} store/app-ui-state]
   (let [idx (or (first (keep-indexed (fn [i t] (when (= t selected-nav-id) i)) tabs)) 0)]
     (m/NavigationBar
      .selectedIndex (int idx)
      .onDestinationSelected
      (fn [i]
        (s/HapticFeedback.mediumImpact)
        (store/set-nav! (nth tabs (int i) "today")))
      .destinations
      [(m/NavigationDestination
        .icon (m/Icon m.Icons/wb_sunny_outlined)
        .selectedIcon (m/Icon m.Icons/wb_sunny)
        .label "Today")
       (m/NavigationDestination
        .icon (m/Icon m.Icons/folder_outlined)
        .selectedIcon (m/Icon m.Icons/folder)
        .label "Docs")
       (m/NavigationDestination
        .icon (m/Icon m.Icons/check_box_outlined)
        .selectedIcon (m/Icon m.Icons/check_box)
        .label "Tasks")
       (m/NavigationDestination
        .icon (m/Icon m.Icons/tag_outlined)
        .selectedIcon (m/Icon m.Icons/tag)
        .label "Tags")
       (m/NavigationDestination
        .icon (m/Icon m.Icons/search)
        .selectedIcon (m/Icon m.Icons/search)
        .label "Search")
       (m/NavigationDestination
        .icon (m/Icon m.Icons/settings_outlined)
        .selectedIcon (m/Icon m.Icons/settings)
        .label "Settings")]))))
