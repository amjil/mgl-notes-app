(ns notes-app.widgets.editor-toolbar
  "In-app toolbar with image/attachment pickers."
  (:require ["package:flutter/material.dart" :as m]
            ["package:flutter/services.dart" :as s]
            [cljd.flutter :as f]
            [clojure.string :as str]
            [rich-editor.commands.transaction :as tx]
            [block-editor.commands.ops :as ops]
            [block-editor.utils.history :as history]
            [notes-app.services.asset :as asset]
            [notes-app.services.sync :as sync]))

(defn- toolbar-button [icon tooltip is-active? on-tap]
  (m/IconButton
   .icon (m/Icon icon)
   .tooltip tooltip
   .color (cond
            (nil? on-tap) m.Colors/black26
            is-active? m.Colors/blue
            :else m.Colors/black54)
   .onPressed on-tap))

(defn- insert-image-from-picker! [!state active-id]
  (-> (asset/pick-and-create! :image-only? true)
      (.then (fn [asset-id]
               (when asset-id
                 (ops/convert-block! !state active-id :image)
                 (tx/commit-transaction!
                  !state
                  (tx/make-transaction
                   :ops [(tx/update-data-op active-id
                                            {:asset-id asset-id
                                             :width-ratio (/ 2.0 3.0)
                                             :url ""})
                         (tx/update-data-op active-id {:content ""})]
                   :after-selection nil))
                 (sync/schedule-push!))))))

(defn- insert-attachment-from-picker! [!state active-id]
  (-> (asset/pick-and-create!)
      (.then (fn [asset-id]
               (when asset-id
                 (-> (asset/get-asset asset-id)
                     (.then (fn [row]
                              (ops/convert-block! !state active-id :attachment)
                              (tx/commit-transaction!
                               !state
                               (tx/make-transaction
                                :ops [(tx/update-data-op active-id
                                                         {:asset-id asset-id
                                                          :filename (when row (.-filename row))
                                                          :mime (when row (.-mimeType row))})
                                      (tx/update-data-op active-id {:content ""})]
                                :after-selection nil))
                              (sync/schedule-push!)))))))))

(defn notes-toolbar
  "Toolbar with image, attachment, and Copy Block Ref."
  [!state cfg]
  (f/widget
   :context ctx
   :watch [state-val !state]
   (let [active-id (:active-block-id state-val)
         block (get-in state-val [:blocks active-id])
         block-type (:type block :paragraph)
         can-undo? (boolean (seq (get-in state-val [:history :undo-stack])))
         can-redo? (boolean (seq (get-in state-val [:history :redo-stack])))]
     (m/Container
      .height 50.0
      .width double/infinity
      .decoration (m/BoxDecoration
                   .color (if (= (.-brightness (m/Theme.of ctx)) m/Brightness.dark)
                            m/Colors.grey.shade900
                            m/Colors.white)
                   .boxShadow [(m/BoxShadow
                                .color (-> m.Colors/black (.withOpacity 0.05))
                                .blurRadius 4.0
                                .offset (m/Offset 0.0 -2.0))])
      .child
      (if active-id
        (m/SingleChildScrollView
         .scrollDirection m.Axis/horizontal
         .child
         (m/Row
          .children
          [(m/SizedBox .width 8.0)
           (toolbar-button m.Icons/undo "Undo" false
                           (when can-undo? #(history/undo! !state)))
           (toolbar-button m.Icons/redo "Redo" false
                           (when can-redo? #(history/redo! !state)))
           (m/VerticalDivider .indent 12.0 .endIndent 12.0 .width 16.0)
           (toolbar-button m.Icons/notes "Text" (= block-type :paragraph)
                           #(ops/convert-block! !state active-id :paragraph))
           (m/VerticalDivider .indent 12.0 .endIndent 12.0 .width 16.0)
           (toolbar-button m.Icons/title "Heading 1" (= block-type :heading-1)
                           #(ops/convert-block! !state active-id :heading-1))
           (toolbar-button m.Icons/format_size "Heading 2" (= block-type :heading-2)
                           #(ops/convert-block! !state active-id :heading-2))
           (toolbar-button m.Icons/text_fields "Heading 3" (= block-type :heading-3)
                           #(ops/convert-block! !state active-id :heading-3))
           (m/VerticalDivider .indent 12.0 .endIndent 12.0 .width 16.0)
           (toolbar-button m.Icons/format_list_bulleted "List" (= block-type :list-item)
                           #(ops/convert-block! !state active-id :list-item))
           (toolbar-button m.Icons/format_list_numbered "Numbered List" (= block-type :ordered-list-item)
                           #(ops/convert-block! !state active-id :ordered-list-item))
           (toolbar-button m.Icons/check_box "Task" (= block-type :task)
                           #(ops/convert-block! !state active-id :task))
           (toolbar-button m.Icons/format_quote "Quote" (= block-type :blockquote)
                           #(ops/convert-block! !state active-id :blockquote))
           (m/VerticalDivider .indent 12.0 .endIndent 12.0 .width 16.0)
           (toolbar-button m.Icons/image "Image" (= block-type :image)
                           #(insert-image-from-picker! !state active-id))
           (toolbar-button m.Icons/attach_file "Attachment" (= block-type :attachment)
                           #(insert-attachment-from-picker! !state active-id))
           (toolbar-button m.Icons/horizontal_rule "Divider" (= block-type :divider)
                           #(ops/convert-block! !state active-id :divider))
           (toolbar-button m.Icons/bookmark_border "Bookmark" (= block-type :bookmark)
                           (fn []
                             (let [current-content (get-in state-val [:blocks active-id :content] "")
                                   is-url? (str/starts-with? current-content "http")]
                               (ops/convert-block! !state active-id :bookmark)
                               (tx/commit-transaction!
                                !state
                                (tx/make-transaction
                                 :ops [(tx/update-data-op active-id
                                                          {:url (if is-url? current-content "")
                                                           :title (if is-url? current-content "Web Bookmark")
                                                           :desc "External web page reference"})
                                       (tx/update-data-op active-id {:content (if is-url? "" current-content)})]
                                 :after-selection nil)))))
           (toolbar-button m.Icons/lightbulb_outline "Callout" (= block-type :callout)
                           #(ops/convert-block! !state active-id :callout))
           (toolbar-button m.Icons/arrow_right "Toggle" (= block-type :toggle)
                           #(ops/convert-block! !state active-id :toggle))
           
           (m/VerticalDivider .indent 12.0 .endIndent 12.0 .width 16.0)
           ;; 🌟 Embed Button: Copy current block ID as ((uuid))
           (toolbar-button m.Icons/content_copy "Copy Block Ref" false
                           (fn []
                             (let [ref-text (str "((" active-id "))")]
                               (s/Clipboard.setData (s/ClipboardData .text ref-text))
                               (when ctx
                                 (-> (m/ScaffoldMessenger.of ctx)
                                     (.showSnackBar (m/SnackBar 
                                                     .content (m/Text "Block reference copied to clipboard!"
                                                                      .style (m/TextStyle .fontFamily "OyunQaganTig"))
                                                     .duration (dart:core/Duration .seconds 2))))))))
           (m/SizedBox .width 16.0)]))
        (m/Row
         .mainAxisAlignment m.MainAxisAlignment/center
         .children
         [(toolbar-button m.Icons/undo "Undo" false
                          (when can-undo? #(history/undo! !state)))
          (toolbar-button m.Icons/redo "Redo" false
                          (when can-redo? #(history/redo! !state)))
          (m/SizedBox .width 12.0)
          (m/Text "Select a block"
                  .style (m/TextStyle .color m.Colors/grey))]))))))