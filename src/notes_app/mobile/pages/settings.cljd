(ns notes-app.mobile.pages.settings
  (:require ["package:flutter/material.dart" :as m]
            [notes-app.shared.settings-form :as form]
            [notes-app.theme :as t]
            [notes-app.ui :as ui]))

(defn settings-page []
  (m/Scaffold
   .backgroundColor t/bg
   .appBar (ui/page-app-bar)
   .body (form/settings-body)))
