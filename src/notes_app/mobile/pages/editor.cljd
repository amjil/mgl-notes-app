(ns notes-app.mobile.pages.editor
  (:require ["package:flutter/material.dart" :as m]
            [cljd.flutter :as f]
            [notes-app.editor.view :as editor]
            [notes-app.shared.backlinks :as backlinks]
            [notes-app.shared.rename-dialog :as rename]
            [notes-app.db.core :as db]
            [notes-app.keyboard :as kw]
            [notes-app.mobile.nav :as nav]
            [notes-app.services.document :as doc]
            [notes-app.services.export :as export]
            [notes-app.state.store :as store]
            [notes-app.theme :as t]
            [notes-app.ui :as ui]))

(defn- show-backlinks-modal! [ctx title document-id]
  (m/showDialog
   .context ctx
   .builder
   (fn [c]
     (m/Dialog
      .insetPadding (m.EdgeInsets/zero)
      .child
      (m/Container
       .width double/infinity
       .height double/infinity
       .color t/surface
       .child
       (m/Column
        .children
        [(m/AppBar
          .elevation 0.0
          .backgroundColor t/bg
          .leading (m/IconButton
                    .icon (m/Icon m.Icons/close)
                    .onPressed #(.pop (m/Navigator.of c)))
          .title (m/Text "Backlinks"
                         .style (t/mongol-style :size 16.0 :weight m.FontWeight/w600)))
         (m/Expanded
          .child
          (m/Padding
           .padding (m.EdgeInsets/all 12.0)
           .child
           (backlinks/references-sidebar
            (or title "")
            document-id
            :on-promoted editor/invalidate-session!)))]))))))

(defn- with-doc! [document-id f]
  (-> (db/get-document document-id)
      (.then (fn [d]
               (f (when d
                    {:title (or (.-title d) "")
                     :type (or (.-type d) "normal")}))))))

(defn editor-page []
  (let [!preview? (atom true)
        !doc-type (atom nil)]
    (f/widget
     :context ctx
     :get [m/Navigator]
     :watch [{:keys [open-document-id]} store/app-ui-state
             preview? !preview?
             doc-type !doc-type]
     :managed [route-token (nav/editor-route-opened!)
               :dispose nav/editor-route-closed!
               _ (do
                   (reset! !doc-type nil)
                   (when open-document-id
                     (let [requested-id open-document-id]
                       (with-doc! requested-id
                         (fn [doc]
                           (when (= requested-id
                                    (:open-document-id @store/app-ui-state))
                             (reset! !doc-type (when doc (:type doc))))))))
                   nil)
               :refresh-on [open-document-id]
               :dispose nil]
     (m/Scaffold
      .backgroundColor t/bg
      .resizeToAvoidBottomInset false
      .appBar
      (m/AppBar
       .elevation 0.0
       .scrolledUnderElevation 0.0
       .backgroundColor t/bg
       .foregroundColor t/ink
       .leading (m/IconButton
                 .icon (m/Icon m.Icons/arrow_back_rounded)
                 .onPressed (fn []
                              (.pop navigator)
                              nil))
       .actions
       (if-not open-document-id
         []
         (into []
               (remove nil?
                       [(m/IconButton
                         .icon (m/Icon (if preview?
                                         m.Icons/edit_outlined
                                         m.Icons/visibility_outlined))
                         .tooltip (if preview? "Edit" "Preview")
                         .onPressed #(swap! !preview? not))
                        (m/IconButton
                         .icon (m/Icon m.Icons/account_tree_outlined)
                         .tooltip "Backlinks"
                         .onPressed #(with-doc!
                                       open-document-id
                                       (fn [doc]
                                         (when doc
                                           (show-backlinks-modal!
                                            ctx (:title doc) open-document-id)))))
                        (m/IconButton
                         .icon (m/Icon m.Icons/file_download_outlined)
                         .tooltip "Export HTML"
                         .onPressed (fn []
                                      (-> (export/export-document-to-file! open-document-id)
                                          (.then (fn [path] (export/show-export-result! ctx path)))
                                          (.catchError (fn [_] (export/show-export-result! ctx nil))))))
                        (when (and doc-type (not= doc-type "daily"))
                          (m/IconButton
                           .icon (m/Icon m.Icons/drive_file_rename_outline)
                           .onPressed #(with-doc!
                                         open-document-id
                                         (fn [doc]
                                           (when (and doc (not= (:type doc) "daily"))
                                             (rename/rename-dialog
                                              ctx (:title doc)
                                              (fn [tit]
                                                (doc/rename! open-document-id tit)
                                                (editor/sync-session-title! open-document-id tit)
                                                (db/refresh-document-titles!))))))))]))))
      .body
      (if-not open-document-id
        (ui/empty-state m.Icons/edit_note "No document")
        (m/KeyedSubtree
         .key (m/ValueKey open-document-id)
         .child
         (kw/wrap
          (editor/document-editor open-document-id
                                  :show-back? false
                                  :embedded? true
                                  :show-backlinks? false
                                  :!read-only? !preview?))))))))
