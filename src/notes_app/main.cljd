(ns notes-app.main
  (:require ["package:flutter/material.dart" :as m]
            [cljd.flutter :as f]
            [notes-app.platform :as platform]
            [notes-app.bootstrap.desktop :as desktop-boot]
            [notes-app.bootstrap.mobile :as mobile-boot]
            [notes-app.db.core :as db]
            [notes-app.state.store :as store]
            [notes-app.pages.shell :as shell]
            [notes-app.services.sync :as sync]
            [notes-app.services.link :as link]
            [notes-app.services.daily :as daily]
            [notes-app.theme :as theme]
            [notes-app.ui :as ui]))

(defn- boot!
  "Init DB, prefs, link index, and today's daily doc. Resolves to true when ready."
  []
  (-> (db/initialize-database!)
      (.then (fn [_] (store/load-prefs!)))
      (.then (fn [_] (db/refresh-document-titles!)))
      ;; Local derived index — covers migration + text already on disk before first edit.
      (.then (fn [_] (link/reindex-all-links!)))
      (.then (fn [_] (daily/ensure-today!)))
      (.then (fn [_]
               (shell/register-lifecycle!)
               (sync/on-app-start!)
               true))
      (.catchError (fn [e]
                     (dart:core/print (str "Startup failed: " e))
                     false))))

(defn main []
  (m/WidgetsFlutterBinding.ensureInitialized)

  (if (platform/desktop?)
    (desktop-boot/init!)
    (mobile-boot/init!))

  (f/run
   :watch [ready? (boot!)]
   (m/MaterialApp
    .title "Amjil Notes"
    .debugShowCheckedModeBanner false
    .theme theme/app-theme
    .home (if ready?
            (shell/app-shell)
            (m/Scaffold
             .backgroundColor theme/bg
             .body (ui/loading))))))
