(ns notes-app.main
  (:require ["package:flutter/material.dart" :as m]
            [cljd.flutter :as f]
            [notes-app.platform :as platform]
            [notes-app.bootstrap.desktop :as desktop-boot]
            [notes-app.bootstrap.mobile :as mobile-boot]
            [notes-app.db.core :as db]
            [notes-app.state.store :as store]
            [notes-app.pages.shell :as shell]
            [notes-app.services.sync :as sync]
            [notes-app.services.daily :as daily]))

(defn- boot!
  "Init DB, prefs, and today's daily doc. Resolves to true when ready."
  []
  (-> (db/initialize-database!)
      (.then (fn [_] (store/load-prefs!)))
      (.then (fn [_] (daily/ensure-today!)))
      (.then (fn [_]
               (shell/register-lifecycle!)
               (sync/on-app-start!)
               true))
      (.catchError (fn [e]
                     (dart:core/print (str "Startup failed: " e))
                     false))))

(defn main []
  (m/WidgetsFlutterBinding.ensureInitialized)

  (if (platform/desktop?)
    (desktop-boot/init!)
    (mobile-boot/init!))

  (f/run
   :watch [ready? (boot!)]
   (m/MaterialApp
    .title "Amjil Notes"
    .debugShowCheckedModeBanner false
    .theme (m/ThemeData
            .primarySwatch m.Colors/blue
            .scaffoldBackgroundColor (m/Color 0xFF121212)
            .fontFamily "OyunQaganTig"
            .brightness m.Brightness/dark
            .textTheme (m/TextTheme
                        .bodyMedium (m/TextStyle .color m.Colors/white
                                                 .fontSize 16.0
                                                 .fontFamily "OyunQaganTig")))
    .home (if ready?
            (shell/app-shell)
            (m/Scaffold
             .backgroundColor (m/Color 0xFF121212)
             .body (m/Center
                    .child (m/CircularProgressIndicator.
                            .color (m/Color 0xFFF5F5F5))))))))
