(ns notes-app.main
  (:require ["package:flutter/material.dart" :as m]
            ["package:flutter/foundation.dart" :as foundation :refer [kIsWeb]]
            ["package:flutter/services.dart" :as s]
            ["package:window_manager/window_manager.dart" :as wm]
            ["package:hotkey_manager/hotkey_manager.dart" :as hm]
            ["package:tray_manager/tray_manager.dart" :as tm]
            ["dart:io" :as io]
            [cljd.flutter :as f]
            [ime-core.remote-api :as remote]
            [notes-app.platform :as platform]
            [notes-app.bootstrap.desktop :as desktop-boot]
            [notes-app.bootstrap.mobile :as mobile-boot]
            [notes-app.db.core :as db]
            [notes-app.state.store :as store]
            [notes-app.lifecycle :as life]
            [notes-app.editor.view :as editor]
            [notes-app.desktop :as desktop]
            [notes-app.mobile :as mobile]
            [notes-app.services.sync :as sync]
            [notes-app.services.link :as link]
            [notes-app.nomio.auth :as nomio-auth]
            [notes-app.services.daily :as daily]))

(defonce ^:private !boot (atom {:status :loading}))

(defn- boot!
  "Init DB, prefs, link index, and today's daily doc."
  []
  (reset! !boot {:status :loading})
  (-> (db/initialize-database!)
      (.then (fn [_] (store/load-prefs!)))
      (.then (fn [_] (db/refresh-document-titles!)))
      ;; Local derived index — covers migration + text already on disk before first edit.
      (.then (fn [_] (link/reindex-all-links!)))
      (.then (fn [_] (db/refresh-tags!)))
      (.then (fn [_] (daily/ensure-today!)))
      (.then (fn [_]
               (life/register!)
               (sync/set-editor-hooks!
                editor/flush-open-sessions!
                editor/reload-open-sessions!)
               (sync/on-app-start!)
               (reset! !boot {:status :ready})))
      (.catchError (fn [e]
                     (dart:core/print (str "Startup failed: " e))
                     (reset! !boot {:status :error :message (str e)})))))

;; Close → hide to tray (do not kill the process).
(def ^:private window-listener
  (reify ^:mixin wm/WindowListener
    (onWindowClose [_]
      (.hide wm/windowManager)
      (store/close-quick-entry!))))

(def ^:private tray-listener
  (reify ^:mixin tm/TrayListener
    (onTrayIconMouseDown [_]
      (store/close-quick-entry!)
      (-> (.show wm/windowManager)
          (.then (fn [_] (.focus wm/windowManager))))
      nil)
    (onTrayIconRightMouseDown [_]
      (.popUpContextMenu tm/trayManager)
      nil)
    (onTrayMenuItemClick [_ item]
      (case (.-key item)
        "show"
        (do (store/close-quick-entry!)
            (-> (.show wm/windowManager)
                (.then (fn [_] (.focus wm/windowManager))))
            nil)
        "quit"
        (do (-> (.setPreventClose wm/windowManager false)
                (.then (fn [_] (.destroy wm/windowManager)))
                (.then (fn [_] (io/exit 0))))
            nil)
        nil))))

(defn- init-global-hotkey! []
  (let [hk (hm/HotKey
            .key s.PhysicalKeyboardKey/space
            .modifiers [hm.HotKeyModifier/alt])]
    (-> (.register hm/hotKeyManager hk
                   .keyDownHandler
                   (fn [_]
                     (-> (.isVisible wm/windowManager)
                         (.then (fn [visible?]
                                  (if visible?
                                    (if @store/!quick-entry-mode
                                      (do (.hide wm/windowManager)
                                          (store/close-quick-entry!))
                                      (do (store/open-quick-entry!)
                                          (.focus wm/windowManager)))
                                    (do (.show wm/windowManager)
                                        (.focus wm/windowManager)
                                        (store/open-quick-entry!))))))
                     ;; keyDownHandler is void — do not return the Future.
                     nil)))))

(defn- init-system-tray! []
  (let [icon-path (if (platform/windows?)
                    "assets/tray/icon.ico"
                    "assets/tray/icon.png")
        menu (tm/Menu
              .items [(tm/MenuItem .key "show" .label "Open Notes")
                      (tm/MenuItem .key "quit" .label "Quit")])]
    (.addListener tm/trayManager tray-listener)
    (-> (.setIcon tm/trayManager icon-path)
        (.then (fn [_] (.setContextMenu tm/trayManager menu)))
        (.catchError (fn [e]
                       (dart:core/print (str "tray init failed: " e)))))
    nil))

(defn- init-desktop-window! []
  (-> (.ensureInitialized wm/windowManager)
      (.then (fn [_]
               (let [opts (wm/WindowOptions
                           .size (m/Size 1200.0 800.0)
                           .center true
                           .skipTaskbar true
                           .backgroundColor m.Colors/transparent
                           .titleBarStyle wm.TitleBarStyle/hidden)]
                 (.addListener wm/windowManager window-listener)
                 (.setPreventClose wm/windowManager true)
                 (.waitUntilReadyToShow wm/windowManager opts
                                        (fn []
                                          (.show wm/windowManager)
                                          (.focus wm/windowManager)
                                          ;; waitUntilReadyToShow callback is void.
                                          nil)))))
      (.catchError (fn [e]
                     (dart:core/print (str "window_manager init failed: " e)))))
  nil)

(defn- init-desktop-lifecycle! []
  (init-desktop-window!)
  (-> (.unregisterAll hm/hotKeyManager)
      (.then (fn [_] (init-global-hotkey!)))
      (.catchError (fn [e]
                     (dart:core/print (str "hotkey init failed: " e)))))
  (init-system-tray!))

(defn main []
  (m/WidgetsFlutterBinding.ensureInitialized)
  ;; Subscribe before rendering so cold-start OAuth callbacks are not lost.
  (nomio-auth/initialize!)

  (when kIsWeb
    ;; Read compile-time --dart-define=API_BASE_URL="https://..." when present.
    (let [env-url (dart:core/String.fromEnvironment "API_BASE_URL")
          base-url (if (or (nil? env-url) (= env-url "")) "100.64.0.6:3003" env-url)]
      (remote/set-config! {:base-url base-url
                           :candidate-api-path "/api/next_word/candidates"
                           :next-word-api-path "/api/next_word/list"})))

  (if (platform/desktop?)
    (desktop-boot/init!)
    (mobile-boot/init!))

  (when (platform/native-desktop?)
    (init-desktop-lifecycle!))

  (boot!)

  (f/run
   :watch [boot-state !boot]
   (if (platform/desktop?)
     (desktop/app boot-state boot!)
     (mobile/app boot-state boot!))))
