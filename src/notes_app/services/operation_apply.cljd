(ns notes-app.services.operation-apply
  (:require ["dart:core" :as dc]
            ["dart:async" :as async]
            ["package:mgl_notes_app/database.dart" :as drift]
            ["package:drift/drift.dart" :as d]
            [notes-app.db.core :as db]
            [notes-app.services.operation :as op]
            [notes-app.services.link :as link]
            [notes-app.services.asset :as asset]
            [notes-app.services.title-conflict :as title-conflict]
            [notes-app.state.store :as store]))

(defn- parse-dt [v]
  (cond
    (nil? v) nil
    (dart/is? v dart:core/DateTime) v
    :else (try (dart:core/DateTime.parse (str v))
               (catch Exception e nil))))

(defn- payload-map [payload]
  (cond
    (map? payload) payload
    (string? payload) (or (db/decode-json payload) {})
    (dart/is? payload dart:core/Map)
    (reduce (fn [acc ^String k]
              (assoc acc (keyword k) (get payload k)))
            {}
            (.-keys payload))
    :else {}))

(defn- get-block [id]
  (if-let [^drift/AppDatabase database (db/get-database)]
    (-> (.get (doto (.select database (.-blocks database))
                (.where (fn [t] (.equals (.-id t) id)))
                (.limit 1)))
        (.then (fn [rows] (first rows))))
    (async/Future.value nil)))

(defn- get-doc [id]
  (if-let [^drift/AppDatabase database (db/get-database)]
    (-> (.get (doto (.select database (.-documents database))
                (.where (fn [t] (.equals (.-id t) id)))
                (.limit 1)))
        (.then (fn [rows] (first rows))))
    (async/Future.value nil)))

(defn- lww-ok?
  "Apply remote change if local entity is missing or remote created-at >= local updated-at."
  [local-updated-at remote-created-at]
  (let [remote (parse-dt remote-created-at)
        local local-updated-at]
    (cond
      (nil? local) true
      (nil? remote) true
      :else (not (.isAfter local remote)))))

(defn rename-local-doc-title!
  "Update a document title locally without emitting a sync operation.
   Returns a Future of `{:original-title :new-title}` when changed."
  [doc-id new-title]
  (if-let [^drift/AppDatabase database (db/get-database)]
    (-> (get-doc doc-id)
        (.then
         (fn [doc]
           (if-not doc
             nil
             (let [original (or (.-title doc) "")]
               (if (= original new-title)
                 nil
                 (let [now (db/now)
                       q (doto (.update database (.-documents database))
                           (.where (fn [t] (.equals (.-id t) doc-id))))]
                   (-> (.write q (drift/DocumentsCompanion.
                                  .title (d/Value ^String new-title)
                                  .updatedAt (d/Value ^dc/DateTime now)))
                       (.then (fn [_]
                                (db/refresh-document-titles!)
                                {:original-title original :new-title new-title}))))))))))
    (async/Future.value nil)))

(defn- rename-local-title-conflict! 
  "Remote doc wins the canonical title; rename any local duplicate first."
  [remote-title remote-id]
  (if (or (nil? remote-title) (= remote-title ""))
    (async/Future.value nil)
    (-> (db/find-document-by-title remote-title)
        (.then
         (fn [local]
           (when (and local (not= (.-id local) remote-id))
             (-> (db/list-active-documents)
                 (.then
                  (fn [docs]
                    (let [titles (mapv :title docs)
                          new-title (title-conflict/unique-conflict-copy-title
                                     remote-title
                                     (store/device-id)
                                     titles)]
                      (-> (rename-local-doc-title! (.-id local) new-title)
                          (.then
                           (fn [info]
                             (when info
                               (store/add-title-conflict-notice!
                                (:original-title info)
                                (:new-title info))))))))))))))))

(defn- apply-document-create! [entity-id p created-at]
  (if-let [^drift/AppDatabase database (db/get-database)]
    (-> (get-doc entity-id)
        (.then (fn [existing]
                 (if existing
                   nil
                   (let [title (or (:title p) "")]
                     (-> (rename-local-title-conflict! title entity-id)
                         (.then
                          (fn [_]
                            (let [now (or (parse-dt created-at) (db/now))
                                  companion (drift/DocumentsCompanion.insert
                                             :id entity-id
                                             :title (d/Value ^String title)
                                             :type (d/Value ^String (or (:type p) "normal"))
                                             :parentId (if (:parent_id p) (d/Value ^String (:parent_id p)) (d/Value nil))
                                             :icon (if (:icon p) (d/Value ^String (:icon p)) (d/Value nil))
                                             :cover (if (:cover p) (d/Value ^String (:cover p)) (d/Value nil))
                                             :createdAt (d/Value ^dc/DateTime now)
                                             :updatedAt (d/Value ^dc/DateTime now))]
                              (-> (.insert (.into database (.-documents database)) companion)
                                  (.then (fn [_] (db/refresh-document-titles!)))))))))))))
    (async/Future.value nil)))

(defn- apply-document-update! [entity-id p created-at]
  (if-let [^drift/AppDatabase database (db/get-database)]
    (-> (get-doc entity-id)
        (.then (fn [doc]
                 (when (and doc (lww-ok? (.-updatedAt doc) created-at))
                   (let [q (doto (.update database (.-documents database))
                             (.where (fn [t] (.equals (.-id t) entity-id))))
                         now (or (parse-dt created-at) (db/now))]
                     (-> (.write q
                                 (as-> (drift/DocumentsCompanion.
                                        .updatedAt (d/Value ^dc/DateTime now)) c
                                   (if (contains? p :title)
                                     (.copyWith c .title (d/Value ^String (or (:title p) "")))
                                     c)
                                   (if (contains? p :icon)
                                     (.copyWith c .icon (if-let [v (:icon p)]
                                                          (d/Value ^String v)
                                                          (d/Value nil)))
                                     c)
                                   (if (contains? p :cover)
                                     (.copyWith c .cover (if-let [v (:cover p)]
                                                           (d/Value ^String v)
                                                           (d/Value nil)))
                                     c)))
                         (.then (fn [_]
                                  (when (contains? p :title)
                                    (db/refresh-document-titles!))))))))))
    (async/Future.value nil)))

(defn- apply-document-delete! [entity-id created-at]
  (if-let [^drift/AppDatabase database (db/get-database)]
    (-> (get-doc entity-id)
        (.then (fn [doc]
                 (when (and doc (lww-ok? (.-updatedAt doc) created-at))
                   (let [now (or (parse-dt created-at) (db/now))
                         q (doto (.update database (.-documents database))
                             (.where (fn [t] (.equals (.-id t) entity-id))))]
                     (-> (.write q (drift/DocumentsCompanion.
                                    .deletedAt (d/Value ^dc/DateTime now)
                                    .updatedAt (d/Value ^dc/DateTime now)))
                         (.then (fn [_] (db/refresh-document-titles!)))))))))
    (async/Future.value nil)))

(defn- apply-document-move! [entity-id p created-at]
  (if-let [^drift/AppDatabase database (db/get-database)]
    (-> (get-doc entity-id)
        (.then (fn [doc]
                 (when (and doc (lww-ok? (.-updatedAt doc) created-at))
                   (let [now (or (parse-dt created-at) (db/now))
                         parent-id (:parent_id p)
                         q (doto (.update database (.-documents database))
                             (.where (fn [t] (.equals (.-id t) entity-id))))]
                     (.write q (drift/DocumentsCompanion.
                                .parentId (if parent-id
                                            (d/Value ^String parent-id)
                                            (d/Value nil))
                                .updatedAt (d/Value ^dc/DateTime now))))))))
    (async/Future.value nil)))

(defn- apply-block-create! [entity-id p created-at]
  (if-let [^drift/AppDatabase database (db/get-database)]
    (-> (get-block entity-id)
        (.then (fn [existing]
                 (if existing
                   nil
                   (let [now (or (parse-dt created-at) (db/now))
                         companion (drift/BlocksCompanion.insert
                                    :id entity-id
                                    :documentId (or (:document_id p) "")
                                    :parentId (if (:parent_id p) (d/Value ^String (:parent_id p)) (d/Value nil))
                                    :type (or (:type p) "paragraph")
                                    :textContent (d/Value ^String (or (:text p) ""))
                                    :checked (d/Value ^bool (boolean (:checked p false)))
                                    :dataJson (if (:data_json p) (d/Value ^String (:data_json p)) (d/Value nil))
                                    :orderIndex (double (or (:order_index p) 1000.0))
                                    :createdAt (d/Value ^dc/DateTime now)
                                    :updatedAt (d/Value ^dc/DateTime now))]
                     (-> (.insert (.into database (.-blocks database)) companion)
                         (.then (fn [_]
                                  (link/rebuild-links-for-block!
                                   entity-id (or (:text p) ""))))))))))
    (async/Future.value nil)))

(defn- apply-block-update! [entity-id p created-at]
  (if-let [^drift/AppDatabase database (db/get-database)]
    (-> (get-block entity-id)
        (.then (fn [blk]
                 (when (and blk (lww-ok? (.-updatedAt blk) created-at))
                   (let [now (or (parse-dt created-at) (db/now))
                         q (doto (.update database (.-blocks database))
                             (.where (fn [t] (.equals (.-id t) entity-id))))]
                     (-> (.write q
                                 (as-> (drift/BlocksCompanion.
                                        .updatedAt (d/Value ^dc/DateTime now)) c
                                   (if (contains? p :text)
                                     (.copyWith c .textContent (d/Value ^String (or (:text p) "")))
                                     c)
                                   (if (contains? p :type)
                                     (.copyWith c .type (d/Value ^String (or (:type p) "paragraph")))
                                     c)
                                   (if (contains? p :data_json)
                                     (.copyWith c .dataJson (if-let [v (:data_json p)]
                                                              (d/Value ^String v)
                                                              (d/Value nil)))
                                     c)))
                         (.then (fn [_]
                                  ;; Rebuild from DB so partial payloads still work.
                                  (when (contains? p :text)
                                    (link/sync-links-from-db-block! entity-id))))))))))
    (async/Future.value nil)))

(defn- apply-block-check! [entity-id p created-at]
  (if-let [^drift/AppDatabase database (db/get-database)]
    (-> (get-block entity-id)
        (.then (fn [blk]
                 (when (and blk (lww-ok? (.-updatedAt blk) created-at))
                   (let [now (or (parse-dt created-at) (db/now))
                         q (doto (.update database (.-blocks database))
                             (.where (fn [t] (.equals (.-id t) entity-id))))]
                     (.write q (drift/BlocksCompanion.
                                .checked (d/Value ^bool (boolean (:checked p)))
                                .updatedAt (d/Value ^dc/DateTime now))))))))
    (async/Future.value nil)))

(defn- apply-block-move! [entity-id p created-at]
  (if-let [^drift/AppDatabase database (db/get-database)]
    (-> (get-block entity-id)
        (.then (fn [blk]
                 (when (and blk (lww-ok? (.-updatedAt blk) created-at))
                   (let [now (or (parse-dt created-at) (db/now))
                         parent-id (:parent_id p)
                         q (doto (.update database (.-blocks database))
                             (.where (fn [t] (.equals (.-id t) entity-id))))]
                     (.write q (drift/BlocksCompanion.
                                .parentId (if parent-id
                                            (d/Value ^String parent-id)
                                            (d/Value nil))
                                .orderIndex (d/Value ^double (double (or (:order_index p) 0.0)))
                                .updatedAt (d/Value ^dc/DateTime now))))))))
    (async/Future.value nil)))

(defn- apply-block-delete! [entity-id created-at]
  (if-let [^drift/AppDatabase database (db/get-database)]
    (-> (get-block entity-id)
        (.then (fn [blk]
                 (when (and blk (lww-ok? (.-updatedAt blk) created-at))
                   (let [now (or (parse-dt created-at) (db/now))
                         q (doto (.update database (.-blocks database))
                             (.where (fn [t] (.equals (.-id t) entity-id))))]
                     (-> (.write q (drift/BlocksCompanion.
                                    .deletedAt (d/Value ^dc/DateTime now)
                                    .updatedAt (d/Value ^dc/DateTime now)))
                         (.then (fn [_] (link/clear-links-for-block! entity-id)))))))))
    (async/Future.value nil)))

(defn- apply-asset-create! [entity-id p created-at]
  (asset/insert-remote-metadata!
   {:id entity-id
    :filename (:filename p)
    :mime-type (or (:mime_type p) (:mime-type p))
    :size-bytes (or (:size_bytes p) (:size-bytes p))
    :sha256 (:sha256 p)
    :created-at created-at}))

(defn- apply-asset-delete! [entity-id created-at]
  (if-let [^drift/AppDatabase database (db/get-database)]
    (let [now (or (parse-dt created-at) (db/now))
          q (doto (.update database (.-assets database))
              (.where (fn [t] (.equals (.-id t) entity-id))))]
      (.write q (drift/AssetsCompanion.
                 .deletedAt (d/Value ^dc/DateTime now)
                 .uploadStatus (d/Value "deleted"))))
    (async/Future.value nil)))

(defn- apply-document-restore! [entity-id created-at]
  (if-let [^drift/AppDatabase database (db/get-database)]
    (-> (get-doc entity-id)
        (.then (fn [doc]
                 (when (and doc (lww-ok? (.-updatedAt doc) created-at))
                   (let [now (or (parse-dt created-at) (db/now))
                         q (doto (.update database (.-documents database))
                             (.where (fn [t] (.equals (.-id t) entity-id))))]
                     (-> (.write q (drift/DocumentsCompanion.
                                    .deletedAt (d/Value nil)
                                    .updatedAt (d/Value ^dc/DateTime now)))
                         (.then (fn [_] (db/refresh-document-titles!)))))))))
    (async/Future.value nil)))

(defn- apply-document-destroy! [entity-id]
  (if-let [^drift/AppDatabase database (db/get-database)]
    (let [q (doto (.delete database (.-documents database))
              (.where (fn [t] (.equals (.-id t) entity-id))))]
      (.go q))
    (async/Future.value nil)))

(defn- dispatch-apply! [action eid p created-at]
  (case action
    "document_create" (apply-document-create! eid p created-at)
    "document_update" (apply-document-update! eid p created-at)
    "document_delete" (apply-document-delete! eid created-at)
    "document_restore" (apply-document-restore! eid created-at)
    "document_destroy" (apply-document-destroy! eid)
    "document_move" (apply-document-move! eid p created-at)
    "block_create" (apply-block-create! eid p created-at)
    "block_update" (apply-block-update! eid p created-at)
    "block_check" (apply-block-check! eid p created-at)
    "block_move" (apply-block-move! eid p created-at)
    "block_delete" (apply-block-delete! eid created-at)
    "asset_create" (apply-asset-create! eid p created-at)
    "asset_delete" (apply-asset-delete! eid created-at)
    (do
      (dart:core/print (str "Unknown action: " action))
      (async/Future.value nil))))

(defn apply-push-title-renames!
  "Apply server-side title renames after a successful push."
  [renames]
  (let [items (or renames [])]
    (if (empty? items)
      (async/Future.value nil)
      (reduce
       (fn [fut item]
         (.then fut
                (fn [_]
                  (let [m (if (map? item)
                            item
                            (reduce (fn [acc ^String k]
                                      (assoc acc (keyword k) (get item k)))
                                    {}
                                    (.-keys item)))
                        entity-id (or (:entity_id m) (:entity-id m))
                        new-title (or (:new_title m) (:new-title m))]
                    (when (and entity-id new-title)
                      (-> (rename-local-doc-title! entity-id new-title)
                          (.then
                           (fn [info]
                             (when info
                               (store/add-title-conflict-notice!
                                (:original-title info)
                                (:new-title info)))))))))))
       (async/Future.value nil)
       items))))

(defn apply-operation!
  "Idempotently apply one remote Operation. Skips ops from this device and already-seen ids."
  [{:keys [id device-id entity-type entity-id action payload created-at] :as op-map}]
  (if-not (and id action)
    (async/Future.value nil)
    (if (= device-id (store/device-id))
      (-> (op/insert-remote-op! op-map)
          (.then (fn [_] :skipped-own)))
      (-> (op/exists? id)
          (.then (fn [ex?]
                   (if ex?
                     :already-applied
                     (let [p (payload-map payload)
                           eid (or entity-id (:id p) (:entity_id p))]
                       (if-not eid
                         (do
                           (dart:core/print (str "Skip op without entity-id: " id " " action))
                           (op/insert-remote-op! op-map))
                         (-> (dispatch-apply! action eid p created-at)
                             (.then (fn [_]
                                      (op/insert-remote-op! (assoc op-map :entity-id eid))))
                             (.then (fn [_] :applied))))))))))))
