(ns notes-app.services.export
  "Export documents to HTML files via block-editor.utils.html."
  (:require ["dart:async" :as async]
            ["dart:io" :as io]
            ["package:path/path.dart" :as path]
            ["package:path_provider/path_provider.dart" :as pathp]
            ["package:flutter/material.dart" :as m]
            ["package:flutter/services.dart" :refer [rootBundle]]
            [clojure.string :as str]
            [block-editor.utils.html :as html]
            [notes-app.db.core :as db]
            [notes-app.editor.bridge :as bridge]
            [notes-app.platform :as platform]))

(def ^:private export-font-asset "assets/fonts/OyunQaganTig.ttf")
(def ^:private export-font-filename "OyunQaganTig.ttf")

(defn- escape-html [s]
  (-> (or s "")
      (str/replace "&" "&amp;")
      (str/replace "<" "&lt;")
      (str/replace ">" "&gt;")
      (str/replace "\"" "&quot;")))

(defn- safe-filename [title]
  (let [base (if (str/blank? title) "untitled" (str/trim title))
        cleaned (-> base
                    (str/replace #"\\" "_")
                    (str/replace #"/" "_")
                    (str/replace #":" "_")
                    (str/replace #"\*" "_")
                    (str/replace #"\?" "_")
                    (str/replace #"\"" "_")
                    (str/replace #"<" "_")
                    (str/replace #">" "_")
                    (str/replace #"\|" "_")
                    (str/replace #"[\n\r\t]" "_")
                    (str/replace #" +" " ")
                    (str/trim))]
    (str (if (str/blank? cleaned) "untitled" cleaned) ".html")))

(defn- export-document-css
  "CSS for standalone exported HTML (vertical Mongol + bundled font)."
  []
  (str "@font-face {\n"
       "  font-family: \"OyunQaganTig\";\n"
       "  src: url(\"./" export-font-filename "\") format(\"truetype\");\n"
       "  font-display: swap;\n"
       "}\n"
       "  *, *::before, *::after { box-sizing: border-box; }\n"
       "  html { min-height: 100%; }\n"
       "  body {\n"
       "    font-family: \"OyunQaganTig\", serif;\n"
       "    writing-mode: vertical-lr;\n"
       "    text-orientation: mixed;\n"
       "    min-height: 100vh;\n"
       "    margin: 0;\n"
       "    padding: 2rem 1.25rem;\n"
       "    line-height: 1.8;\n"
       "    color: #1a1a1a;\n"
       "    background: #fff;\n"
       "  }\n"
       "  .doc-title { font-size: 1.75rem; margin-bottom: 1.5rem; font-weight: bold; }\n"
       "  .children { margin-top: 1.25rem; }\n"
       "  .task { display: flex; gap: 0.5rem; align-items: flex-start; }\n"
       "  .callout {\n"
       "    border-top: 3px solid #888;\n"
       "    padding: 0.75rem 0.5rem;\n"
       "    background: #f5f5f5;\n"
       "    margin: 0.75rem 0;\n"
       "  }\n"
       "  .bookmark {\n"
       "    display: block;\n"
       "    padding: 0.75rem;\n"
       "    border: 1px solid #ddd;\n"
       "    border-radius: 6px;\n"
       "    text-decoration: none;\n"
       "    color: inherit;\n"
       "    margin: 0.75rem 0;\n"
       "  }\n"
       "  .bookmark-desc { display: block; color: #666; font-size: 0.9em; margin-top: 0.25rem; }\n"
       "  pre {\n"
       "    background: #f4f4f4;\n"
       "    padding: 0.75rem;\n"
       "    overflow-y: auto;\n"
       "    border-radius: 4px;\n"
       "    writing-mode: horizontal-tb;\n"
       "  }\n"
       "  blockquote {\n"
       "    border-top: 3px solid #ccc;\n"
       "    margin: 0.75rem 0;\n"
       "    padding-top: 1rem;\n"
       "    color: #555;\n"
       "  }\n"
       "  hr {\n"
       "    border: none;\n"
       "    border-left: 1px solid #ddd;\n"
       "    width: 0;\n"
       "    height: 1.5rem;\n"
       "    margin: 0 1.5rem;\n"
       "  }\n"
       "  a { color: #1565c0; }\n"))

(defn wrap-html-document
  "Wrap an HTML fragment into a full standalone HTML document."
  [title fragment]
  (let [safe-title (escape-html (if (str/blank? title) "Untitled" title))]
    (str "<!DOCTYPE html>\n"
         "<html lang=\"mn\">\n"
         "<head>\n"
         "<meta charset=\"utf-8\">\n"
         "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
         "<title>" safe-title "</title>\n"
         "<style>\n"
         (export-document-css)
         "</style>\n"
         "</head>\n"
         "<body>\n"
         "<h1 class=\"doc-title\">" safe-title "</h1>\n"
         (or fragment "")
         "\n</body>\n"
         "</html>\n")))

(defn- normalize-state-for-export
  "Prepare editor state for html/export-to-html (embed → block-ref paragraph)."
  [state]
  (update state :blocks
          (fn [blocks]
            (reduce-kv
             (fn [acc id b]
               (assoc acc id
                      (if (= (:type b) :embed)
                        (-> b
                            (assoc :type :paragraph
                                   :content (str "((" (or (get-in b [:data :target-id]) "") "))"))
                            (dissoc :data))
                        b)))
             {}
             (or blocks {})))))

(defn state->html-string
  "Convert editor state to a full HTML document string."
  ([state] (state->html-string state "" nil))
  ([state title] (state->html-string state title nil))
  ([state title opts]
   (wrap-html-document title
                       (html/export-to-html (normalize-state-for-export state) opts))))

(defn- resolve-export-dir!
  "Prefer Downloads; fall back to app documents."
  []
  (-> (pathp/getDownloadsDirectory)
      (.then (fn [dir]
               (if dir
                 (async/Future.value dir)
                 (pathp/getApplicationDocumentsDirectory))))
      (.catchError (fn [_]
                     (pathp/getApplicationDocumentsDirectory)))))

(defn- copy-export-font!
  "Copy bundled OyunQaganTig.ttf next to the exported HTML file."
  [dir-path]
  (-> (.load rootBundle export-font-asset)
      (.then (fn [byte-data]
               (let [bytes (.asUint8List (.-buffer byte-data))
                     dest (path/join dir-path export-font-filename)]
                 (.writeAsBytes (io/File dest) bytes))))
      (.catchError (fn [e]
                     (dart:core/print (str "Font copy skipped: " e))
                     nil))))

(defn write-html-file!
  "Write HTML string to a file. Returns Future of absolute path, or nil on web."
  [html-str title]
  (if (platform/web?)
    (do
      (dart:core/print "HTML export is not supported on web")
      (async/Future.value nil))
    (-> (resolve-export-dir!)
        (.then (fn [dir]
                 (let [dir-path (.-path dir)
                       name (safe-filename title)
                       filepath (path/join dir-path name)
                       file (io/File filepath)]
                   (-> (.writeAsString file (or html-str ""))
                       (.then (fn [_] (copy-export-font! dir-path)))
                       (.then (fn [_] filepath)))))))))

(defn export-state-to-file!
  "Export live editor state to an HTML file. Returns Future of path."
  ([state title] (export-state-to-file! state title nil))
  ([state title opts]
   (write-html-file! (state->html-string state title opts) title)))

(defn export-document-to-file!
  "Load document from DB and export as HTML file. Returns Future of path."
  ([document-id] (export-document-to-file! document-id nil))
  ([document-id opts]
   (-> (db/get-document document-id)
       (.then
        (fn [doc]
          (-> (db/get-blocks document-id)
              (.then
               (fn [rows]
                 (let [title (if doc (or (.-title doc) "") "")
                       state (bridge/rows->editor-state (or rows []))]
                   (export-state-to-file! state title opts)))))))
       (.catchError
        (fn [e]
          (dart:core/print (str "export-document-to-file! failed: " e))
          nil)))))

(defn show-export-result!
  "Show a SnackBar with the export path (or error)."
  [ctx path]
  (when ctx
    (let [messenger (m/ScaffoldMessenger.of ctx)
          msg (if path
                (str "Exported: " path)
                "Export failed")]
      (.showSnackBar
       messenger
       (m/SnackBar
        .content (m/Text msg .style (m/TextStyle .fontFamily "OyunQaganTig"))
        .duration (dart:core/Duration .seconds 4))))))
