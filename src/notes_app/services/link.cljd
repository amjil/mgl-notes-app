(ns notes-app.services.link
  "Bidirectional wiki-links and #tags.

   Design: `block_links` is a **local derived index** — never synced as ops.
   Source of truth is block text (`[[Title]]` / `#tag`). Rebuild after:
   - local editor persist
   - remote pull apply (block_create / block_update / block_delete)
   - soft-delete

   Creating a doc via link-tap emits normal document_create (synced)."
  (:require ["dart:async" :as async]
            ["dart:core" :as dc]
            ["package:mgl_notes_app/database.dart" :as drift]
            ["package:drift/drift.dart" :as d]
            [clojure.string :as str]
            [block-editor.utils.inline :as inline]
            [notes-app.db.core :as db]
            [notes-app.services.document :as doc]
            [notes-app.services.operation :as op]
            [notes-app.state.store :as store]))

(defn clear-links-for-block!
  "Remove all outbound links for a source block."
  [block-id]
  (if-let [^drift/AppDatabase database (db/get-database)]
    (let [q (doto (.delete database (.-blockLinks database))
              (.where (fn [t] (.equals (.-sourceId t) block-id))))]
      (.go q))
    (async/Future.value nil)))

(defn- wiki-targets-from-text
  "Titles from `[[Title]]` only (excludes #tags)."
  [text]
  (->> (inline/parse-text-spans (or text ""))
       (filter #(= (:type %) :link))
       (map (comp str/trim :content))
       (remove str/blank?)
       distinct
       vec))

(defn- tag-targets-from-text
  "Titles from `#tag` (ignore adjacent punctuation)."
  [text]
  (->> (re-seq #"(?:^|\s)#([^\s#,.\?!:;\"\'\]\[]+)" (or text ""))
       (map (comp str/trim second))
       (remove str/blank?)
       distinct
       vec))

(defn rebuild-links-for-block!
  "Parse wiki and #tag refs from text and replace block_links for this block.
   `link_type` is `wiki` or `tag` (tag wins when both forms name the same title)."
  [block-id text]
  (if-let [^drift/AppDatabase database (db/get-database)]
    (let [text-val (or text "")
          wiki-targets (wiki-targets-from-text text-val)
          tag-targets (tag-targets-from-text text-val)
          ;; PK is (source_id, target_id) — one row per target; tag preferred.
          by-target (merge (zipmap wiki-targets (repeat "wiki"))
                           (zipmap tag-targets (repeat "tag")))]
      (-> (clear-links-for-block! block-id)
          (.then (fn [_]
                   (if (empty? by-target)
                     nil
                     ;; InsertStatement has no insertAll — use batch instead.
                     (.batch database
                             (fn [b]
                               (doseq [[^String target ^String link-type] by-target]
                                 (.insert b
                                          (.-blockLinks database)
                                          (drift/BlockLinksCompanion.insert
                                           :sourceId block-id
                                           :targetId target
                                           :linkType (d/Value ^String link-type)))))))))))
    (async/Future.value nil)))

(defn sync-links-from-db-block!
  "Re-read block from DB and rebuild or clear its link index (after pull apply)."
  [block-id]
  (-> (db/get-block block-id)
      (.then (fn [blk]
               (cond
                 (nil? blk) (clear-links-for-block! block-id)
                 (.-deletedAt blk) (clear-links-for-block! block-id)
                 :else (rebuild-links-for-block! block-id
                                                 (or (.-textContent blk) "")))))))

(defn rebuild-links-for-rows!
  "Rebuild link index for a seq of {:id :text} rows (after local persist)."
  [rows]
  (reduce (fn [fut row]
            (.then fut
                   (fn [_]
                     (rebuild-links-for-block! (:id row) (:text row)))))
          (async/Future.value nil)
          rows))

(defn clear-links-for-ids!
  [ids]
  (reduce (fn [fut id]
            (.then fut (fn [_] (clear-links-for-block! id))))
          (async/Future.value nil)
          ids))

(defn reindex-all-links!
  "Full rebuild of block_links from all active block texts.
   Run once after DB init / schema upgrade so pull'd history is indexed."
  []
  (-> (db/all-active-blocks-for-reindex)
      (.then (fn [rows]
               (rebuild-links-for-rows! (or rows []))))
      (.catchError (fn [e]
                     (dart:core/print (str "reindex-all-links! failed: " e))
                     nil))))

(defn open-or-create-by-title!
  "Resolve `[[Title]]` / `#tag`: open existing doc or create then open."
  [title]
  (let [title (str/trim (or title ""))]
    (when-not (str/blank? title)
      (-> (db/find-document-by-title title)
          (.then (fn [found]
                   (if found
                     (do (store/open-document! (.-id found))
                         (.-id found))
                     (-> (doc/create! {:title title :type "normal"})
                         (.then (fn [doc-id]
                                  (db/refresh-document-titles!)
                                  (store/open-document! doc-id)
                                  doc-id))))))))))

(defn open-block-ref!
  "Navigate to the document that owns block-id and reveal that block."
  [block-id]
  (-> (db/get-block block-id)
      (.then (fn [blk]
               (when (and blk (nil? (.-deletedAt blk)))
                 (store/open-document! (.-documentId blk) block-id))))))

(defn handle-link-tap!
  "Editor `:on-link-tap` handler. Accepts title string or `{:type :block :id uuid}`."
  [target]
  (cond
    (and (map? target) (= (:type target) :block) (:id target))
    (open-block-ref! (:id target))

    (string? target)
    ;; If the target is a #tag, strip the leading # into a page title
    (let [clean-target (if (str/starts-with? target "#")
                         (subs target 1)
                         target)]
      (open-or-create-by-title! clean-target))

    :else nil))

(defn link-suggestions
  "Filter document titles for `[[` autocomplete (sync; uses title cache)."
  [query]
  (let [q (str/lower-case (or query ""))
        titles (or (db/cached-document-titles) [])]
    (->> titles
         (filter (fn [t]
                   (and (not (str/blank? t))
                        (or (str/blank? q)
                            (str/includes? (str/lower-case t) q)))))
         (take 20)
         vec)))

(defn promote-unlinked-to-link!
  "Wrap bare title mention with `[[title]]`, emit block_update for sync, rebuild index.
   Returns Future of affected document-id (or nil).
   Accepts either `:block-text` (backlinks row) or `:text`."
  [{:keys [block-id block-text text document-id]} title]
  (if-not (and block-id title (not (str/blank? title)))
    (async/Future.value nil)
    (let [^String old (or block-text text "")
          ^String new-text (.replaceFirst old title (str "[[" title "]]"))]
      (if (= old new-text)
        (async/Future.value nil)
        (if-let [^drift/AppDatabase database (db/get-database)]
          (let [now (db/now)
                q (doto (.update database (.-blocks database))
                    (.where (fn [t] (.equals (.-id t) block-id))))]
            (-> (.write q (drift/BlocksCompanion.
                           .textContent (d/Value ^String new-text)
                           .updatedAt (d/Value ^dc/DateTime now)))
                (.then (fn [_]
                         (op/append!
                          {:entity-type "block"
                           :entity-id block-id
                           :action "block_update"
                           :payload {:text new-text}})))
                (.then (fn [_] (rebuild-links-for-block! block-id new-text)))
                (.then (fn [_] document-id))))
          (async/Future.value nil))))))

;; =============================================================================
;; Derived-index watches and queries (moved from db.core)
;; =============================================================================

(defn- row->backlink [row]
  (let [data (.-data row)]
    {:block-id (get data "block_id")
     :block-text (get data "block_text")
     :document-id (get data "document_id")
     :document-title (get data "document_title")}))

(defn watch-unlinked-references
  "Blocks whose text mentions `title` but have no block_links row to it.
   Excludes the current page (same document-id or same document title)."
  [title document-id]
  (if (or (nil? title) (< (count title) 2) (nil? document-id) (= document-id ""))
    (async/Stream.empty)
    (if-let [^drift/AppDatabase database (db/get-database)]
      (let [pattern (str "%" title "%")
            wiki (str "%[[" title "]]%")
            tag (str "%#" title "%")]
        (.map
         (.watch
          (.customSelect
           database
           (str "SELECT b.id AS block_id, b.text AS block_text, "
                "d.id AS document_id, d.title AS document_title "
                "FROM blocks b "
                "INNER JOIN documents d ON d.id = b.document_id "
                "WHERE b.deleted_at IS NULL AND d.deleted_at IS NULL "
                "AND b.text LIKE ? "
                "AND b.text NOT LIKE ? "
                "AND b.text NOT LIKE ? " 
                "AND b.id NOT IN (SELECT source_id FROM block_links WHERE target_id = ?) "
                "AND d.id != ? "
                "AND d.title != ? "
                "ORDER BY b.updated_at DESC "
                "LIMIT 50")
           .variables [(d/Variable. pattern)
                       (d/Variable. wiki)
                       (d/Variable. tag)
                       (d/Variable. title)
                       (d/Variable. document-id)
                       (d/Variable. title)]
           .readsFrom #{(.-blocks database)
                        (.-documents database)
                        (.-blockLinks database)}))
         (fn [rows]
           (->> rows
                (mapv row->backlink)
                (filterv (fn [item]
                           (and (not= (:document-id item) document-id)
                                (not= (:document-title item) title))))))))
      (async/Stream.empty))))

(defn watch-backlinks
  "Blocks that link to `title` via block_links. Excludes soft-deleted sources."
  [title]
  (if (or (nil? title) (= title ""))
    (async/Stream.empty)
    (if-let [^drift/AppDatabase database (db/get-database)]
      (.map
       (.watch
        (.customSelect
         database
         (str "SELECT b.id AS block_id, b.text AS block_text, "
              "d.id AS document_id, d.title AS document_title "
              "FROM block_links bl "
              "INNER JOIN blocks b ON b.id = bl.source_id "
              "INNER JOIN documents d ON d.id = b.document_id "
              "WHERE bl.target_id = ? "
              "AND b.deleted_at IS NULL AND d.deleted_at IS NULL "
              "ORDER BY b.updated_at DESC")
         .variables [(d/Variable. title)]
         .readsFrom #{(.-blockLinks database)
                      (.-blocks database)
                      (.-documents database)}))
       (fn [rows] (mapv row->backlink rows)))
      (async/Stream.empty))))

(defn- row->tag-summary [row]
  (let [data (.-data row)]
    {:tag (get data "tag")
     :ref-count (or (get data "ref_count") 0)
     :doc-count (or (get data "doc_count") 0)}))

(defn watch-paged-tags
  "Paged `#tag` index with optional case-insensitive substring filter.
   Ordered by ref count desc. Live via Drift watch."
  [query limit]
  (if-let [^drift/AppDatabase database (db/get-database)]
    (let [q (str/trim (or query ""))
          lim (max 1 (int (or limit 50)))
          filter? (not (str/blank? q))
          pattern (when filter? (str "%" q "%"))
          sql (str "SELECT bl.target_id AS tag, "
                   "COUNT(*) AS ref_count, "
                   "COUNT(DISTINCT b.document_id) AS doc_count "
                   "FROM block_links bl "
                   "INNER JOIN blocks b ON b.id = bl.source_id "
                   "INNER JOIN documents d ON d.id = b.document_id "
                   "WHERE bl.link_type = 'tag' "
                   "AND b.deleted_at IS NULL AND d.deleted_at IS NULL "
                   (when filter? "AND bl.target_id LIKE ? COLLATE NOCASE ")
                   "GROUP BY bl.target_id "
                   "ORDER BY ref_count DESC, tag COLLATE NOCASE "
                   "LIMIT ?")
          vars (cond-> []
                 filter? (conj (d/Variable. pattern))
                 :always (conj (d/Variable. lim)))]
      (.map
       (.watch
        (.customSelect
         database sql
         .variables vars
         .readsFrom #{(.-blockLinks database)
                      (.-blocks database)
                      (.-documents database)}))
       (fn [rows] (mapv row->tag-summary rows))))
    (async/Stream.empty)))

(defn watch-all-tags
  "All `#tag` targets (unbounded). Prefer `watch-paged-tags` for UI lists."
  []
  (watch-paged-tags "" 10000))

(defn watch-tag-references
  "Blocks that mention `#tag` (link_type=tag). Optional `limit` (default 50)."
  ([tag]
   (watch-tag-references tag 50))
  ([tag limit]
   (if (or (nil? tag) (= tag ""))
     (async/Stream.empty)
     (if-let [^drift/AppDatabase database (db/get-database)]
       (let [lim (max 1 (int (or limit 50)))]
         (.map
          (.watch
           (.customSelect
            database
            (str "SELECT b.id AS block_id, b.text AS block_text, "
                 "d.id AS document_id, d.title AS document_title "
                 "FROM block_links bl "
                 "INNER JOIN blocks b ON b.id = bl.source_id "
                 "INNER JOIN documents d ON d.id = b.document_id "
                 "WHERE bl.target_id = ? AND bl.link_type = 'tag' "
                 "AND b.deleted_at IS NULL AND d.deleted_at IS NULL "
                 "ORDER BY b.updated_at DESC "
                 "LIMIT ?")
            .variables [(d/Variable. tag) (d/Variable. lim)]
            .readsFrom #{(.-blockLinks database)
                         (.-blocks database)
                         (.-documents database)}))
          (fn [rows] (mapv row->backlink rows))))
       (async/Stream.empty)))))
