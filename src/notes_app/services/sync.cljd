(ns notes-app.services.sync
  (:require ["package:http/http.dart" :as http]
            ["dart:convert" :as convert]
            ["dart:async" :as async]
            [notes-app.db.core :as db]
            [notes-app.state.store :as store]
            [notes-app.services.operation :as op]
            [notes-app.services.operation-apply :as apply]
            [notes-app.services.asset :as asset]
            [notes-app.services.asset-sync :as asset-sync]
            [notes-app.services.title-conflict :as title-conflict]))

(defonce ^:private !push-timer (atom nil))
(defonce ^:private !pull-timer (atom nil))
(defonce ^:private !sync-busy (atom false))
(defonce ^:private !sync-pending (atom nil))
(defonce ^:private !before-pull (atom nil))
(defonce ^:private !after-remote-apply (atom nil))
(def ^:private pull-page-size 200)

(defn set-editor-hooks!
  "Optional fns that return a Future.
   `before` — persist open editors so pull LWW does not get overwritten.
   `after` — reload open editors after remote ops were applied."
  [before after]
  (reset! !before-pull before)
  (reset! !after-remote-apply after))

(defn- call-hook [hook]
  (-> (if-let [f @hook]
        (f)
        (async/Future.value nil))
      (.catchError (fn [e]
                     (dart:core/print (str "editor sync hook failed: " e))
                     nil))))

(defn- flush-conflict-toast! []
  (when-let [msg (title-conflict/format-toast (store/take-pending-title-conflicts!))]
    (store/emit-sync-toast! msg)))

(defn- base-url []
  (let [u (:sync-base-url @store/app-ui-state)]
    (when (and u (not= u ""))
      (.replaceFirst u (dart:core/RegExp. "/+$") ""))))

(defn- operation->wire [row]
  {:id (.-id row)
   :device_id (.-deviceId row)
   :entity_type (.-entityType row)
   :entity_id (.-entityId row)
   :action (.-action row)
   :payload (or (db/decode-json (.-payload row)) {})
   :created_at (.toIso8601String (.-createdAt row))})

(defn- wire->op-map [item]
  (let [m (if (map? item)
            item
            (reduce (fn [acc ^String k]
                      (assoc acc (keyword k) (get item k)))
                    {}
                    (.-keys item)))]
    {:id (or (:id m) (get m "id"))
     :device-id (or (:device_id m) (:device-id m) (get m "device_id"))
     :entity-type (or (:entity_type m) (get m "entity_type"))
     :entity-id (or (:entity_id m) (get m "entity_id"))
     :action (or (:action m) (get m "action"))
     :payload (or (:payload m) (get m "payload") {})
     :created-at (or (:created_at m) (get m "created_at"))
     :received-at (or (:received_at m) (:received-at m) (get m "received_at"))}))

(defn- op-cursor-time
  "Pull cursor: server receive time, falling back to created_at."
  [item]
  (let [m (wire->op-map item)]
    (or (:received-at m) (:created-at m))))

(defn- op-cursor-id [item]
  (let [m (wire->op-map item)]
    (or (:id m) "")))

(defn- last-item-cursor [items]
  (let [xs (vec (or items []))]
    (when (seq xs)
      (let [it (peek xs)]
        {:since (op-cursor-time it)
         :since-id (op-cursor-id it)}))))

(defn- apply-remote-ops! [items]
  (reduce (fn [fut item]
            (.then fut
                   (fn [_]
                     (apply/apply-operation! (wire->op-map item)))))
          (async/Future.value nil)
          (or items [])))

(defn- parse-pull-items [body]
  (let [decoded (convert/jsonDecode body)]
    (or (cond
          (dart/is? decoded dart:core/List) decoded
          (and (dart/is? decoded dart:core/Map)
               (contains? (into {} (map (fn [k] [(keyword k) (get decoded k)])
                                        (.-keys decoded)))
                           :operations))
          (get decoded "operations")
          :else [])
        [])))

(defn- require-auth!
  "Return true if logged in; otherwise set sync error and return false."
  []
  (if (store/logged-in?)
    true
    (do
      (store/set-sync-status! :error "Please log in to sync")
      false)))

(defn- truncate-str [s max-len]
  (let [s (str (or s ""))]
    (if (> (count s) max-len)
      (str (subs s 0 max-len) "…")
      s)))

(defn- network-error? [e]
  (let [msg (str e)]
    (or (.contains msg "SocketException")
        (.contains msg "ClientException")
        (.contains msg "Connection refused")
        (.contains msg "Failed host lookup")
        (.contains msg "Connection timed out")
        (.contains msg "TimeoutException"))))

(defn- humanize-http-error [prefix status-code body]
  (let [detail (truncate-str body 120)]
    (if (empty? detail)
      (str prefix " failed: HTTP " status-code)
      (str prefix " failed: HTTP " status-code " — " detail))))

(defn- humanize-exception [prefix e]
  (if (network-error? e)
    "Cannot reach sync server"
    (str prefix " error: " (truncate-str (str e) 120))))

(defn- sync-failure? [res]
  (contains? #{:error :unauthorized :no-url} res))

(defn- op-pushable?
  "asset_create is pushable only after binary upload finished."
  [row]
  (if (= "asset_create" (.-action row))
    (-> (asset/get-asset (.-entityId row))
        (.then (fn [a]
                 (boolean (and a (= "uploaded" (.-uploadStatus a)))))))
    (async/Future.value true)))

(defn- filter-pushable-ops!
  "Keep unsynced ops, but hold asset_create until asset upload completes."
  [ops]
  (reduce
   (fn [fut row]
     (.then fut
            (fn [acc]
              (-> (op-pushable? row)
                  (.then (fn [ok?]
                           (if ok?
                             (conj acc row)
                             acc)))))))
   (async/Future.value [])
   (or ops [])))

(defn on-disabled!
  "Cancel pending push and mark sync idle when cloud sync is turned off."
  []
  (when-let [t @!push-timer]
    (.cancel ^async/Timer t))
  (reset! !push-timer nil)
  (store/set-sync-status! :idle "Cloud sync disabled"))

(defn- sync-disabled? []
  (not (store/sync-enabled?)))

(defn- merge-sync-kind [prev kind]
  (cond
    (nil? prev) kind
    (or (= prev :sync) (= kind :sync)) :sync
    (not= prev kind) :sync
    :else prev))

(declare push! pull! sync-now!)

(defn- run-pending-sync! []
  (when-let [kind (let [k @!sync-pending]
                    (reset! !sync-pending nil)
                    k)]
    (case kind
      :push (push!)
      :pull (pull!)
      :sync (sync-now!)
      nil)))

(defn- with-sync-lock!
  "Run `f` exclusively. Overlapping calls queue one follow-up (:pull/:push/:sync)."
  [kind f]
  (if @!sync-busy
    (do
      (swap! !sync-pending merge-sync-kind kind)
      (async/Future.value :queued))
    (do
      (reset! !sync-busy true)
      (-> (f)
          (.catchError (fn [e]
                         (store/set-sync-status! :error (humanize-exception "Sync" e))
                         :error))
          (.then (fn [res]
                   (reset! !sync-busy false)
                   (run-pending-sync!)
                   res))))))

(defn- push-now!
  "Push unsynced operations. No-op (returns :no-url) if base URL unset."
  []
  (cond
    (sync-disabled?)
    (async/Future.value :disabled)

    (not (base-url))
    (do
      (store/set-sync-status! :error "Sync URL not configured")
      (async/Future.value :no-url))

    (not (require-auth!))
    (async/Future.value :unauthorized)

    :else
    (let [base (base-url)]
      (store/set-sync-status! :syncing "Push…")
      (-> (asset-sync/upload-pending!)
          (.then (fn [_] (op/get-unsynced)))
          (.then
           (fn [ops]
             (let [ops (or ops [])]
               (if (empty? ops)
                 (do
                   (store/set-sync-status! :ok "Nothing to push")
                   :empty)
                 (-> (filter-pushable-ops! ops)
                     (.then
                      (fn [pushable]
                        (let [pushable (or pushable [])]
                          (if (empty? pushable)
                            (do
                              (store/set-sync-status! :ok "Waiting for asset upload")
                              :waiting-assets)
                            (let [body (db/encode-json (mapv operation->wire pushable))
                                  uri (dart:core/Uri.parse (str base "/api/sync/push"))]
                              (-> (http/post uri
                                             :headers (store/auth-headers)
                                             :body body)
                                  (.then
                                   (fn [resp]
                                     (cond
                                       (= (.-statusCode resp) 401)
                                       (do
                                         (store/clear-auth-session!)
                                         (store/set-sync-status! :error "Session expired — log in again")
                                         :unauthorized)

                                       (and (>= (.-statusCode resp) 200)
                                            (< (.-statusCode resp) 300))
                                       (let [decoded (convert/jsonDecode (.-body resp))
                                             renames (or (get decoded "title_renames") [])]
                                         (-> (op/mark-synced! (mapv #(.-id %) pushable))
                                             (.then (fn [_]
                                                      (apply/apply-push-title-renames! renames)))
                                             (.then (fn [_]
                                                      (flush-conflict-toast!)
                                                      (if (seq (or renames []))
                                                        (call-hook !after-remote-apply)
                                                        (async/Future.value nil))))
                                             (.then (fn [_]
                                                      (store/set-sync-status! :ok "Push OK")
                                                      :ok))))

                                       :else
                                       (do
                                         (store/set-sync-status!
                                          :error (humanize-http-error "Push"
                                                                      (.-statusCode resp)
                                                                      (.-body resp)))
                                         :error)))))))))))))))
          (.catchError (fn [e]
                         (store/set-sync-status! :error (humanize-exception "Push" e))
                         :error))))))

(defn- pull-now!
  "Pull operations since last_sync_time.
   After apply, refresh title cache (link autocomplete)."
  []
  (if (sync-disabled?)
    (async/Future.value :disabled)
    (if-let [base (base-url)]
    (if-not (require-auth!)
      (async/Future.value :unauthorized)
      (let [applied? (atom false)
            start-since (or (:last-sync-time @store/app-ui-state) "0")
            start-since-id (or (:last-sync-op-id @store/app-ui-state) "")]
        (letfn [(pull-page! [since since-id]
                  (let [qs (str "?since=" (dart:core/Uri.encodeComponent since)
                                "&since_id=" (dart:core/Uri.encodeComponent (or since-id ""))
                                "&limit=" pull-page-size)
                        uri (dart:core/Uri.parse (str base "/api/sync/pull" qs))]
                    (-> (http/get uri :headers (store/auth-headers {}))
                        (.then (fn [resp]
                                 (cond
                                   (= (.-statusCode resp) 401)
                                   (do
                                     (store/clear-auth-session!)
                                     (store/set-sync-status! :error "Session expired — log in again")
                                     :unauthorized)

                                   (and (>= (.-statusCode resp) 200) (< (.-statusCode resp) 300))
                                   (let [items (parse-pull-items (.-body resp))
                                         n (count items)
                                         cursor (last-item-cursor items)]
                                     (when (pos? n)
                                       (reset! applied? true))
                                     (-> (apply-remote-ops! items)
                                         (.then
                                          (fn [_]
                                            (when cursor
                                              (store/set-last-sync-cursor!
                                               (:since cursor)
                                               (:since-id cursor)))
                                            (if (< n pull-page-size)
                                              :ok
                                              (pull-page! (:since cursor) (:since-id cursor)))))))

                                   :else
                                   (do
                                     (store/set-sync-status!
                                      :error (humanize-http-error "Pull"
                                                                  (.-statusCode resp)
                                                                  (.-body resp)))
                                     :error))))
                        (.catchError (fn [e]
                                       (store/set-sync-status! :error (humanize-exception "Pull" e))
                                       :error)))))]
          (-> (call-hook !before-pull)
              (.then (fn [_]
                       (store/set-sync-status! :syncing "Pull…")
                       (pull-page! start-since start-since-id)))
              (.then (fn [res]
                       (if (= res :ok)
                         (-> (db/refresh-document-titles!)
                             (.then (fn [_] (asset-sync/download-missing!)))
                             (.then (fn [_]
                                      (flush-conflict-toast!)
                                      (if @applied?
                                        (call-hook !after-remote-apply)
                                        (async/Future.value nil))))
                             (.then (fn [_]
                                      (store/set-sync-status! :ok "Pull OK")
                                      :ok)))
                         res)))))))
    (do
      (store/set-sync-status! :error "Sync URL not configured")
      (async/Future.value :no-url)))))

(defn- sync-now-run!
  "Pull then push. Keeps :error if either step fails."
  []
  (if (sync-disabled?)
    (do
      (on-disabled!)
      (async/Future.value :disabled))
    (-> (pull-now!)
      (.then (fn [pull-res]
               (-> (push-now!)
                   (.then (fn [push-res]
                            (cond
                              (sync-failure? pull-res)
                              pull-res

                              (sync-failure? push-res)
                              push-res

                              :else
                              (do
                                (flush-conflict-toast!)
                                (store/set-sync-status! :ok "Sync OK")
                                :ok))))))))))

(defn push!
  "Push unsynced operations. Serialized with pull/sync-now."
  []
  (with-sync-lock! :push push-now!))

(defn pull!
  "Pull operations since last_sync_time. Serialized with push/sync-now."
  []
  (with-sync-lock! :pull pull-now!))

(defn sync-now!
  "Pull then push. Serialized so overlapping triggers queue one follow-up."
  []
  (with-sync-lock! :sync sync-now-run!))

(defn schedule-push!
  "Debounce push by 2 seconds after edits."
  []
  (when (and (store/sync-enabled?) (store/logged-in?))
    (when-let [t @!push-timer]
      (.cancel ^async/Timer t))
    (reset! !push-timer
            (async/Timer. (dart:core/Duration. .seconds 2)
                          #(push!)))))

(defn start-periodic-pull!
  "Pull every 5 minutes when logged in."
  []
  (when-let [t @!pull-timer]
    (.cancel ^async/Timer t))
  (reset! !pull-timer
          (async/Timer.periodic (dart:core/Duration. .minutes 5)
                                (fn [_]
                                  (when (and (store/sync-enabled?) (store/logged-in?))
                                    (pull!))))))

(defn on-app-start!
  []
  (when (and (base-url) (store/sync-enabled?) (store/logged-in?))
    (pull!))
  (start-periodic-pull!))

(defn on-app-resume!
  []
  (when (and (base-url) (store/sync-enabled?) (store/logged-in?))
    (pull!)))

(defn on-app-pause!
  []
  (when (and (base-url) (store/sync-enabled?) (store/logged-in?))
    (push!)))