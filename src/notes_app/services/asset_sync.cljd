(ns notes-app.services.asset-sync
  "Upload / download binary assets to sync server (separate from Operation log)."
  (:require ["dart:async" :as async]
            ["dart:io" :as io]
            ["package:http/http.dart" :as http]
            ["package:path/path.dart" :as path]
            ["package:path_provider/path_provider.dart" :as pathp]
            ["package:mgl_notes_app/database.dart" :as drift]
            [notes-app.db.core :as db]
            [notes-app.services.asset :as asset]
            [notes-app.state.store :as store]))

(defn- base-url []
  (let [u (:sync-base-url @store/app-ui-state)]
    (when (and u (not= u ""))
      (.replaceFirst u (dart:core/RegExp. "/+$") ""))))

(defn- assets-dir! []
  (-> (pathp/getApplicationDocumentsDirectory)
      (.then (fn [dir]
               (let [p (path/join (.-path dir) "assets")
                     d (io/Directory. p)]
                 (when-not (.existsSync d)
                   (.createSync d .recursive true))
                 p)))))

(defn- asset-sync-error! [msg]
  (store/set-sync-status! :error msg))

(defn- network-error-msg? [msg]
  (or (.contains msg "SocketException")
      (.contains msg "ClientException")
      (.contains msg "Connection refused")
      (.contains msg "Failed host lookup")
      (.contains msg "TimeoutException")))

(defn- exception->asset-msg [prefix e]
  (let [msg (str e)]
    (if (network-error-msg? msg)
      "Cannot reach sync server"
      (str prefix " error: " (subs msg 0 (min (count msg) 120))))))

(defn- upload-one! [^drift/Asset row]
  (if-let [base (base-url)]
    (if-not (store/logged-in?)
      (async/Future.value nil)
      (let [local (.-localPath row)]
        (if (and local (.existsSync (io/File. local)))
          (let [uri (dart:core/Uri.parse (str base "/api/assets/upload"))
                req (http/MultipartRequest. "POST" uri)
                token (:auth-token @store/app-ui-state)]
            (when token
              (. (.-headers req) "[]=" "Authorization" (str "Bearer " token)))
            (. (.-fields req) "[]=" "id" (.-id row))
            (. (.-fields req) "[]=" "filename" (.-filename row))
            (. (.-fields req) "[]=" "mime_type" (.-mimeType row))
            (. (.-fields req) "[]=" "sha256" (.-sha256 row))
            (. (.-fields req) "[]=" "size_bytes" (str (.-sizeBytes row)))
            (-> (http/MultipartFile.fromPath "file" local
                                             .filename (.-filename row))
                (.then (fn [mf]
                         (.add (.-files req) mf)
                         (-> (.send req)
                             (.then (fn [resp]
                                      (cond
                                        (= (.-statusCode resp) 401)
                                        (do
                                          (store/clear-auth-session!)
                                          (asset-sync-error! "Session expired — log in again"))

                                        (and (>= (.-statusCode resp) 200)
                                             (< (.-statusCode resp) 300))
                                        (asset/mark-uploaded! (.-id row))

                                        :else
                                        (asset-sync-error!
                                         (str "Asset upload failed: HTTP "
                                              (.-statusCode resp)
                                              " ("
                                              (.-id row)
                                              ")")))))
                             (.catchError (fn [e]
                                            (asset-sync-error!
                                             (exception->asset-msg "Asset upload" e)))))))))
          (async/Future.value nil))))
    (async/Future.value nil)))

(defn upload-pending!
  "Upload all assets with upload_status=pending."
  []
  (if-let [^drift/AppDatabase database (db/get-database)]
    (-> (.getPendingUploadAssets database)
        (.then (fn [rows]
                 (reduce (fn [fut row]
                           (.then fut (fn [_] (upload-one! row))))
                         (async/Future.value nil)
                         (or rows [])))))
    (async/Future.value nil)))

(defn- download-one! [^drift/Asset row]
  (if-let [base (base-url)]
    (if-not (store/logged-in?)
      (async/Future.value nil)
      (let [uri (dart:core/Uri.parse (str base "/api/assets/" (.-id row)))]
        (-> (http/get uri :headers (store/auth-headers {}))
            (.then (fn [resp]
                     (cond
                       (= (.-statusCode resp) 401)
                       (do
                         (store/clear-auth-session!)
                         (asset-sync-error! "Session expired — log in again"))

                       (and (>= (.-statusCode resp) 200)
                            (< (.-statusCode resp) 300))
                       (-> (assets-dir!)
                           (.then (fn [dir]
                                    (let [ext (path/extension (.-filename row))
                                          dest-path (path/join dir (str (.-id row) ext))
                                          file (io/File. dest-path)]
                                      (-> (.writeAsBytes file (.-bodyBytes resp))
                                          (.then (fn [_]
                                                   (asset/mark-downloaded! (.-id row) dest-path))))))))

                       :else
                       (asset-sync-error!
                        (str "Asset download failed: HTTP "
                             (.-statusCode resp)
                             " ("
                             (.-id row)
                             ")")))))
            (.catchError (fn [e]
                           (asset-sync-error!
                            (exception->asset-msg "Asset download" e)))))))
    (async/Future.value nil)))

(defn download-missing!
  "Download assets marked pending_download."
  []
  (if-let [^drift/AppDatabase database (db/get-database)]
    (-> (.getPendingDownloadAssets database)
        (.then (fn [rows]
                 (reduce (fn [fut row]
                           (.then fut (fn [_] (download-one! row))))
                         (async/Future.value nil)
                         (or rows [])))))
    (async/Future.value nil)))
