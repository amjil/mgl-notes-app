(ns notes-app.services.daily
  (:require ["dart:core" :as dc]
            [notes-app.db.core :as db]
            [notes-app.services.document :as doc]))

(defn date->title
  "Format DateTime to YYYY-MM-DD"
  [^dc/DateTime dt]
  (let [y (.-year dt)
        m (.-month dt)
        d (.-day dt)]
    (str y "-"
         (if (< m 10) (str "0" m) (str m)) "-"
         (if (< d 10) (str "0" d) (str d)))))

(defn today-title []
  (date->title (dc/DateTime.now)))

(defn- ensure-daily-now!
  [^dc/DateTime dt]
  (let [title (date->title dt)]
    (-> (db/find-daily-by-title title)
        (.then (fn [existing]
                 (if existing
                   (.-id existing)
                   (doc/create! {:title title :type "daily"}))))
        (.catchError (fn [e]
                       (dart:core/print (str "ensure-daily! failed: " e))
                       nil)))))

(defonce ^:private !ensure-chain (atom nil))

(defn ensure-daily!
  "Return the single daily Document id for a date, serializing concurrent creates."
  [^dc/DateTime dt]
  (let [previous @!ensure-chain
        run (fn [_] (ensure-daily-now! dt))
        chained (if previous
                  (-> previous
                      (.catchError (fn [_] nil))
                      (.then run))
                  (run nil))]
    (reset! !ensure-chain chained)
    (-> chained
        (.then (fn [result]
                 (when (identical? @!ensure-chain chained)
                   (reset! !ensure-chain nil))
                 result))
        (.catchError (fn [e]
                       (when (identical? @!ensure-chain chained)
                         (reset! !ensure-chain nil))
                       (dart:core/print (str "ensure-daily! failed: " e))
                       nil)))))

;; Convenience wrapper restoring ensure-today! for main.cljd
(defn ensure-today!
  "Convenience wrapper for application startup."
  []
  (ensure-daily! (dc/DateTime.now)))